local maxCropsSelling = false
local function sellAllCropsAndWait()
	if maxCropsSelling then return end
	maxCropsSelling = true
	addUiLog("⚠️ Max crops in inventory! Teleporting to sell cart...")
	-- Teleport to sell cart position
	local character = LocalPlayer.Character
	if character then
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = CFrame.new(1016, 41, -117)
			addUiLog("📍 Teleported to SellCart at 1016, 41, -117")
		end
	end
	task.wait(1)
	sellAllCrops()
	addUiLog("⏳ Waiting 9 seconds before resuming harvest...")
	task.wait(9)
	maxCropsSelling = false
	addUiLog("✅ Sell complete, resuming auto harvest...")
end

local function runAutoHarvest(updateStatus)
	if not _G.AutoHarvestRunning then return 0 end
	if autoHarvestPlus and maxCropsSelling then return 0 end
	if autoHarvestPlus then
		canHarvestMode = "TRUE"
		if maxCropsReached then
			task.spawn(sellAllCropsAndWait)
			return 0
		end
	end
	local fruits = getHarvestableFruits(harvestTargetName, harvestMode)
	if #fruits == 0 then
		updateStatus("Harvest: Finding next smart fruit/plant...")
		RecentlyProcessedHarvest = {}
		return 0
	end

	local count = 0
	for i, fruitData in ipairs(fruits) do
		if not _G.AutoHarvestRunning then break end
		if autoHarvestPlus and maxCropsSelling then break end
		RecentlyProcessedHarvest[fruitData.UniqueKey] = true
		local targetObj = fruitData.PhysicalInstance or fruitData.SeedInstance
		applyActionHighlight(targetObj, "[COLLECTING] " .. fruitData.PlantName, Color3.fromRGB(0, 255, 127))

		if fruitData.PhysicalInstance then teleportToInstance(fruitData.PhysicalInstance) elseif fruitData.SeedInstance then teleportToInstance(fruitData.SeedInstance) end
		fireRemoteBatch(HarvestCropRemote, fruitData.PlantKey, automationActionMultiplier, tostring(fruitData.FruitNumber))
		if i == 1 then
			addUiLog(string.format("✅ [HARVEST x%d] Batch sent: %s | Fruit #%s", automationActionMultiplier, fruitData.PlantName, tostring(fruitData.FruitNumber)))
		end
		if autoHarvestPlus and maxCropsReached and not maxCropsSelling then
			task.spawn(sellAllCropsAndWait)
			break
		end
		count = count + 1

		if actionLimit > 0 and count >= actionLimit then
			if stopHarvestLoop then stopHarvestLoop() end
			addUiLog("🛑 Harvest Limit Reached (" .. actionLimit .. "). Auto Harvest Stopped.")
			break
		end
		if i % REMOTE_BATCH_SIZE == 0 then task.wait() end
	end
	return count
end

