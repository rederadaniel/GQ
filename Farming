	PlayerMessageLogBtn.MouseButton1Click:Connect(function()
		local container = PlayerGui:FindFirstChild("PlayerMessagesGui")
		container = container and container:FindFirstChild("MessagesContainer")
		local count = 0
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("TextLabel") or item:IsA("TextButton") then
					local text = item.Text
					if text and text ~= "" then addUiLog("Player message: " .. text) count += 1 end
				end
			end
		end
		if count == 0 then addUiLog("No player messages found") end
	end)

	function connectPlayerMessageLog()
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local messages = remotes and remotes:FindFirstChild("PlayerMessages")
		local event = messages and messages:FindFirstChild("ShowPlayerMessage")
		if event and event:IsA("RemoteEvent") then
			event.OnClientEvent:Connect(function(data)
				if typeof(data) == "table" then addUiLog("Player message: " .. tostring(data.Message or data.Text or "")) end
			end)
		end
	end
	connectPlayerMessageLog()

