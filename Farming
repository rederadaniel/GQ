addUiLog = function(msg)
    if not activeLogsEnabled then return end
    local timestamp = os.date("%H:%M:%S")
    if msg == lastLogMessage and lastLogLabel and lastLogLabel.Parent then
        lastLogCount = lastLogCount + 1
        lastLogLabel.Text = string.format("[%s] %s (%dx)", timestamp, msg, lastLogCount)
    else
        lastLogMessage = msg
        lastLogCount = 1
        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 0, 0)
        textLabel.AutomaticSize = Enum.AutomaticSize.Y
        textLabel.BackgroundTransparency = 1
        textLabel.Text = string.format("[%s] %s", timestamp, msg)
        textLabel.TextColor3 = Color3.fromRGB(180, 220, 255)
        textLabel.TextSize = 10
        textLabel.Font = Enum.Font.Code
        textLabel.TextXAlignment = Enum.TextXAlignment.Left
        textLabel.TextWrapped = true
        textLabel.Parent = LogScroll
        lastLogLabel = textLabel
    end
    task.wait(0.01)
    LogScroll.CanvasPosition = Vector2.new(0, LogScroll.AbsoluteCanvasSize.Y)
end

ClearLogsBtn.MouseButton1Click:Connect(function()
    lastLogMessage = "" lastLogLabel = nil lastLogCount = 1
    for _, child in ipairs(LogScroll:GetChildren()) do if child:IsA("TextLabel") then child:Destroy() end end
end)


