	for obj in pairs(HighlightedCache) do
		if obj and obj.Parent then
			for _, child in ipairs(obj:GetChildren()) do
				if child.Name == "FruitAutoHighlight" or child.Name == "FruitNameTag" then child:Destroy() end
			end
		end
	end
	table.clear(HighlightedCache)
	highlightCount = 0
end

