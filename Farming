        clearAllHighlights()
        return 
    end

    local targetFruits = getHarvestableFruits(harvestTargetName, highlightMode)
    local allMutCounts = targetFruits.GardenMutationCounts or {}
    local specificMutCounts = targetFruits.SpecificFruitMutationCounts or {}

    for _, fruitData in ipairs(targetFruits) do
        local targetObj = fruitData.PhysicalInstance or fruitData.SeedInstance
        if targetObj and not HighlightedCache[targetObj] then
            HighlightedCache[targetObj] = true
            local hl = Instance.new("Highlight")
            hl.Name = "FruitAutoHighlight"
            hl.FillColor = fruitData.HasMutation and Color3.fromRGB(255, 140, 0) or Color3.fromRGB(0, 255, 127)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.FillTransparency = 0.35
            hl.OutlineTransparency = 0
            hl.Parent = targetObj

            local bb = Instance.new("BillboardGui")
            bb.Name = "FruitNameTag"
            bb.Size = UDim2.new(0, 160, 0, 30)
            bb.StudsOffset = Vector3.new(0, 2, 0)
            bb.AlwaysOnTop = true

            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            local mutTag = (fruitData.MutationNameText ~= "") and ("✨[" .. fruitData.MutationNameText .. "] ") or ""
            txt.Text = mutTag .. fruitData.PlantName .. " #" .. fruitData.FruitNumber
            txt.TextColor3 = fruitData.HasMutation and Color3.fromRGB(255, 140, 0) or Color3.fromRGB(255, 255, 0)
            txt.TextStrokeTransparency = 0
            txt.TextSize = 11
            txt.Font = Enum.Font.SourceSansBold
            txt.Parent = bb
            bb.Parent = targetObj
        end
    end

    if highlightMode == "ALL FRUITS" then
        local noMut = targetFruits.NoMutationCount or 0
        local hasMut = targetFruits.HasMutationCount or 0
        addUiLog(string.format("No Mutation Fruit -> %d", noMut))
        addUiLog(string.format("+ With Mutation Fruit -> %d", hasMut))
        addUiLog(string.format("= -> %d", noMut + hasMut))
    elseif highlightMode == "ALL MUT" then
        if next(allMutCounts) ~= nil then
            for mutName, count in pairs(allMutCounts) do addUiLog(string.format("%s %dx", mutName, count)) end
        else
            addUiLog("❌ No mutation found for '" .. (hlMutationValueText ~= "" and hlMutationValueText or "Any") .. "'")
        end
    elseif highlightMode == "SPECIFIC" then
        if next(specificMutCounts) ~= nil then
            for mutName, count in pairs(specificMutCounts) do addUiLog(string.format("%s %dx", mutName, count)) end
        else
            addUiLog("❌ No mutation found for specific name -> " .. (hlMutFruitNameText ~= "" and hlMutFruitNameText or "Unknown") .. ".")
        end
    elseif highlightMode == "SPECIFIC NAME" then
        if next(specificMutCounts) ~= nil then
            for mutName, count in pairs(specificMutCounts) do addUiLog(string.format("%s %dx", mutName, count)) end
        end
    end
end

