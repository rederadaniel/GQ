	local function toggleHighlightMode(mode, button, color, onActivated)
		if highlightMode == mode then
			resetHlButtons()
			highlightMode = "OFF"
			growthTimeEnabled = false
			HlBtnGrowthToggle.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
			HlBtnGrowthToggle.Text = "GROWTH TIME: OFF"
			HlBtnOff.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
			return
		end
		resetHlButtons()
		highlightMode = mode
		button.BackgroundColor3 = color
		if onActivated then onActivated() end
		applyFruitHighlights()
	end

