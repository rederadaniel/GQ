end

local function fireRemoteBatch(remote, payload, amount, secondPayload)
	if not remote then return end
	local total = math.max(1, math.floor(tonumber(amount) or 1))
	for index = 1, total do
		if secondPayload == nil then
			remote:FireServer(payload)
		else
			remote:FireServer(payload, secondPayload)
		end
		if index % REMOTE_BATCH_SIZE == 0 then task.wait() end
	end
end

local function firePlantRemote(remote, payload, interval)
	if not remote then return false end
	local ok = pcall(function()
		remote:FireServer(payload)
	end)
	task.wait(interval or PLANT_REMOTE_INTERVAL)
	return ok
end

