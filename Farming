local function getDelayInSeconds()
	local val = tonumber(rawSpeedInput)
	if not val or val <= 0 then return MAX_AUTOMATION_DELAY end
	return math.max(val / math.clamp(automationSpeedMultiplier, 1, 100), MAX_AUTOMATION_DELAY)
end

local function getHarvestDelayInSeconds()
	local val = tonumber(harvestSpeedInput)
	if not val or val <= 0 then return MAX_AUTOMATION_DELAY end
	return math.max(val / math.clamp(automationSpeedMultiplier, 1, 100), MAX_AUTOMATION_DELAY)
end

local function getAutomationDelay(value, fallback)
	local delay = tonumber(value)
	if not delay or delay <= 0 then delay = fallback end
	return math.max(delay / math.clamp(automationSpeedMultiplier, 1, 100), MAX_AUTOMATION_DELAY)
end

local function getPlotFolder()
	local map = Workspace:FindFirstChild("Map")
	local island = map and map:FindFirstChild("MainIsland")
	local gardens = island and island:FindFirstChild("PlayerGardens")
	return gardens and gardens:FindFirstChild("Plots")
end

local function isOwnedPlot(plot)
	if not plot then return false end
	local ownerUserId = plot:GetAttribute("OwnerUserId") or plot:GetAttribute("Owner")
	if typeof(ownerUserId) == "number" then return ownerUserId == LocalPlayer.UserId end
	if ownerUserId ~= nil then return tostring(ownerUserId) == tostring(LocalPlayer.UserId) or tostring(ownerUserId) == LocalPlayer.Name end
	local ownerValue = plot:FindFirstChild("OwnerUserId") or plot:FindFirstChild("Owner")
	if ownerValue and ownerValue:IsA("ValueBase") then
		return tostring(ownerValue.Value) == tostring(LocalPlayer.UserId) or tostring(ownerValue.Value) == LocalPlayer.Name
	end
	return false
end

local function getOwnedPlots()
	local owned = {}
	local plots = getPlotFolder()
	if not plots then return owned end
	for _, plot in ipairs(plots:GetChildren()) do
		if isOwnedPlot(plot) then table.insert(owned, plot) end
	end
	return owned
end

local function getCropPercent(crop)
	local serverConfig = crop:FindFirstChild("ServerConfiguration")
	if serverConfig then
		local canHarvest = serverConfig:FindFirstChild("CanHarvest")
		if canHarvest and canHarvest:IsA("BoolValue") and canHarvest.Value then return 100 end
		local gp = serverConfig:FindFirstChild("GrowthPercentage")
		if gp and typeof(gp.Value) == "number" then return math.clamp(gp.Value, 0, 100) end
	end
	local canHarvestDirect = crop:FindFirstChild("CanHarvest")
	if canHarvestDirect and canHarvestDirect:IsA("BoolValue") and canHarvestDirect.Value then return 100 end
	for _, name in ipairs({"GrowthPercentage", "GrowthPercent", "Percent", "Progress"}) do
		local value = crop:GetAttribute(name) or (crop:FindFirstChild(name) and crop[name].Value)
		if typeof(value) == "number" then return math.clamp(value, 0, 100) end
	end
	return 0
end

