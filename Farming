local function performanceIsVisual(instance)
	return instance:IsA("ParticleEmitter") or instance:IsA("Trail") or instance:IsA("Beam") or instance:IsA("Smoke") or instance:IsA("Fire") or instance:IsA("Sparkles") or instance:IsA("Light") or instance:IsA("BasePart") or instance:IsA("Decal") or instance:IsA("Texture") or instance:IsA("Sound")
end

local function performancePosition(instance)
	local model = instance:FindFirstAncestorOfClass("Model")
	local part = if instance:IsA("BasePart") then instance else if model then model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true) else nil
	return part and part.Position
end

local function performanceInRadius(instance)
	local character = Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local position = performancePosition(instance)
	return not root or not position or (position - root.Position).Magnitude <= PerformanceState.RenderRadius
end

local function performanceSave(instance, property)
	performanceSaved[instance] = performanceSaved[instance] or {}
	if performanceSaved[instance][property] == nil then
		performanceSaved[instance][property] = instance[property]
	end
end

local function performanceReduce(instance)
	if not performanceIsVisual(instance) or not performanceInRadius(instance) then return end
	if instance:IsA("ParticleEmitter") then
		performanceSave(instance, "Enabled")
		performanceSave(instance, "Rate")
		performanceSave(instance, "Lifetime")
		instance.Rate *= PerformanceState.ReductionFactor
		instance.Lifetime = NumberRange.new(instance.Lifetime.Min * PerformanceState.ReductionFactor, instance.Lifetime.Max * PerformanceState.ReductionFactor)
	elseif instance:IsA("Trail") or instance:IsA("Beam") or instance:IsA("Smoke") or instance:IsA("Fire") or instance:IsA("Sparkles") then
		performanceSave(instance, "Enabled")
		instance.Enabled = false
	elseif instance:IsA("Light") then
		performanceSave(instance, "Enabled")
		performanceSave(instance, "Range")
		instance.Enabled = false
		instance.Range *= PerformanceState.ReductionFactor
	elseif instance:IsA("BasePart") then
		performanceSave(instance, "CastShadow")
		instance.CastShadow = false
	elseif instance:IsA("Decal") or instance:IsA("Texture") then
		performanceSave(instance, "Transparency")
		instance.Transparency = math.min(1, instance.Transparency + 0.35)
	elseif instance:IsA("Sound") then
		performanceSave(instance, "Volume")
		instance.Volume *= PerformanceState.ReductionFactor
	end
end

local function performanceRestore()
	for instance, properties in pairs(performanceSaved) do
		if instance.Parent then
			for property, value in pairs(properties) do instance[property] = value end
		end
	end
	performanceSaved = {}
end

function PerformanceState.Apply(root)
	if not root then return end
	performanceRoots[root] = true
	if PerformanceState.PotatoMode then
		performanceReduce(root)
		for _, instance in root:GetDescendants() do performanceReduce(instance) end
	end
end

function PerformanceState.Bind(root)
	if not root then return end
	PerformanceState.Apply(root)
	if performanceConnections[root] then return end
	performanceConnections[root] = root.DescendantAdded:Connect(function(instance)
		if PerformanceState.PotatoMode then performanceReduce(instance) end
	end)
end

local function applyLightingPotatoMode(enabled)
	if enabled then
		if lightingSaved.GlobalShadows == nil then
			lightingSaved.GlobalShadows = Lighting.GlobalShadows
		end
		Lighting.GlobalShadows = false
		for _, child in ipairs(Lighting:GetChildren()) do
			if child:IsA("PostEffect") and lightingSaved.Effects[child] == nil then
				lightingSaved.Effects[child] = child.Enabled
				child.Enabled = false
			end
		end
	else
		if lightingSaved.GlobalShadows ~= nil then
			Lighting.GlobalShadows = lightingSaved.GlobalShadows
			lightingSaved.GlobalShadows = nil
		end
		for effect, wasEnabled in pairs(lightingSaved.Effects) do
			if effect and effect.Parent then
				effect.Enabled = wasEnabled
			end
		end
		table.clear(lightingSaved.Effects)
	end
end

function PerformanceState.SetPotatoMode(enabled, renderRadius)
	PerformanceState.PotatoMode = enabled == true
	if renderRadius then PerformanceState.RenderRadius = math.max(32, tonumber(renderRadius) or 180) end
	applyLightingPotatoMode(PerformanceState.PotatoMode)
	if not PerformanceState.PotatoMode then
		performanceRestore()
		return
	end
	PerformanceState.Apply(Workspace)
	for root in pairs(performanceRoots) do PerformanceState.Apply(root) end
end

function PerformanceState.SetRenderRadius(radius)
	PerformanceState.RenderRadius = math.max(32, tonumber(radius) or 180)
	if PerformanceState.PotatoMode then
		PerformanceState.SetPotatoMode(false)
		PerformanceState.SetPotatoMode(true)
	end
end

function PerformanceState.SetWateringActive(active, bonusMultiplier)
	PerformanceState.WateringGrowthBonus = math.max(1, tonumber(bonusMultiplier) or PerformanceState.WateringGrowthBonus)
	PerformanceState.GrowthSpeedMultiplier = active and PerformanceState.WateringGrowthBonus or 1
end

function PerformanceState.GetGrowthSpeedMultiplier()
	return PerformanceState.GrowthSpeedMultiplier
end
