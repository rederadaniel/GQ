	addUiLog = function(msg)
		local category = logCategory
		if msg:find("Weather") or msg:find("weather") then category = "Weather" end
		if msg:find("Player message") or msg:find("PlayerMessage") then category = "PlayerMessage" end
		if msg:find("Max crops") or msg:find("max crops") then maxCropsReached = true end
		local prefix = logFormatPrefix[category] or "Live Output Logs -> "
		local displayMessage = formatPlantTypeLogMessage(msg)
		local timestamp = os.date("%H:%M:%S")
		local formatted = string.format("[%s] %s%s", timestamp, prefix, displayMessage)
		table.insert(logEntries[category], formatted)
		if #logEntries[category] > MAX_LOG_ENTRIES then table.remove(logEntries[category], 1) end
		if not activeLogsEnabled or category ~= logCategory then return end
		if displayMessage == lastLogMessage and lastLogLabel and lastLogLabel.Parent then
			lastLogCount = lastLogCount + 1
			lastLogLabel.Text = string.format("[%s] %s%s (%dx)", timestamp, prefix, displayMessage, lastLogCount)
		else
			lastLogMessage = displayMessage
			lastLogCount = 1
			local textLabel = Instance.new("TextLabel")
			textLabel.Size = UDim2.new(1, 0, 0, 0)
			textLabel.AutomaticSize = Enum.AutomaticSize.Y
			textLabel.BackgroundTransparency = 1
			textLabel.Text = formatted
			textLabel.TextColor3 = Color3.fromRGB(180, 220, 255)
			textLabel.TextSize = 14
			textLabel.Font = Enum.Font.Code
			textLabel.TextXAlignment = Enum.TextXAlignment.Left
			textLabel.TextWrapped = true
			textLabel.Parent = LogScroll
			lastLogLabel = textLabel
		end
		task.wait(0.01)
		LogScroll.CanvasPosition = Vector2.new(0, LogScroll.AbsoluteCanvasSize.Y)
	end

