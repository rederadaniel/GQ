	local function setFpsOptimizations(enabled)
		if enabled then
			local roots = {Lighting, Workspace, LocalPlayer.Character}
			for _, root in ipairs(roots) do
				if root then
					for _, obj in ipairs(root:GetDescendants()) do
						local isEffect = obj:IsA("PostEffect") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")
						if isEffect or obj:IsA("Sound") then
							local property = isEffect and "Enabled" or "Playing"
							_G.FarmingPanelSavedEffects[obj] = {property = property, value = obj[property]}
							obj[property] = false
						end
					end
				end
			end
			local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
			if animator then
				for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
					_G.FarmingPanelSavedAnimationTracks[track] = true
					track:Stop(0)
				end
			end
		else
			for obj, saved in pairs(_G.FarmingPanelSavedEffects) do
				if obj and obj.Parent then pcall(function() obj[saved.property] = saved.value end) end
			end
			table.clear(_G.FarmingPanelSavedEffects)
			for track in pairs(_G.FarmingPanelSavedAnimationTracks) do
				if track and track.Parent then pcall(function() track:Play(0) end) end
			end
			table.clear(_G.FarmingPanelSavedAnimationTracks)
		end
	end
