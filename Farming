local function getPhysicalFruit(seed, fruitCfg)
	local fruitsFolder = seed and seed:FindFirstChild("Fruits")
	if not fruitsFolder then return nil end
	local fruitFolder = fruitsFolder:FindFirstChild(fruitCfg.Name)
	if not fruitFolder then
		local wanted = tostring(fruitCfg.Name):lower()
		for _, candidate in ipairs(fruitsFolder:GetChildren()) do
			if tostring(candidate.Name):lower() == wanted then
				fruitFolder = candidate
				break
			end
		end
	end
	if not fruitFolder then return nil end
	local physical = fruitFolder:FindFirstChild("Fruit")
	if physical and (physical:IsA("Model") or physical:IsA("BasePart")) then return physical end
	if fruitFolder:IsA("Model") or fruitFolder:IsA("BasePart") then return fruitFolder end
	for _, child in ipairs(fruitFolder:GetChildren()) do
		if child:IsA("Model") or child:IsA("BasePart") then return child end
	end
	return nil
end

