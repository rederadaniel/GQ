local function getTargetPlants()
    local matchedPlants = {}
    local query = getActiveTargetName():lower()
    local plots = Workspace:FindFirstChild("Map")
    if plots then plots = plots:FindFirstChild("MainIsland") end
    if plots then plots = plots:FindFirstChild("PlayerGardens") end
    if plots then plots = plots:FindFirstChild("Plots") end
    if not plots then return matchedPlants end

    for _, plot in ipairs(plots:GetChildren()) do
        local plantedSeeds = plot:FindFirstChild("PlantedSeeds")
        if plantedSeeds then
            for _, seed in ipairs(plantedSeeds:GetChildren()) do
                if not getgenv().FarmScriptRunning then break end
                if not RecentlyProcessedTool[seed] then
                    local plantKey = seed:GetAttribute("PlantKey") or seed.Name
                    if query == "all" or query == "" or string.find(plantKey:lower(), query) then
                        local skipDueToMutation = false
                        if avoidAllMutations and plantHasMutations(seed) then skipDueToMutation = true end
                        if not skipDueToMutation then table.insert(matchedPlants, {Instance = seed, PlantKey = plantKey}) end
                    end
                end
            end
        end
    end
    return matchedPlants
end

local function getHarvestableFruits(targetNameFilter, modeFilter)
    local results = {}
    local query = (targetNameFilter or ""):lower()
    local plots = Workspace:FindFirstChild("Map")
    if plots then plots = plots:FindFirstChild("MainIsland") end
    if plots then plots = plots:FindFirstChild("PlayerGardens") end
    if plots then plots = plots:FindFirstChild("Plots") end
    if not plots then return results end

    local gardenMutationCounts, specificFruitMutationCounts = {}, {}
    local noMutationCount, hasMutationCount = 0, 0

    for _, plot in ipairs(plots:GetChildren()) do
        local plantedSeeds = plot:FindFirstChild("PlantedSeeds")
        if plantedSeeds then
            for _, seed in ipairs(plantedSeeds:GetChildren()) do
                local plantKey = seed:GetAttribute("PlantKey") or seed.Name
                local serverConfig = seed:FindFirstChild("ServerConfiguration")
                local seedMutationsFolder = serverConfig and serverConfig:FindFirstChild("Mutations")
                local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
                local seedHasMutFilter, seedMutText, seedMutList = checkMutationMatch(seedMutationsFolder, hlMutationValueText)
                local anySeedMutFound, anySeedMutText, allSeedMuts = checkMutationMatch(seedMutationsFolder, "")

                if fruitsConfig then
                    for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
                        local favorited = fruitCfg:FindFirstChild("Favorited")
                        local permLocked = fruitCfg:FindFirstChild("PermanentLocked")
                        local isFavorited = favorited and favorited.Value == true
                        local isPermLocked = permLocked and permLocked.Value == true

                        local fruitMutationsFolder = fruitCfg:FindFirstChild("Mutations")
                        local fruitHasMutFilter, fruitMutText, fruitMutList = checkMutationMatch(fruitMutationsFolder, hlMutationValueText)
                        local anyFruitMutFound, anyFruitMutText, allFruitMuts = checkMutationMatch(fruitMutationsFolder, "")

                        local combinedMuts = {}
                        for _, m in ipairs(allSeedMuts) do table.insert(combinedMuts, m) end
                        for _, m in ipairs(allFruitMuts) do table.insert(combinedMuts, m) end

                        local anyMutFound = anySeedMutFound or anyFruitMutFound
                        if anyMutFound or #combinedMuts > 0 then hasMutationCount = hasMutationCount + 1 else noMutationCount = noMutationCount + 1 end

                        for _, mutName in ipairs(combinedMuts) do
                            gardenMutationCounts[mutName] = (gardenMutationCounts[mutName] or 0) + 1
                            local targetFruitCheck = ""
                            if modeFilter == "SPECIFIC" then
                                targetFruitCheck = hlMutFruitNameText
                            elseif modeFilter == "SPECIFIC NAME" or modeFilter == "SPECIFIC MUT" then
                                targetFruitCheck = query 
                                if modeFilter == "SPECIFIC NAME" and hlSpecificFruitName ~= "" then targetFruitCheck = hlSpecificFruitName end
                            end

                            if targetFruitCheck ~= "" and string.find(plantKey:lower(), targetFruitCheck:lower()) ~= nil then
                                local targetMutCheck = hlMutationValueText:lower():gsub("%s+", "")
                                local mutClean = mutName:lower():gsub("%s+", "")
                                if targetMutCheck == "" or string.find(mutClean, targetMutCheck) then specificFruitMutationCounts[mutName] = (specificFruitMutationCounts[mutName] or 0) + 1 end
                            end
                        end

                        local foundMutationLabel = (fruitMutText ~= "" and fruitMutText) or (seedMutText ~= "" and seedMutText) or anyFruitMutText or anySeedMutText
                        local isMatch = false

                        if modeFilter == "HARVEST ALL FRUITS" or modeFilter == "ALL FRUITS" then isMatch = true
                        elseif modeFilter == "SPECIFIC NAME" then
                            local specFilter = (hlSpecificFruitName ~= "" and hlSpecificFruitName) or query
                            if specFilter ~= "" then isMatch = string.find(plantKey:lower(), specFilter:lower()) ~= nil end
                        elseif modeFilter == "SPECIFIC MUT" then
                            local mutFilter = harvestTargetMutName or ""
                            local hasTargetMut, _, _ = checkMutationMatch(seedMutationsFolder, mutFilter)
                            local fruitHasTargetMut, _, _ = checkMutationMatch(fruitMutationsFolder, mutFilter)
                            isMatch = hasTargetMut or fruitHasTargetMut
                        elseif modeFilter == "ALL MUT" then
                            isMatch = seedHasMutFilter or fruitHasMutFilter or (hlMutationValueText == "" and anyMutFound)
                        elseif modeFilter == "SPECIFIC" then
                            local fruitNameMatch = (hlMutFruitNameText == "" or string.find(plantKey:lower(), hlMutFruitNameText:lower()) ~= nil)
                            local mutMatch = (hlMutationValueText == "" and anyMutFound) or (seedHasMutFilter or fruitHasMutFilter)
                            isMatch = fruitNameMatch and mutMatch
                        end

                        local isAvoided = isMutationAvoided(combinedMuts)
                        local physicalFruit = nil
                        local fruitsFolder = seed:FindFirstChild("Fruits")
                        if fruitsFolder then
                            local fruitFolder = fruitsFolder:FindFirstChild(fruitCfg.Name)
                            if fruitFolder then physicalFruit = fruitFolder:FindFirstChild("Fruit") or fruitFolder end
                        end

                        local uniqueTargetKey = tostring(seed) .. "_" .. tostring(fruitCfg.Name)
                        local isRecentlyProcessed = RecentlyProcessedHarvest[uniqueTargetKey]

                        if isMatch and not isFavorited and not isPermLocked and not isAvoided and not isRecentlyProcessed then
                            table.insert(results, {UniqueKey = uniqueTargetKey, PlantKey = plantKey, PlantName = seed.Name, FruitNumber = fruitCfg.Name, PhysicalInstance = physicalFruit, SeedInstance = seed, HasMutation = anyMutFound or (foundMutationLabel ~= ""), MutationNameText = foundMutationLabel, AllMutations = combinedMuts})
                        end
                    end
                end
            end
        end
    end

    results.GardenMutationCounts = gardenMutationCounts
    results.SpecificFruitMutationCounts = specificFruitMutationCounts
    results.NoMutationCount = noMutationCount
    results.HasMutationCount = hasMutationCount
    return results
end

local function applyFruitHighlights()
