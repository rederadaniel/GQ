	end)

	getWeatherLogText = function()
		local state = ReplicatedStorage:FindFirstChild("WorldState")
		if state then
			local weatherId = state:GetAttribute("WeatherId")
			local active = state:GetAttribute("WeatherActive")
			if weatherId then return tostring(weatherId), active and "Active weather state" or "Weather inactive" end
		end
		local weatherGui = PlayerGui:FindFirstChild("WeatherIconGui")
		local tooltip = weatherGui and weatherGui:FindFirstChild("ActiveWeatherTooltip")
		local nameLabel = tooltip and tooltip:FindFirstChild("ActiveWeatherName")
		local descLabel = tooltip and tooltip:FindFirstChild("ActiveWeatherDescription")
		return nameLabel and nameLabel.Text or "Unknown", descLabel and descLabel.Text or "No description"
	end

