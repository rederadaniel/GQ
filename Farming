                end
            end
        end
    end
    if count == 0 then addUiLog("❌ No mutation plants found in the garden.") else addUiLog(string.format("Total Mutation Plants Found -> %d", count)) end
end

local function runToolAutoLoop(updateStatus)
    if not getgenv().FarmScriptRunning then return 0 end
    local targets = getTargetPlants()
    if #targets == 0 then
        updateStatus("Tool Loop: Searching smart alternative plants...")
        RecentlyProcessedTool = {}
        return 0
    end

    local count = 0
    for _, target in ipairs(targets) do
        if not getgenv().FarmScriptRunning then break end
        RecentlyProcessedTool[target.Instance] = true
        if not ensureToolEquipped(selectedMode) then
            updateStatus("Tool Loop: Equip " .. selectedMode)
            RecentlyProcessedTool[target.Instance] = nil 
            return 0
        end

        local actionText = "[COLLECTING]"
        local actionColor = Color3.fromRGB(0, 255, 127)
        if selectedMode == "Shovel" then
            actionText = "[DESTROYING]"
            actionColor = Color3.fromRGB(255, 60, 60)
        elseif selectedMode == "Scythe" then
            actionText = "[HARVESTING]"
            actionColor = Color3.fromRGB(255, 200, 0)
        end

        applyActionHighlight(target.Instance, actionText .. " " .. target.PlantKey, actionColor)
        UseEquippedTool:FireServer({Action = "Use", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = "Plant", InputMode = "GardenTarget"})

        -- SMART VALIDATION: Check if the plant was successfully removed/updated
        local success = false
        local timeout = 2.0 
        local elapsed = 0
        
        while elapsed < timeout do
            if not getgenv().FarmScriptRunning then break end
            
            local isDestroyed = (target.Instance.Parent == nil)
            
            if selectedMode == "Shovel" then
                if isDestroyed then 
                    success = true 
                    break 
                end
            else
                local config = target.Instance:FindFirstChild("ServerConfiguration")
                local serverFruits = config and config:FindFirstChild("Fruits")
                local hasNoFruits = serverFruits and #serverFruits:GetChildren() == 0
                
                if isDestroyed or hasNoFruits then 
                    success = true 
                    break 
                end
            end
            
            task.wait(0.1)
            elapsed = elapsed + 0.1
        end

        if success then
            addUiLog(string.format("✅ [%s] %s Success: %s", selectedMode:upper(), actionText, target.PlantKey))
            count = count + 1
            
            if actionLimit > 0 and count >= actionLimit then
                if stopToolLoop then stopToolLoop() end
                addUiLog("🛑 Action Limit Reached (" .. actionLimit .. "). Auto Tool Loop Stopped.")
                break
            end
        else
            addUiLog(string.format("⚠️ [%s] Failed (Not Destroyed): %s. Retrying next loop...", selectedMode:upper(), target.PlantKey))
            RecentlyProcessedTool[target.Instance] = nil
        end

        local delay = getDelayInSeconds()
        if delay > 0 then task.wait(delay) end
    end    return count
end

local function runAutoHarvest(updateStatus)
    if not getgenv().AutoHarvestRunning then return 0 end
    local fruits = getHarvestableFruits(harvestTargetName, harvestMode)
    if #fruits == 0 then
        updateStatus("Harvest: Finding next smart fruit/plant...")
        RecentlyProcessedHarvest = {}
        return 0
    end

    local count = 0
    for i, fruitData in ipairs(fruits) do
        if not getgenv().AutoHarvestRunning then break end
        RecentlyProcessedHarvest[fruitData.UniqueKey] = true
        local targetObj = fruitData.PhysicalInstance or fruitData.SeedInstance
        applyActionHighlight(targetObj, "[COLLECTING] " .. fruitData.PlantName, Color3.fromRGB(0, 255, 127))

        if fruitData.PhysicalInstance then teleportToInstance(fruitData.PhysicalInstance) elseif fruitData.SeedInstance then teleportToInstance(fruitData.SeedInstance) end
        HarvestCropRemote:FireServer(fruitData.PlantKey, tostring(fruitData.FruitNumber))
        addUiLog(string.format("✅ [HARVEST] Success: %s | Fruit #%s", fruitData.PlantName, tostring(fruitData.FruitNumber)))
        count = count + 1
        
        if actionLimit > 0 and count >= actionLimit then
            if stopHarvestLoop then stopHarvestLoop() end
            addUiLog("🛑 Harvest Limit Reached (" .. actionLimit .. "). Auto Harvest Stopped.")
            break
        end
        local delay = getHarvestDelayInSeconds()
        if delay > 0 then task.wait(delay) end
    end
    return count
end

