				local taggedCrops = {}

				-- Helper: search all plot folders 1-100 across all map areas
				local function getAllPlotFolders()
					local result = {}
					local map = Workspace:FindFirstChild("Map")
					if not map then return result end
					for _, area in ipairs(map:GetChildren()) do
						local gardens = area:FindFirstChild("PlayerGardens")
						local plots = gardens and gardens:FindFirstChild("Plots")
						if plots then
							for i = 1, 100 do
