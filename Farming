								if plot.Name:match("^Plot%d+$") and not table.find(result, plot) then
									table.insert(result, plot)
								end
							end
						end
					end
					return result
				end

				local function createOrUpdateTag(parent, displayText, isReady)
					local highlight = parent:FindFirstChild("GrowthTrackerHighlight")
					if not highlight then
						highlight = Instance.new("Highlight")
						highlight.Name = "GrowthTrackerHighlight"
						highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						highlight.Parent = parent
					end
					highlight.Enabled = true
					highlight.FillColor = Color3.fromRGB(0, 120, 255)
					highlight.OutlineColor = Color3.fromRGB(120, 210, 255)
					highlight.FillTransparency = 0.55
					highlight.OutlineTransparency = 0

					local tag = parent:FindFirstChild("GrowthTrackerTag")
					if not tag then
						tag = Instance.new("BillboardGui")
						tag.Name = "GrowthTrackerTag"
						tag.Size = UDim2.new(0, 220, 0, 50)
						tag.StudsOffset = Vector3.new(0, 4, 0)
						tag.AlwaysOnTop = true
						tag.Parent = parent
					end
					local text = tag:FindFirstChildOfClass("TextLabel")
					if not text then
						text = Instance.new("TextLabel")
						text.Name = "TagLabel"
						text.Size = UDim2.new(1, 0, 1, 0)
						text.BackgroundTransparency = 1
						text.TextStrokeTransparency = 0
						text.TextSize = 12
						text.Font = Enum.Font.SourceSansBold
						text.Parent = tag
					end
					text.Text = displayText
					text.TextColor3 = isReady and Color3.fromRGB(0, 255, 127) or Color3.fromRGB(255, 255, 255)
					return tag
				end

				local function processCropForFruitTracking(crop, mode, specificName, taggedCrops)
					local serverConfig = crop:FindFirstChild("ServerConfiguration")
					local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
					if not fruitsConfig then return end
					for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
						local fruitName = tostring(fruitCfg:GetAttribute("FruitName") or fruitCfg.Name)
						if mode == "FRUIT SPEC" and specificName ~= "" and not fruitMatchesName(fruitCfg, specificName) then continue end
						local physicalFruit = getPhysicalFruit(crop, fruitCfg)
						if physicalFruit and (physicalFruit:IsA("Model") or physicalFruit:IsA("BasePart")) then
							local gp = fruitCfg:FindFirstChild("GrowthPercentage")
							local growthVal = (gp and typeof(gp.Value) == "number") and math.clamp(gp.Value, 0, 100) or 0
							local canHarvest = fruitCfg:FindFirstChild("CanHarvest")
							if canHarvest and canHarvest:IsA("BoolValue") and canHarvest.Value then growthVal = 100 end
							checkFruitMaturity(crop, fruitCfg, growthVal)
							local displayText = string.format("Fruit %s: %d%%", tostring(fruitCfg.Name), math.floor(growthVal))
							createOrUpdateTag(physicalFruit, displayText, growthVal >= 100)
							taggedCrops[physicalFruit] = true
						end
					end
				end

				local function processCropForPlantTracking(crop, specificName, taggedCrops)
					local serverConfig = crop:FindFirstChild("ServerConfiguration")
					local cleanName = crop.Name:match("^([^:]+)") or crop.Name

					if specificName ~= "" and not string.find(cleanName:lower(), specificName, 1, true) then
						return
					end

					local growthPct = getCropPercent(crop)
					local serverDuration = crop:GetAttribute("ServerDuration") or (serverConfig and serverConfig:GetAttribute("ServerDuration")) or 0
					local remainingTime = 0
					if serverDuration and serverDuration > 0 and growthPct < 100 then
						remainingTime = serverDuration * (1 - growthPct / 100)
					end

					local timeStr = ""
					if remainingTime > 0 then
						local mins = math.floor(remainingTime / 60)
						local secs = math.floor(remainingTime % 60)
						timeStr = string.format(" | %dm %ds", mins, secs)
					elseif growthPct >= 100 then
						timeStr = " | READY!"
					end

					local displayText = string.format("🌱 %s | %d%%%s", cleanName, math.floor(growthPct), timeStr)
					createOrUpdateTag(crop, displayText, growthPct >= 100)
					taggedCrops[crop] = true
				end

				-- Search all plot folders 1-100 across all map areas
				local allPlots = getAllPlotFolders()
				for _, plot in ipairs(allPlots) do
					local planted = plot:FindFirstChild("PlantedSeeds")
					if planted then
						for _, crop in ipairs(planted:GetChildren()) do
							if GrowthTrackerMode == "FRUIT ALL" or GrowthTrackerMode == "FRUIT SPEC" then
								processCropForFruitTracking(crop, GrowthTrackerMode, GrowthSpecificName, taggedCrops)
							elseif GrowthTrackerMode == "PLANT ALL" or GrowthTrackerMode == "PLANT SPEC" then
								processCropForPlantTracking(crop, GrowthSpecificName, taggedCrops)
							end
						end
					end
				end

				-- Fallback: also search via getPlotFolder
				local plots = getPlotFolder()
				if plots then
					for _, plot in ipairs(plots:GetChildren()) do
						local planted = plot:FindFirstChild("PlantedSeeds")
						if planted then
							for _, crop in ipairs(planted:GetChildren()) do
								if not taggedCrops[crop] then
									if GrowthTrackerMode == "FRUIT ALL" or GrowthTrackerMode == "FRUIT SPEC" then
										processCropForFruitTracking(crop, GrowthTrackerMode, GrowthSpecificName, taggedCrops)
									elseif GrowthTrackerMode == "PLANT ALL" or GrowthTrackerMode == "PLANT SPEC" then
										processCropForPlantTracking(crop, GrowthSpecificName, taggedCrops)
									end
								end
							end
						end
					end
				end

				-- Remove only tracker visuals that are no longer tracked.
				for _, plot in ipairs(allPlots) do
					local planted = plot:FindFirstChild("PlantedSeeds")
					if planted then
						for _, crop in ipairs(planted:GetChildren()) do
							for _, obj in ipairs(crop:GetDescendants()) do
								if (obj.Name == "GrowthTrackerTag" or obj.Name == "GrowthTrackerHighlight") and not taggedCrops[obj.Parent] then obj:Destroy() end
							end
							if not taggedCrops[crop] and (GrowthTrackerMode == "PLANT ALL" or GrowthTrackerMode == "PLANT SPEC") then
								local tag = crop:FindFirstChild("GrowthTrackerTag")
								local highlight = crop:FindFirstChild("GrowthTrackerHighlight")
								if tag then tag:Destroy() end
								if highlight then highlight:Destroy() end
							end
						end
					end
				end
			else
				-- Tracker is off, clean up tags only in the plot folders.
				local plots = getPlotFolder()
				if plots then
					for _, plot in ipairs(plots:GetChildren()) do
						local planted = plot:FindFirstChild("PlantedSeeds")
						if planted then
							for _, crop in ipairs(planted:GetChildren()) do
								local tag = crop:FindFirstChild("GrowthTrackerTag")
								local highlight = crop:FindFirstChild("GrowthTrackerHighlight")
								if tag then tag:Destroy() end
								if highlight then highlight:Destroy() end
							end
						end
					end
				end
			end
	]]
