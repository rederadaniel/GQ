				stroke.Color = Color3.fromRGB(40, 46, 58)
				stroke.Thickness = 1
				stroke.Transparency = 0.55
				stroke.Parent = obj
			end
		elseif obj:IsA("TextLabel") then
			if obj.Font == Enum.Font.SourceSansBold then obj.Font = Enum.Font.GothamMedium end
			if obj.Font == Enum.Font.SourceSansItalic then obj.Font = Enum.Font.Gotham end
		end
		end
	end
end)

