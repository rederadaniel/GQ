applyFruitHighlights = function()
	if highlightMode == "OFF" then 
		clearAllHighlights()
		return 
	end

	clearAllHighlights()

	if highlightMode == "FRUIT PCT ALL" or highlightMode == "FRUIT PCT SPEC" then
		local filterName = highlightMode == "FRUIT PCT SPEC" and hlPctSpecificName or ""
		local count = 0
		for _, plot in ipairs(getOwnedPlots()) do
			local planted = plot:FindFirstChild("PlantedSeeds")
			if planted then
				for _, seed in ipairs(planted:GetChildren()) do
					local serverConfig = seed:FindFirstChild("ServerConfiguration")
					local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
					local physicalFruits = seed:FindFirstChild("Fruits")
					if fruitsConfig and physicalFruits then
						local plantKey = tostring(seed:GetAttribute("PlantKey") or seed.Name):lower()
						for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
							local fruitName = getFruitDisplayName(fruitCfg)
							local fruitKey = tostring(fruitCfg.Name):lower()
							local nameMatch = filterName == "" or string.find(plantKey, filterName, 1, true) ~= nil or string.find(fruitName:lower(), filterName, 1, true) ~= nil or string.find(fruitKey, filterName, 1, true) ~= nil
							if nameMatch then
								local physicalFruit = getPhysicalFruit(seed, fruitCfg)
								if physicalFruit and (physicalFruit:IsA("Model") or physicalFruit:IsA("BasePart")) then
									local gp = fruitCfg:FindFirstChild("GrowthPercentage")
									local pct = gp and typeof(gp.Value) == "number" and math.floor(math.clamp(gp.Value, 0, 100)) or 0
									local ch = fruitCfg:FindFirstChild("CanHarvest")
									if ch and ch:IsA("BoolValue") and ch.Value then pct = 100 end
									local label = string.format("%s #%s | %d%%", fruitName, fruitCfg.Name, pct)
									if createFruitHighlight(physicalFruit, label, Color3.fromRGB(0, 255, 127)) then
										count += 1
									end
								end
							end
						end
					end
				end
			end
		end
		connectFruitHighlightRefresh()
		addUiLog(string.format("ALL FRUITS highlighted: %d", count))
		return
	end

	local targetFruits = getHarvestableFruits(harvestTargetName, highlightMode)
	local allMutCounts = targetFruits.GardenMutationCounts or {}
	local specificMutCounts = targetFruits.SpecificFruitMutationCounts or {}

	for _, fruitData in ipairs(targetFruits) do
		local targetObj = fruitData.PhysicalInstance
		if targetObj and (targetObj:IsA("Model") or targetObj:IsA("BasePart")) then
			local mutTag = (fruitData.MutationNameText ~= "") and ("[" .. fruitData.MutationNameText .. "] ") or ""
			local label = mutTag .. fruitData.PlantName .. " #" .. fruitData.FruitNumber
			local color = fruitData.HasMutation and Color3.fromRGB(255, 140, 0) or Color3.fromRGB(0, 255, 127)
			createFruitHighlight(targetObj, label, color)
		end
	end

	connectFruitHighlightRefresh()
	if highlightMode == "ALL FRUITS" then
		local noMut = targetFruits.NoMutationCount or 0
		local hasMut = targetFruits.HasMutationCount or 0
		addUiLog(string.format("ALL FRUITS highlighted: %d", noMut + hasMut))
		addUiLog(string.format("No Mutation Fruit -> %d", noMut))
		addUiLog(string.format("With Mutation Fruit -> %d", hasMut))
	elseif highlightMode == "ALL MUT" then
		if next(allMutCounts) ~= nil then
			for mutName, count in pairs(allMutCounts) do
				addUiLog(string.format("%s %dx", mutName, count))
			end
			for _, fruitData in ipairs(targetFruits) do
				logMutationSummary({[fruitData.MutationNameText ~= "" and fruitData.MutationNameText or "Mutation"] = 1}, fruitData.PlantName)
			end
		else
			addUiLog("❌ No mutation found for '" .. (hlMutationValueText ~= "" and hlMutationValueText or "Any") .. "'")
		end
	elseif highlightMode == "SPECIFIC" then
		if next(specificMutCounts) ~= nil then
			for mutName, count in pairs(specificMutCounts) do addUiLog(string.format("%s %dx", mutName, count)) end
			for _, fruitData in ipairs(targetFruits) do
				logMutationSummary({[fruitData.MutationNameText ~= "" and fruitData.MutationNameText or "Mutation"] = 1}, fruitData.PlantName)
			end
		else
			addUiLog("❌ No mutation found for specific name -> " .. (hlMutFruitNameText ~= "" and hlMutFruitNameText or "Unknown") .. ".")
		end
	elseif highlightMode == "SPECIFIC NAME" then
		if next(specificMutCounts) ~= nil then
			for mutName, count in pairs(specificMutCounts) do addUiLog(string.format("%s %dx", mutName, count)) end
		end
	end
end

