				local hasMut, _, muts = checkMutationMatch(mutationsFolder, "")

				local fruitMutFound = false
				local fruitMutNames = {}
				if fruitsConfig then
					for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
						local fMutFolder = fruitCfg:FindFirstChild("Mutations")
						local fHas, _, fMuts = checkMutationMatch(fMutFolder, "")
						if fHas then
							fruitMutFound = true
							for _, m in ipairs(fMuts) do table.insert(fruitMutNames, m) end
						end
					end
				end

				if hasMut or fruitMutFound or #muts > 0 then
					count = count + 1
					local allMuts = {}
					for _, m in ipairs(muts) do table.insert(allMuts, m) end
					for _, m in ipairs(fruitMutNames) do table.insert(allMuts, m) end
					addUiLog(string.format("Plant: %s | Key: %s | Mutations: %s", seed.Name, plantKey, table.concat(allMuts, ", ")))
				end
			end
		end
	end
	if count == 0 then addUiLog("❌ No mutation plants found in the garden.") else addUiLog(string.format("Total Mutation Plants Found -> %d", count)) end
end

local function runToolAutoLoop(updateStatus)
	if not _G.FarmScriptRunning then return 0 end
	local targets = getTargetPlants()
	if #targets == 0 then
		updateStatus("Tool Loop: Searching smart alternative plants...")
		RecentlyProcessedTool = {}
		return 0
	end

	local count = 0
	for _, target in ipairs(targets) do
		if not _G.FarmScriptRunning then break end
		RecentlyProcessedTool[target.Instance] = true
		if not ensureToolEquipped(selectedMode) then
			updateStatus("Tool Loop: Equip " .. selectedMode)
			RecentlyProcessedTool[target.Instance] = nil 
			return 0
		end

		local actionText = "[COLLECTING]"
		local actionColor = Color3.fromRGB(0, 255, 127)
		if selectedMode == "Shovel" then
			actionText = "[DESTROYING]"
			actionColor = Color3.fromRGB(255, 60, 60)
		elseif selectedMode == "Scythe" then
			actionText = "[HARVESTING]"
			actionColor = Color3.fromRGB(255, 200, 0)
		end

		applyActionHighlight(target.Instance, actionText .. " " .. target.PlantKey, actionColor)
		if selectedMode == "Shovel" and shovelTargetType == "Fruit" then
			local serverConfig = target.Instance:FindFirstChild("ServerConfiguration")
			local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
			if fruitsConfig then
				local remaining = fruitsConfig:GetChildren()
				for index = 1, math.min(#remaining, 10) do
					if not _G.FarmScriptRunning then break end
					local fruitCfg = remaining[index]
					local canHarvest = fruitCfg:FindFirstChild("CanHarvest")
					if not (canHarvest and canHarvest:IsA("BoolValue") and canHarvest.Value == true) then continue end
					for _ = 1, automationActionMultiplier do
						UseEquippedTool:FireServer({Action = "Use", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = "Fruit", InputMode = "GardenTarget", FruitNumber = fruitCfg.Name})
					end
				end
				addUiLog(string.format("Shovel fruit batch: %d/10 sent for %s", math.min(#remaining, 10), target.PlantKey))
			else
				UseEquippedTool:FireServer({Action = "Use", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = "Plant", InputMode = "GardenTarget"})
			end
		else
			for _ = 1, automationActionMultiplier do
				UseEquippedTool:FireServer({Action = "Use", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = selectedMode == "Shovel" and "Plant" or selectedMode, InputMode = "GardenTarget"})
			end
		end

		-- SUPER FAST VALIDATION CHECK (Decreased Timeout for Max Speed)
		local success = false
		local timeout = 0.01
		local elapsed = 0

		while elapsed < timeout do
			if not _G.FarmScriptRunning then break end

			local isDestroyed = (target.Instance.Parent == nil)

			if selectedMode == "Shovel" then
				if isDestroyed then
					success = true
					break
				end
				local config = target.Instance:FindFirstChild("ServerConfiguration")
				local serverFruits = config and config:FindFirstChild("Fruits")
				if shovelTargetType == "Fruit" and (not serverFruits or #serverFruits:GetChildren() == 0) then
					success = true
					break
				end
				if shovelTargetType == "Plant" and target.Instance.Parent == nil then
					success = true
					break
				end
			else
				local config = target.Instance:FindFirstChild("ServerConfiguration")
				local serverFruits = config and config:FindFirstChild("Fruits")
				local hasNoFruits = serverFruits and #serverFruits:GetChildren() == 0

				if isDestroyed or hasNoFruits then 
					success = true 
					break 
				end
			end

			task.wait()
			elapsed = elapsed + 0.03
		end

		if success then
			addUiLog(string.format("✅ [%s] %s Success: %s", selectedMode:upper(), actionText, target.PlantKey))
			count = count + 1

			if actionLimit > 0 and count >= actionLimit then
				if stopToolLoop then stopToolLoop() end
				addUiLog("🛑 Action Limit Reached (" .. actionLimit .. "). Auto Tool Loop Stopped.")
				break
			end
		else
			addUiLog(string.format("⚠️ [%s] Failed (Not Destroyed): %s. Retrying next loop...", selectedMode:upper(), target.PlantKey))
			RecentlyProcessedTool[target.Instance] = nil
		end

		local delay = getDelayInSeconds()
		if delay > 0 then task.wait(delay) end
	end    
	return count
end

local function sellAllCrops()
	local sellRemote = Remotes:FindFirstChild("Sell")
	sellRemote = sellRemote and sellRemote:FindFirstChild("SellAction")
	if sellRemote then
		local sellCart = Workspace:FindFirstChild("Map")
		if sellCart then sellCart = sellCart:FindFirstChild("MainIsland") end
		if sellCart then sellCart = sellCart:FindFirstChild("StarterArea") end
		if sellCart then sellCart = sellCart:FindFirstChild("NPCs") end
		if sellCart then sellCart = sellCart:FindFirstChild("SellCart") end
		if sellCart then
			pcall(function()
				local args = {
					{
						ClientAllowedSellCategories = "HarvestedCrops,CookedFood,CaughtFish,CaughtJunk,CaughtBugs,Ingredients",
						ClientAllowedSellUseTypes = "",
						Action = "SellAll",
						Adornee = sellCart,
						Seller = sellCart,
						ClientAllowedSellItemTypes = "",
						ClientSellerFeePercent = 10,
						ClientSellPriceMultiplier = 0.9,
						ClientSellerDialogueProfile = "Default"
					}
				}
				sellRemote:FireServer(unpack(args))
			end)
			addUiLog("AUTO HARVEST PLUS: Sell All Crops sent")
			maxCropsReached = false
			return true
		end
	end
	addUiLog("AUTO HARVEST PLUS: Sell remote or SellCart not found")
	return false
end

local maxCropsSelling = false
local function sellAllCropsAndWait()
	if maxCropsSelling then return end
	maxCropsSelling = true
	addUiLog("⚠️ Max crops in inventory! Teleporting to sell cart...")
	-- Teleport to sell cart position
	local character = LocalPlayer.Character
	if character then
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = CFrame.new(1016, 41, -117)
			addUiLog("📍 Teleported to SellCart at 1016, 41, -117")
		end
	end
	task.wait(1)
	sellAllCrops()
	addUiLog("⏳ Waiting 9 seconds before resuming harvest...")
	task.wait(9)
	maxCropsSelling = false
	addUiLog("✅ Sell complete, resuming auto harvest...")
end

local function runAutoHarvest(updateStatus)
	if not _G.AutoHarvestRunning then return 0 end
	if autoHarvestPlus and maxCropsSelling then return 0 end
	if autoHarvestPlus then
		canHarvestMode = "TRUE"
		if maxCropsReached then
			task.spawn(sellAllCropsAndWait)
			return 0
		end
	end
	local fruits = getHarvestableFruits(harvestTargetName, harvestMode)
	if #fruits == 0 then
		updateStatus("Harvest: Finding next smart fruit/plant...")
		RecentlyProcessedHarvest = {}
		return 0
	end

	local count = 0
	for i, fruitData in ipairs(fruits) do
		if not _G.AutoHarvestRunning then break end
		if autoHarvestPlus and maxCropsSelling then break end
		RecentlyProcessedHarvest[fruitData.UniqueKey] = true
		local targetObj = fruitData.PhysicalInstance or fruitData.SeedInstance
		applyActionHighlight(targetObj, "[COLLECTING] " .. fruitData.PlantName, Color3.fromRGB(0, 255, 127))

		if fruitData.PhysicalInstance then teleportToInstance(fruitData.PhysicalInstance) elseif fruitData.SeedInstance then teleportToInstance(fruitData.SeedInstance) end
		for _ = 1, automationActionMultiplier do
			HarvestCropRemote:FireServer(fruitData.PlantKey, tostring(fruitData.FruitNumber))
		end
		addUiLog(string.format("✅ [HARVEST x%d] Success: %s | Fruit #%s", automationActionMultiplier, fruitData.PlantName, tostring(fruitData.FruitNumber)))
		if autoHarvestPlus and maxCropsReached and not maxCropsSelling then
			task.spawn(sellAllCropsAndWait)
			break
		end
		count = count + 1

		if actionLimit > 0 and count >= actionLimit then
			if stopHarvestLoop then stopHarvestLoop() end
			addUiLog("🛑 Harvest Limit Reached (" .. actionLimit .. "). Auto Harvest Stopped.")
			break
		end
		local delay = getHarvestDelayInSeconds()
		if delay > 0 then task.wait(delay) elseif i % 20 == 0 then task.wait() end
	end
	return count
end

