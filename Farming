								TargetNormal = Vector3.new(50, 50, 50),
							}
						}
						UseEquippedTool:FireServer(unpack(waterArgs))
					end
					task.wait(0.25)
				else
					local plots = getOwnedPlots()
					for _, plot in ipairs(plots) do
						local planted = plot:FindFirstChild("PlantedSeeds")
						if planted then
							for _, crop in ipairs(planted:GetChildren()) do
								local plantType = tostring(crop:GetAttribute("PlantType") or crop:GetAttribute("PlantName") or crop.Name)
								local passesNameFilter = wateringMode ~= "SPECIFIC" or (wateringSpecificName ~= "" and string.find(plantType:lower(), wateringSpecificName, 1, true))
								if passesNameFilter then
									local isGrown = getCropPercent(crop) >= 100
									if not isGrown then
										local serverConfig = crop:FindFirstChild("ServerConfiguration")
										local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
										if fruitsConfig then
											for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
												local ch = fruitCfg:FindFirstChild("CanHarvest")
												if ch and ch:IsA("BoolValue") and ch.Value then isGrown = true break end
											end
										end
									end
									if isGrown then
										fullyGrownCount += 1
										table.insert(fullyGrownNames, plantType)
									end
									local shouldWater = not isGrown
									if wateringMode == "SPECIFIC" then
										shouldWater = wateringSpecificName ~= "" and passesNameFilter
									elseif wateringMode == "POSITION" then
										shouldWater = false
									elseif wateringMode == "TP_NOT_GROWN" then
										shouldWater = not isGrown
									elseif waterAllMode == "ALL" then
										shouldWater = true
									end
									if shouldWater then
										table.insert(targets, {Instance = crop, Position = crop:GetPivot().Position, IsGrown = isGrown})
									end
								end
							end
						end
					end
				end
				if wateringMode ~= "POSITION" then
					local grownCounts = {}
					local notGrownCounts = {}
					for _, plantType in ipairs(fullyGrownNames) do
						grownCounts[plantType] = (grownCounts[plantType] or 0) + 1
					end
					for _, target in ipairs(targets) do
						if not target.IsGrown then
							local plantType = tostring(target.Instance:GetAttribute("PlantType") or target.Instance:GetAttribute("PlantName") or target.Instance.Name)
							notGrownCounts[plantType] = (notGrownCounts[plantType] or 0) + 1
						end
					end
					local summaryParts = {}
					local summaryNames = {}
					for plantType in pairs(grownCounts) do summaryNames[plantType] = true end
					for plantType in pairs(notGrownCounts) do summaryNames[plantType] = true end
					local sortedNames = {}
					for plantType in pairs(summaryNames) do table.insert(sortedNames, plantType) end
					table.sort(sortedNames)
					for _, plantType in ipairs(sortedNames) do
						table.insert(summaryParts, string.format("%s %dx fully grow", plantType, grownCounts[plantType] or 0))
						table.insert(summaryParts, string.format("%s %dx not fully grow", plantType, notGrownCounts[plantType] or 0))
					end
					local summary = table.concat(summaryParts, " | ")
					if summary ~= "" and summary ~= lastWateringSummarySignature then
						addUiLog("Watering summary: " .. summary)
						lastWateringSummarySignature = summary
					end
					if #targets == 0 and fullyGrownCount > 0 then
						addUiLog("Watering " .. waterAllMode .. ": no not-grown plants available; all matching plants are fully grown")
					end
				end
				for index, target in ipairs(targets) do
					if index > 20 then break end
					if wateringMode == "TP_NOT_GROWN" then
						local character = LocalPlayer.Character
						if character then
							character:PivotTo(CFrame.new(target.Position + Vector3.new(0, 3, 0)))
							task.wait()
						end
					end
					if not autoWateringActive then break end
					local waterActions = math.min(automationActionMultiplier, 3)
					growthSpeedMultiplier = PerformanceState.GetGrowthSpeedMultiplier()
					if autoWateringActive then
						fireRemoteBatch(UseEquippedTool, {TargetPosition = target.Position, Action = "Water", TargetInstance = target.Instance, Material = "Plastic", InputMode = "WorldPoint", TargetNormal = Vector3.yAxis}, waterActions)
					end
					local plantType = tostring(target.Instance:GetAttribute("PlantType") or target.Instance:GetAttribute("PlantName") or target.Instance.Name)
					applyActionHighlight(target.Instance, "[WATERING x" .. automationActionMultiplier .. "] " .. plantType, Color3.fromRGB(0, 170, 255))
					if index == 1 then
					addUiLog(string.format("Auto water batch: %s at (%.2f, %.2f, %.2f)", plantType, target.Position.X, target.Position.Y, target.Position.Z))
				end
					task.wait(getAutomationDelay(wateringSpeedInput, 0.01))
				end
				task.wait(math.max(getAutomationDelay(wateringSpeedInput, 0.05), 0.25))
			else
				PerformanceState.SetWateringActive(false, wateringGrowthBonus)
			end
		end
	end)

