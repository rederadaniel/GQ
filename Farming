local function collectSeedTools()
	local seedTools = {}
	local character = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if character then
		for _, tool in ipairs(character:GetChildren()) do
			if tool:IsA("Tool") and tool.Name:lower():find("seed") and not tool.Name:lower():find("seedpack") then
				table.insert(seedTools, tool)
			end
		end
	end
	if backpack then
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") and tool.Name:lower():find("seed") and not tool.Name:lower():find("seedpack") then
				table.insert(seedTools, tool)
			end
		end
	end
	return seedTools
end

local function equipSeedForPlanting(useRandom)
	local character = LocalPlayer.Character
	if not character then return false end
	local seedTools = collectSeedTools()
	if #seedTools == 0 then return false end
	local equipped = character:FindFirstChildOfClass("Tool")
	local chosen = useRandom and seedTools[math.random(1, #seedTools)] or seedTools[1]
	if plantSpecificSeedName ~= "" then
		for _, tool in ipairs(seedTools) do
			if tool.Name:lower():find(plantSpecificSeedName:lower(), 1, true) then
				chosen = tool
				break
			end
		end
	end
	if equipped == chosen then return true end
	chosen.Parent = character
	task.wait()
	return true
end

