local function collectSeedTools()
	local seedTools = {}
	local character = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if character then
		for _, tool in ipairs(character:GetChildren()) do
			if tool:IsA("Tool") and tool.Name:lower():find("seed") and not tool.Name:lower():find("seedpack") then
				table.insert(seedTools, tool)
			end
		end
	end
	if backpack then
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") and tool.Name:lower():find("seed") and not tool.Name:lower():find("seedpack") then
				table.insert(seedTools, tool)
			end
		end
	end
	return seedTools
end

local function equipSeedForPlanting(useRandom)
	local character = LocalPlayer.Character
	if not character then return false end
	local seedTools = collectSeedTools()
	if #seedTools == 0 then return false end
	local chosen = useRandom and seedTools[math.random(1, #seedTools)] or seedTools[1]
	if plantSpecificSeedName ~= "" then
		for _, tool in ipairs(seedTools) do
			if tool.Name:lower():find(plantSpecificSeedName:lower(), 1, true) then
				chosen = tool
				break
			end
		end
	end
	chosen.Parent = character
	task.wait(0.02)
	return true
end

local function getPlotInvisibleFloor(plot)
	if not plot then return nil end
	local direct = plot:FindFirstChild("InvisibleFloor", true)
	return direct and direct:IsA("BasePart") and direct or nil
end

local function getRandomInvisibleFloorPosition(invisibleFloor)
	local halfSize = invisibleFloor.Size * 0.5
	local margin = 0.5
	local localPosition = Vector3.new(
		(math.random() * 2 - 1) * math.max(halfSize.X - margin, 0),
		halfSize.Y + 0.05,
		(math.random() * 2 - 1) * math.max(halfSize.Z - margin, 0)
	)
	return invisibleFloor.CFrame:PointToWorldSpace(localPosition)
end

local function getEmptyPlantTargets()
	local targets = {}
	for _, plot in ipairs(getOwnedPlots()) do
		local invisibleFloor = getPlotInvisibleFloor(plot)
		if invisibleFloor then
			table.insert(targets, {
				part = invisibleFloor,
				position = getRandomInvisibleFloorPosition(invisibleFloor),
			})
		end
	end
	return targets
end

local function getPlayerFeetPosition()
	local character = LocalPlayer.Character
	if not character then return nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local feetOffset = humanoid and humanoid.HipHeight or 2
	return root.Position - Vector3.new(0, feetOffset + root.Size.Y * 0.5, 0)
end

local function sortTargetsByDistance(targets)
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return targets end
	local origin = hrp.Position
	table.sort(targets, function(a, b)
		return (a.position - origin).Magnitude < (b.position - origin).Magnitude
	end)
	return targets
end

