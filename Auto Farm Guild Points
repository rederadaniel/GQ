	local function updateFishPrediction()
		local islandName = getCurrentIslandName()
		fishPredictionIslandLabel.Text = "Current Island: " .. islandName
		local lines = { "Fish you can win at " .. islandName .. ":" }
		local fishList = {}
		for _, def in pairs(CaughtFish) do
			if type(def) == "table" and def.DisplayName and def.IslandIds then
				for _, id in ipairs(def.IslandIds) do
					if id == islandName then
