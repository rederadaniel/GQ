local function createToggle(parent, labelText, initialState, callback)
	local percentLabel
	local function updatePercent()
		local npcPath = labelText == "Auto Trade Crops/Fruits" and {"FruitTurnInNpc", "CatOrangeNpc"}
			or labelText == "Auto Trade All Bugs" and {"BugTurnInNpc", "CatBlackNPC"}
			or labelText == "Auto Trade All Fish" and {"FishTurnInNpc", "CatGreyNpc"}
		if not npcPath then return end
		local npcFolder = workspace:FindFirstChild("FillMeterNpcs")
		local npc = npcFolder and npcFolder:FindFirstChild(npcPath[1])
		local label = npc and npc:FindFirstChild(npcPath[2]) and npc[npcPath[2]]:FindFirstChild("PercentageSign", true)
		label = label and label:FindFirstChild("SurfaceGui") and label.SurfaceGui:FindFirstChild("TextLabel")
