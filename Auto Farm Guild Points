local function performCast()
	if fishCasting or not isAutoFishingActive then return false end
	fishCasting = true
	fishWonThisSession = false
	fishSessionId += 1
	local fishing = ReplicatedStorage:FindFirstChild("Fishing")
	local remotes = fishing and fishing:FindFirstChild("Remotes")
	local castRemote = remotes and (remotes:FindFirstChild("RequestCast") or remotes:FindFirstChild("Cast"))

	local casted = false
	if castRemote then
		casted = pcall(function()
			castRemote:FireServer(1)
		end)
	else
		casted = pcall(function()
			VirtualUser:Button1Down(Vector2.new(200, 200))
			task.wait(0.1)
			VirtualUser:Button1Up(Vector2.new(200, 200))
		end)
	end
	fishLastCastAt = os.clock()
	fishCasting = false
	if casted then addUiLog("🎣 Cast fishing line") end
	return casted
end

-- Auto Fishing: instant re-cast when the minigame finishes
local fishInputConnection = nil
local fishAutoCastConnection = nil
local wasMinigameActive = false

local function simulateHold(holding)
	if holding then
		VirtualUser:Button1Down(Vector2.new(0, 0))
	else
		VirtualUser:Button1Up(Vector2.new(0, 0))
	end
end

local function manualTrackInput()
	local FishingGui = PlayerGui:FindFirstChild("FishingMinigameGui")
	local Container = FishingGui and FishingGui:FindFirstChild("FishingBoxContainer")
	local catchBox = Container and Container:FindFirstChild("CatchBox")
	local fishBox = Container and Container:FindFirstChild("FishBox")
	if catchBox and fishBox then
		simulateHold(catchBox.AbsolutePosition.X < fishBox.AbsolutePosition.X)
	else
		simulateHold(false)
	end
end

local function checkMinigameState()
	if not isAutoFishingActive then return end
	local gui = PlayerGui:FindFirstChild("FishingMinigameGui")
	local container = gui and gui:FindFirstChild("FishingBoxContainer")
	local minigameActive = container ~= nil and container.Visible ~= false

	if minigameActive then
		wasMinigameActive = true
		local now = os.clock()
		if fishMiniGameRemote and not fishWonThisSession and now - fishLastCompleteFire > 1.0 then
			fishLastCompleteFire = now
			fishWonThisSession = true
			simulateHold(false)
			pcall(function()
				fishMiniGameRemote:FireServer("Complete", tostring(fishSessionId), {result = "Caught", reason = "ProgressComplete", elapsed = now - fishLastCastAt})
			end)
		end
	else
		if wasMinigameActive then
			wasMinigameActive = false
			if isAutoFishingActive then
				task.delay(0.1, function()
					if isAutoFishingActive then performCast() end
				end)
			end
		end
	end
end

local function toggleFishingCore(state)
	if state then
		if not fishInputConnection then
			fishInputConnection = RunService.Heartbeat:Connect(manualTrackInput)
		end
		if not fishAutoCastConnection then
			fishAutoCastConnection = RunService.Heartbeat:Connect(checkMinigameState)
		end
		performCast()
	else
		if not isAutoFishingActive then
			if fishInputConnection then fishInputConnection:Disconnect() fishInputConnection = nil end
			if fishAutoCastConnection then fishAutoCastConnection:Disconnect() fishAutoCastConnection = nil end
			simulateHold(false)
			wasMinigameActive = false
		end
	end
end

