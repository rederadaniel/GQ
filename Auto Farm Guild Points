-- Enhanced Remote Finder for Fishing Cast
local function getFishCastRemote()
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil end

	local fishing = remotes:FindFirstChild("Fishing")
	if fishing then
		local cast = fishing:FindFirstChild("Cast") or fishing:FindFirstChild("RequestCast") or fishing:FindFirstChild("StartFishing")
		if cast then return cast end
	end

	for _, descendant in ipairs(remotes:GetDescendants()) do
		if descendant:IsA("RemoteEvent") and (descendant.Name == "Cast" or descendant.Name == "RequestCast") then
			return descendant
		end
	end
	return nil
end

