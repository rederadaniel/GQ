							table.insert(fishList, { name = def.DisplayName, rarity = fishRarityMap[def.DisplayName] or getItemRarity("Fish", def.DisplayName) })
						end
						break
					end
				end
			end
		end
		table.sort(fishList, function(a, b)
			local ra, rb = getRarityRank(a.rarity), getRarityRank(b.rarity)
			if ra == rb then return a.name < b.name end
			return ra < rb
		end)
		for i, f in ipairs(fishList) do
			table.insert(lines, tostring(i) .. ".) " .. f.name .. " [" .. f.rarity .. "]")
		end
		fishPredictionLabel.Text = table.concat(lines, "\n")
	end

