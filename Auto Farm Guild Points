-- Auto Harvest Logic
local fruitLastAttempt = {}
local fruitHarvestBusy = {}

local function getFruitServerConfig(plantFolder, fruitIndex)
	local serverConfiguration = plantFolder:FindFirstChild("ServerConfiguration")
	local fruits = serverConfiguration and serverConfiguration:FindFirstChild("Fruits")
	return fruits and fruits:FindFirstChild(tostring(fruitIndex))
end

local function isMutatedFruit(plantFolder, fruitIndex, fruitFolder)
	local configFruit = getFruitServerConfig(plantFolder, fruitIndex)
	local mutationFolders = {}
	for _, object in ipairs({configFruit, fruitFolder}) do
		if object then
			local mutations = object:FindFirstChild("Mutations", true)
			if mutations then table.insert(mutationFolders, mutations) end
		end
	end

	for _, mutations in ipairs(mutationFolders) do
		if #mutations:GetDescendants() > 0 or #mutations:GetChildren() > 0 then return true end
		if mutations:GetAttribute("Active") == true or mutations:GetAttribute("Enabled") == true then return true end
		if mutations:IsA("ValueBase") then
			local value = mutations.Value
			if value ~= nil and value ~= false and value ~= "" and string.lower(tostring(value)) ~= "none" then return true end
		end
	end
	return false
end

local function isReadyFruit(plantFolder, fruitIndex, fruitFolder)
	local configFruit = getFruitServerConfig(plantFolder, fruitIndex)
	local canHarvest = configFruit and configFruit:FindFirstChild("CanHarvest")
	if canHarvest and canHarvest:IsA("BoolValue") then return canHarvest.Value end

	for _, object in ipairs({configFruit, fruitFolder, plantFolder}) do
		if object then
			local ready = object:GetAttribute("CanHarvest")
			if ready ~= nil then return ready == true end
			local state = object:GetAttribute("State") or object:GetAttribute("Status")
			if type(state) == "string" and (string.find(string.lower(state), "ready") or string.find(string.lower(state), "done")) then return true end
		end
	end
	return false
end

local function getFruitTarget(fruitFolder)
	local prompt = fruitFolder:FindFirstChild("HarvestPrompt", true)
	if prompt and prompt:IsA("ProximityPrompt") then
		local parent = prompt.Parent
		if parent:IsA("BasePart") then return parent.Position, prompt end
	end
	local fruit = fruitFolder:FindFirstChild("Fruit", true)
	if fruit and fruit:IsA("BasePart") then return fruit.Position, nil end
	local part = fruitFolder:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position, prompt
end

local function attemptFruitHarvest(plantFolder, fruitIndex, fruitFolder)
	if not isReadyFruit(plantFolder, fruitIndex, fruitFolder) then return false end
	if _G.AvoidAllMutation and isMutatedFruit(plantFolder, fruitIndex, fruitFolder) then return false end
	local attemptKey = plantFolder:GetFullName() .. "/" .. tostring(fruitIndex)
	if fruitHarvestBusy[attemptKey] then return false end
	local now = os.clock()
	if now - (fruitLastAttempt[attemptKey] or 0) < 0.01 then return false end
	fruitLastAttempt[attemptKey] = now
	fruitHarvestBusy[attemptKey] = true
	local position, prompt = getFruitTarget(fruitFolder)
	if not position then fruitHarvestBusy[attemptKey] = nil return false end

	teleportToPosition(position)
	task.wait(0.03)
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - position).Magnitude > 12 then fruitHarvestBusy[attemptKey] = nil return false end

	if prompt and prompt.Enabled then
		pcall(function()
			prompt:InputHoldBegin()
			if prompt.HoldDuration > 0 then task.wait(math.min(prompt.HoldDuration, 0.03)) end
			prompt:InputHoldEnd()
		end)
	end
	pcall(function()
		HarvestCropRemote:FireServer(plantFolder.Name, tostring(fruitIndex))
	end)
	fruitHarvestBusy[attemptKey] = nil
	return true
end

local function collectHarvestQueue()
	local queue = {}
	local map = workspace:FindFirstChild("Map")
	local island = map and map:FindFirstChild("MainIsland")
	local gardens = island and island:FindFirstChild("PlayerGardens")
	local plots = gardens and gardens:FindFirstChild("Plots")
	if not plots then return queue end
	for _, plot in ipairs(plots:GetChildren()) do
		local plantedSeeds = plot:FindFirstChild("PlantedSeeds") or plot
		for _, plantFolder in ipairs(plantedSeeds:GetChildren()) do
			local fruitsFolder = plantFolder:FindFirstChild("Fruits")
			if fruitsFolder then
				for _, fruitFolder in ipairs(fruitsFolder:GetChildren()) do
					if isReadyFruit(plantFolder, fruitFolder.Name, fruitFolder) then
						table.insert(queue, {plantFolder, fruitFolder.Name, fruitFolder})
					end
				end
			end
		end
	end
	return queue
end

local function runAutoHarvest()
	if not _G.AutoHarvestRunning then return end
	local queue = collectHarvestQueue()
	for _, target in ipairs(queue) do
		if not _G.AutoHarvestRunning then break end
		if target[3] and target[3].Parent then
			attemptFruitHarvest(target[1], target[2], target[3])
		end
	end
end

-- Auto Fishing Logic Helpers
local function fishActive()
	return isAutoFishingActive
end

local function isFishingMinigameVisible()
	local gui = PlayerGui:FindFirstChild("FishingMinigameGui")
	if not gui or gui:IsA("ScreenGui") and not gui.Enabled then return false end
	local container = gui:FindFirstChild("FishingBoxContainer")
	return container == nil or container.Visible ~= false
end

local function findCatchBox(container, fishBox)
	for _, child in ipairs(container:GetChildren()) do
		if child ~= fishBox and child:IsA("GuiObject") and child.Visible then
			return child
		end
	end
	return nil
end

local function performCast()
	if fishCasting or not isAutoFishingActive then return false end
	fishCasting = true
	fishWonThisSession = false
	fishSessionId += 1
	if not FishCastRemote then FishCastRemote = getFishCastRemote() end

	local casted = false
	if FishCastRemote then
		casted = pcall(function()
			FishCastRemote:FireServer()
		end)
	else
		casted = pcall(function()
			VirtualUser:Button1Down(Vector2.new(200, 200))
			task.wait(0.1)
			VirtualUser:Button1Up(Vector2.new(200, 200))
		end)
	end
	fishLastCastAt = os.clock()
	fishCasting = false
	if casted then addUiLog("🎣 Cast fishing line") end
	return casted
end

local function ensureFishLogic()
	if fishTrackConnection then return end
	fishTrackConnection = RunService.Heartbeat:Connect(function()
		if not fishActive() then
			if fishHolding then VirtualUser:Button1Up(Vector2.new(0, 0)); fishHolding = false end
			return
		end
		local gui = PlayerGui:FindFirstChild("FishingMinigameGui")
		local container = gui and gui:FindFirstChild("FishingBoxContainer")
		if isFishingMinigameVisible() then
			fishLastGuiSeenAt = os.clock()
		end
		if not container or container.Visible == false or fishWonThisSession then
			if fishHolding then VirtualUser:Button1Up(Vector2.new(0, 0)); fishHolding = false end
			return
		end
		local fishBox = container:FindFirstChild("FishBox")
		local catchBox = findCatchBox(container, fishBox)
		if catchBox and fishBox then
			local shouldHold = catchBox.AbsolutePosition.X < fishBox.AbsolutePosition.X
			if shouldHold and not fishHolding then
				VirtualUser:Button1Down(Vector2.new(0, 0)); fishHolding = true
			elseif not shouldHold and fishHolding then
				VirtualUser:Button1Up(Vector2.new(0, 0)); fishHolding = false
			end
		else
			if fishHolding then VirtualUser:Button1Up(Vector2.new(0, 0)); fishHolding = false end
		end
		local now = os.clock()
		if now - fishLastCompleteFire > 1.0 and fishMiniGameRemote and not fishWonThisSession then
			fishLastCompleteFire = now
			fishWonThisSession = true
			if fishHolding then VirtualUser:Button1Up(Vector2.new(0, 0)); fishHolding = false end
			pcall(function()
				fishMiniGameRemote:FireServer("Complete", tostring(fishSessionId), {result = "Caught", reason = "ProgressComplete", elapsed = now - fishLastCastAt})
			end)
		end
	end)
end

-- Auto Fishing Loop: one cast, one minigame, one completion, then one new cast
local function fishHandsFreeLoop()
	if fishLoopRunning then return end
	fishLoopRunning = true
	while isAutoFishingActive do
		while isAutoFishingActive and isFishingMinigameVisible() do task.wait(0.1) end
			if not isAutoFishingActive then break end
		if isFishingMinigameVisible() then task.wait(0.05) continue end
		if os.clock() - fishLastCastAt < 0.35 then task.wait(0.05) continue end

		local castStartedAt = os.clock()
		if performCast() then
			while isAutoFishingActive and not isFishingMinigameVisible() and os.clock() - castStartedAt < 8 do task.wait(0.05) end
			while isAutoFishingActive and isFishingMinigameVisible() do task.wait(0.05) end
			if isAutoFishingActive then
				task.wait(0.1)
				if not isFishingMinigameVisible() then addUiLog("🎣 Minigame closed; next single cast ready") end
			end
		end
	end
	fishLoopRunning = false
end

-- Auto Bug Catch Logic with Fixed Auto-Hold & Keybind Support
local bugHolding = false

local function runAutoBugCatch()
	local plRemote = ReplicatedStorage:FindFirstChild("Remotes")
	if plRemote then 
		plRemote = plRemote:FindFirstChild("BugCatching")
		if plRemote then plRemote = plRemote:FindFirstChild("RequestCatch") end 
	end

	local function plGD(c, d)
		local a = c:GetAttribute(d) if a ~= nil then return tostring(a) end
		local o = c:FindFirstChild(d) return o and o:IsA("ValueBase") and tostring(o.Value) or nil
	end

	local function plPos(t)
		if not t then return nil end
		if t:IsA("PVInstance") then return t:GetPivot().Position
		elseif t:IsA("BasePart") then return t.Position
		elseif t:IsA("Model") then local p = t.PrimaryPart or t:FindFirstChildWhichIsA("BasePart", true) return p and p.Position end
	end

	local function plTP(t)
		local c = LocalPlayer.Character if not c then return end
		local p = plPos(t) if p then c:PivotTo(CFrame.new(p + Vector3.new(0, 3, 0))) end
	end

	local function plFire(bug)
		local id = plGD(bug, "BugId") or bug.Name 
		if plRemote then plRemote:FireServer(id) end 
	end

	local function plMini()
		local g = PlayerGui:FindFirstChild("BugMinigameGui")
		return g and g.Enabled and g:FindFirstChild("BugBoxContainer") and g.BugBoxContainer.Visible 
	end

	RunService.Heartbeat:Connect(function()
		if not isAutoBugCatchActive then 
			if bugHolding then 
				VirtualUser:Button1Up(Vector2.new(0, 0)) 
				bugHolding = false 
			end
			return 
		end

		local ct = PlayerGui:FindFirstChild("BugMinigameGui")
		ct = ct and ct:FindFirstChild("BugBoxContainer")
		local cb = ct and ct:FindFirstChild("CatchBox") 
		local bb = ct and ct:FindFirstChild("BugBox")

		if cb and bb then 
			local shouldHold = cb.AbsolutePosition.X < bb.AbsolutePosition.X
			if shouldHold and not bugHolding then
				VirtualUser:Button1Down(Vector2.new(0, 0))
				bugHolding = true
			elseif not shouldHold and bugHolding then
				VirtualUser:Button1Up(Vector2.new(0, 0))
				bugHolding = false
			end
		else 
			if bugHolding then 
				VirtualUser:Button1Up(Vector2.new(0, 0)) 
				bugHolding = false 
			end 
		end
	end)

	task.spawn(function()
		while isAutoBugCatchActive do
			local af = workspace:FindFirstChild("ActiveBugVisuals") 
			local bl = {}
			if af then 
				for _, b in ipairs(af:GetDescendants()) do
					if b:IsA("BasePart") and b.Name == "BugHitbox" then
						table.insert(bl, {b, tonumber(plGD(b, "BugId")) or math.huge}) 
					end 
				end
				table.sort(bl, function(a, b) return a[2] < b[2] end) 
			end
			if #bl > 0 then 
				for i = 1, #bl do 
					if not isAutoBugCatchActive then break end 
					local t = bl[i][1]
					if t and t.Parent then 
						plTP(t) 
						task.wait(0.5)
						if isAutoBugCatchActive and t and t.Parent then 
							plFire(t) 
						end 
						task.wait(1)
						while isAutoBugCatchActive and plMini() do 
							task.wait(0.2) 
						end 
					end 
				end
			else 
				task.wait(0.5) 
			end
		end
	end)
end

