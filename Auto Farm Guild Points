-- Specific Execution Handlers for Trade Turn-Ins
local function readTradePercentage(tradeType)
	local paths = {
		Crops = {"FruitTurnInNpc", "CatOrangeNpc"},
		Bugs = {"BugTurnInNpc", "CatBlackNPC"},
		Fish = {"FishTurnInNpc", "CatGreyNpc"},
	}
	local path = paths[tradeType]
	local meterNpcs = workspace:FindFirstChild("FillMeterNpcs")
	local npc = meterNpcs and meterNpcs:FindFirstChild(path and path[1] or "")
	local cat = npc and npc:FindFirstChild(path and path[2] or "")
	local percentageSign = cat and cat:FindFirstChild("PercentageSign", true)
	local surfaceGui = percentageSign and percentageSign:FindFirstChild("SurfaceGui")
	local label = surfaceGui and surfaceGui:FindFirstChild("TextLabel")
	if not label or not label:IsA("TextLabel") then return 0 end
	return tonumber(string.match(label.Text, "%d+")) or 0
end

local function executeTurnIn(npcPath, dialogueAdorneePath, exchangeId, actionKey, tradeType, resumeCallback)
	if isExecuting then return end
	isExecuting = true

	local wasHarvesting = _G.AutoHarvestRunning
	local wasFishing = isAutoFishingActive
	local wasBugCatching = isAutoBugCatchActive

	-- Handle automated pause based on trade type
	if tradeType == "Crops" and wasHarvesting then
		_G.AutoHarvestRunning = false
		addUiLog("🛑 Max crops reached! Pausing Auto Harvest to trade...")
	elseif tradeType == "Fish" and wasFishing then
		isAutoFishingActive = false
		addUiLog("🛑 Max fish reached! Pausing Auto Fishing to trade...")
	elseif tradeType == "Bugs" and wasBugCatching then
		isAutoBugCatchActive = false
		addUiLog("🛑 Max bug reached! Pausing Auto Bug Catch to trade...")
	end

	local character = LocalPlayer.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then 
		isExecuting = false
		return 
	end

	local originalCFrame = character:GetPivot()
	local startingPercentage = readTradePercentage(tradeType)
	local npcFolder = workspace:FindFirstChild("FillMeterNpcs")
	local targetNpc = npcFolder and npcFolder:FindFirstChild(npcPath)

	if targetNpc then
		local targetPos = nil
		if targetNpc:IsA("PVInstance") then
			targetPos = targetNpc:GetPivot().Position
		elseif targetNpc:IsA("BasePart") then
			targetPos = targetNpc.Position
		elseif targetNpc:IsA("Model") then
			local primary = targetNpc.PrimaryPart or targetNpc:FindFirstChildWhichIsA("BasePart", true)
			if primary then targetPos = primary.Position end
		end

		if targetPos then
			character:PivotTo(CFrame.new(targetPos + Vector3.new(0, 3, 0)))
			task.wait(0.5)

			pcall(function()
				VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
				task.wait(0.2)
				VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
			end)
			task.wait(1.5)

			local exchangesRemote = ReplicatedStorage:FindFirstChild("Remotes") 
				and ReplicatedStorage.Remotes:FindFirstChild("Exchanges") 
				and ReplicatedStorage.Remotes.Exchanges:FindFirstChild("RewardExchangeAction")

			local dialogueLoc = dialogueAdorneePath()

			if exchangesRemote and dialogueLoc then
				local args = {
					{
						DialogueAdornee = dialogueLoc,
						ButtonKey = "TurnInAll",
						ExchangeId = exchangeId,
						Action = actionKey
					}
				}
				exchangesRemote:FireServer(unpack(args))
			end
		end
	end

	task.wait(4.0)

	if character and character:FindFirstChild("HumanoidRootPart") then
		character:PivotTo(originalCFrame)
	end

	local percentage = readTradePercentage(tradeType)
	local previousPercentage = startingPercentage
	local gainedPercentage = percentage - previousPercentage
	if gainedPercentage < 0 then gainedPercentage += 100 end
	local completedPoints = math.floor((previousPercentage + gainedPercentage) / 100)
	tradePointsTotal += completedPoints
	tradeLastPercentages[tradeType] = percentage
	local entry = os.date("%H:%M:%S") .. " - Trade " .. tradeType .. " " .. tostring(previousPercentage) .. "% + " .. tostring(gainedPercentage) .. "% = " .. tostring(percentage) .. "% = " .. (completedPoints > 0 and tostring(completedPoints) .. " points" or "no Points")
	table.insert(tradePointEntries, entry)
	if tradeLogLabel then tradeLogLabel.Text = table.concat(tradePointEntries, "\n") end
	if tradeTotalLabel then tradeTotalLabel.Text = "TOTAL POINTS = " .. tostring(tradePointsTotal) end
	addUiLog(entry)
	isExecuting = false

	-- Resume respective system after recording the completed trade
	if tradeType == "Crops" and wasHarvesting and resumeCallback then
		addUiLog("✅ Trade finished! Resuming Auto Harvest...")
		task.spawn(resumeCallback)
	elseif tradeType == "Fish" and wasFishing and resumeCallback then
		addUiLog("✅ Trade finished! Resuming Auto Fishing...")
		task.spawn(resumeCallback)
	elseif tradeType == "Bugs" and wasBugCatching and resumeCallback then
		addUiLog("✅ Trade finished! Resuming Auto Harvest Fruit...") -- Explicit instruction to restart Auto Harvest Fruit on Bug trade completion
		task.spawn(resumeCallback)
	end
end

