local RARITY_ORDER = {
	Ethereal = 1, Mythical = 2, Legendary = 3, Epic = 4, Rare = 5, Uncommon = 6, Common = 7
}
local function getRarityRank(r)
	return RARITY_ORDER[r] or 99
end

local function getItemRarity(itemType, displayName)
	local module = (itemType == "Bug") and CaughtBugs or CaughtFish 
	for _, def in pairs(module) do
		if type(def) == "table" and def.DisplayName == displayName then
			if itemType == "Bug" then
				return def.Rarity or "Common"
			else
				local so = def.SortOrder or 60
				if so <= 10 then return "Common"
				elseif so <= 20 then return "Uncommon"
				elseif so <= 30 then return "Rare"
				elseif so <= 40 then return "Epic"
				elseif so <= 50 then return "Legendary"
				elseif so <= 60 then return "Mythical"
				else return "Ethereal" end
			end
		end
	end
	return "Common"
end

local function addCatchLog(entryType, payload)
	local displayName = payload.DisplayName or payload.name or payload.type or "Unknown"
	local rarity
	if entryType == "Fish" then
		rarity = payload.rarity or getItemRarity("Fish", displayName)
	else
		rarity = fishRarityMap[displayName] or getItemRarity("Fish", displayName)
	end
	local entry = {
		payload = payload,
		name = displayName,
		rarity = rarity,
		price = tonumber(payload.price) or getRarityPrice(rarity),
		sortOrder = payload.SortOrder or 0,
		time = os.time()
	}
	if entryType == "Fish" then
		table.insert(bugCatchEntries, entry)
	else
		table.insert(fishCatchEntries, entry)
		fishRarityMap[displayName] = rarity
	end
	renderCatchLogs()
end

local function formatCatchEntry(entryType, e)
	local p = e.payload or {}
	local lines = {}
	table.insert(lines, 'Win type = ' .. tostring(p.type or entryType))
	if entryType == "Bug" then
		table.insert(lines, '    sizeMultiplier = ' .. tostring(p.sizeMultiplier or ""))
		table.insert(lines, '    sessionId = ' .. tostring(p.sessionId or ""))
		table.insert(lines, '    patternId = ' .. tostring(p.patternId or ""))
		table.insert(lines, '    id = ' .. tostring(p.id or ""))
		table.insert(lines, '    name = ' .. tostring(p.name or e.name))
		table.insert(lines, '    price = ' .. tostring(p.price or e.price))
		table.insert(lines, '    rarity = ' .. tostring(p.rarity or e.rarity))
		table.insert(lines, '    displayWeight = ' .. tostring(p.displayWeight or ""))
		table.insert(lines, '    weightGrams = ' .. tostring(p.weightGrams or ""))
	else
		table.insert(lines, '    rarity = ' .. tostring(p.rarity or e.rarity))
		table.insert(lines, '    weight = ' .. tostring(p.weight or ""))
		table.insert(lines, '    sessionId = ' .. tostring(p.sessionId or ""))
		table.insert(lines, '    price = ' .. tostring(p.price or e.price))
		table.insert(lines, '    name = ' .. tostring(p.name or e.name))
		table.insert(lines, '    id = ' .. tostring(p.id or ""))
	end
	return table.concat(lines, "\n")
end

local function getSortedEntries(entries, sortMode)
	local sorted = {}
	for _, e in ipairs(entries) do table.insert(sorted, e) end
	if sortMode == "Rarity" then
		table.sort(sorted, function(a, b)
			local ra, rb = getRarityRank(a.rarity), getRarityRank(b.rarity)
			if ra == rb then return a.time < b.time end
			return ra < rb
		end)
	elseif sortMode == "Price" then
		table.sort(sorted, function(a, b)
			if a.price == b.price then return a.time < b.time end
			return a.price > b.price
		end)
	else
		table.sort(sorted, function(a, b) return a.time < b.time end)
	end
	return sorted
end

local function renderCatchLogs()
	if fishCatchLabel then
		local lines = {"Fish Catch Logs"}
		local sorted = getSortedEntries(fishCatchEntries, fishSortMode)
		local idx = 0
		for _, e in ipairs(sorted) do
			if fishSearchText == "" or string.find(string.lower(e.name), string.lower(fishSearchText), 1, true) then
				idx += 1
				table.insert(lines, formatCatchEntry("Fish", e))
			end
		end
		fishCatchLabel.Text = table.concat(lines, "\n")
	end
	if bugCatchLabel then
		local lines = {"Bug Catch Logs"}
		local sorted = getSortedEntries(bugCatchEntries, bugSortMode)
		local idx = 0
		for _, e in ipairs(sorted) do
			if bugSearchText == "" or string.find(string.lower(e.name), string.lower(bugSearchText), 1, true) then
				idx += 1
				table.insert(lines, formatCatchEntry("Bug", e))
			end
		end
		bugCatchLabel.Text = table.concat(lines, "\n")
	end
end

local function connectCatchEvent(pathParts, entryType)
	local node = ReplicatedStorage
	for _, part in ipairs(pathParts) do
		node = node:FindFirstChild(part)
		if not node then return end
	end
	if node:IsA("RemoteEvent") then
		node.OnClientEvent:Connect(function(result, payload)
			if result == "Win" and type(payload) == "table" then
				addCatchLog(entryType or payload.type or "Catch", payload)
			end
		end)
	end
end

