applyShopFilter = function()
	local query = searchFilterText:lower()
	local visibleCountsPerShop = {}

	for key, cardData in pairs(cards) do
		local matchesFilter = (currentShopFilter == "All") or (cardData.shopId == currentShopFilter)
		local matchesSearch = true
		local matchesTier = isRarityAllowed(cardData.rarity)

		if query ~= "" then
			if searchTargetMode == "Item" then
				matchesSearch = cardData.itemId:lower():find(query, 1, true) ~= nil
			elseif searchTargetMode == "Shop" then
				matchesSearch = cardData.shopId:lower():find(query, 1, true) ~= nil
			else
				matchesSearch = (cardData.itemId:lower():find(query, 1, true) ~= nil) or (cardData.shopId:lower():find(query, 1, true) ~= nil)
			end
		end

		local visible = matchesFilter and matchesSearch and matchesTier
		cardData.frame.Visible = visible

		if visible then
			visibleCountsPerShop[cardData.shopId] = (visibleCountsPerShop[cardData.shopId] or 0) + 1
		end
	end

	for sId, headerFrame in pairs(shopHeaders) do
		if currentShopFilter == "All" then
			headerFrame.Visible = (visibleCountsPerShop[sId] or 0) > 0
		else
			headerFrame.Visible = false
		end
	end

	local cardList = {}
	for _, cardData in pairs(cards) do
		table.insert(cardList, cardData)
	end

	-- Dual Sort Engine
	table.sort(cardList, function(a, b)
		local rankA = getRarityRank(a.rarity)
		local rankB = getRarityRank(b.rarity)

		if currentSortMode == 1 then
			if rankA == rankB then
				if a.price == b.price then return a.itemId:lower() < b.itemId:lower() end
				return a.price < b.price
			end
			return rankA < rankB
		else
			if rankA == rankB then
				if a.price == b.price then return a.itemId:lower() < b.itemId:lower() end
				return a.price > b.price
			end
			return rankA > rankB
		end
	end)

	for idx, cardData in ipairs(cardList) do
		cardData.frame.LayoutOrder = idx
	end

	updateItemStats()
end

