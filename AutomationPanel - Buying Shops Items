selectToggleBtn.MouseButton1Click:Connect(function()
	local hasUnselected = false
	for key, cardData in pairs(cards) do
		if cardData.frame.Visible and not excludedItems[key] then
			if not selected[key] then
				hasUnselected = true
				break
			end
		end
	end

	for key, cardData in pairs(cards) do
		if cardData.frame.Visible and not excludedItems[key] then
			selected[key] = hasUnselected
			cardData.refresh()
		end
	end
end)

avoidToggleBtn.MouseButton1Click:Connect(function()
	local hasUnavoided = false
	for key, cardData in pairs(cards) do
		if cardData.frame.Visible then
			if not excludedItems[key] then
				hasUnavoided = true
				break
			end
		end
	end

	for key, cardData in pairs(cards) do
		if cardData.frame.Visible then
			excludedItems[key] = hasUnavoided
			if hasUnavoided then selected[key] = false end
			cardData.refresh()
		end
	end
end)

deselectAllShopsBtn.MouseButton1Click:Connect(function()
	for key in pairs(selected) do selected[key] = false end
	for _, cardData in pairs(cards) do cardData.refresh() end
end)

buySelectedBtn.MouseButton1Click:Connect(function()
	selectedBuyMode = "Selected"
	isAutoLoopOn = true
	refreshBottomBarStyles()
end)

buyCurrentShopBtn.MouseButton1Click:Connect(function()
	selectedBuyMode = "CurrentShop"
	isAutoLoopOn = true
	refreshBottomBarStyles()
end)

buyWholeShopsBtn.MouseButton1Click:Connect(function()
	promptWarning(function()
		selectedBuyMode = "AllShops"
		isAutoLoopOn = true
		refreshBottomBarStyles()
	end)
end)

autoLoopBtn.MouseButton1Click:Connect(function()
	if not isAutoLoopOn then
		if selectedBuyMode == "AllShops" then
			promptWarning(function()
				isAutoLoopOn = true
				refreshBottomBarStyles()
			end)
		else
			isAutoLoopOn = true
			refreshBottomBarStyles()
		end
	else
		isAutoLoopOn = false
		refreshBottomBarStyles()
	end
end)
