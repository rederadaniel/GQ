		currentShopFilter, total, selCount, excludeItemCount, excludeShopCount)
end

local function formatTimer(value)
	local seconds = tonumber(value)
	if not seconds then return "Awaiting server restock sync" end
	seconds = math.max(0, math.floor(seconds))
	if seconds >= 3600 then
		return string.format("%02d:%02d:%02d", math.floor(seconds / 3600), math.floor(seconds / 60) % 60, seconds % 60)
	end
	return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function getRarityRank(rarity)
	local normalized = tostring(rarity or "Unknown"):lower()
	local ranks = {
		common = 1, uncommon = 2, rare = 3, epic = 4, legendary = 5, mythical = 6, mythic = 6, ethereal = 7, divine = 8, secret = 9
	}
	return ranks[normalized] or 50
end

