local function requestShopStateFast(sId)
	if not RequestShopState or not shopIds[sId] then return end
	local now = os.clock()
	if shopRequestAtMap[sId] and now - shopRequestAtMap[sId] < 0.5 then return end
	shopRequestAtMap[sId] = now
	
	if shopStatusMap[sId] ~= "Loaded" then
		addOrUpdateLogRow(sId, "Loading")
	end
	
	task.spawn(function()
		pcall(function()
			if RequestShopState:IsA("RemoteEvent") then
				RequestShopState:FireServer(sId)
			elseif RequestShopState:IsA("RemoteFunction") then
				RequestShopState:InvokeServer(sId)
			end
		end)
	end)
end

registerShop = function(sId)
	if type(sId) == "string" and sId ~= "" and not shopIds[sId] then
		shopIds[sId] = true
		table.insert(shopOrder, sId)
		table.sort(shopOrder, function(a, b) return a:lower() < b:lower() end)
		addOrUpdateLogRow(sId, "Ready")
		rebuildShopNavTabs()
		requestShopStateFast(sId)
	end
end

-- Deep Discovery Engine: Scans all client accessible containers for hidden/pending shops
local function performGlobalShopScan()
	local containersToScan = {
		Workspace,
		ReplicatedStorage,
		PlayerGui,
		Lighting,
		ReplicatedFirst
	}

	for _, container in ipairs(containersToScan) do
		pcall(function()
			for _, desc in ipairs(container:GetDescendants()) do
				local sid = desc:GetAttribute("ShopId")
				if typeof(sid) == "string" and sid ~= "" then
					registerShop(sid)
				end
				if desc:IsA("StringValue") and desc.Name == "ShopId" and desc.Value ~= "" then
					registerShop(desc.Value)
				end
			end
		end)
	end

	-- Extract Shop IDs from registered modules if available
	if type(ItemDisplayData) == "table" then
		for _, data in pairs(ItemDisplayData) do
			if type(data) == "table" then
				if data.ShopId then registerShop(tostring(data.ShopId)) end
				if data.Shop then registerShop(tostring(data.Shop)) end
			end
		end
	end
end

