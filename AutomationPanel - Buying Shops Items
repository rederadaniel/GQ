local shopNavButtons = {}

local function getQuantity()
	local n = tonumber(qtyBox.Text)
	if not n or n < 1 then return 1 end
	return math.floor(n)
end

local function getNumericStock(stock)
	if tostring(stock) == "Unlimited" or tostring(stock) == "Unknown" then return math.huge end
	return tonumber(stock) or math.huge
end

local function refreshLimitStatus(message)
	purchaseStatusText = message or purchaseStatusText
	limitStatusLabel.Text = string.format("%s | Total Spent: %s", purchaseStatusText, formatCompactNumber(sessionSpent))
end

local function canQueuePurchase(shopId, itemName, qty)
	local key = shopId .. "|" .. itemName
	local cardData = cards[key]
	if excludedShops[shopId] or excludedItems[key] then return false end
	if cardData and not isRarityAllowed(cardData.rarity) then return false end
	local stock = cardData and getNumericStock(cardData.stock) or math.huge
	if stock <= 0 then return false end
	local amount = math.min(qty, stock == math.huge and qty or stock)
	if amount <= 0 then return false end
	local price = cardData and cardData.price or 0
	if queuedPurchases[key] then return false end
	return true, amount, price
end

local function enqueuePurchase(shopId, itemName, qty)
	local ok, amount, price = canQueuePurchase(shopId, itemName, qty)
	if not ok then return false end
	local key = shopId .. "|" .. itemName
	queuedPurchases[key] = true
	table.insert(purchaseQueue, {shopId = shopId, itemName = itemName, qty = amount, price = price, key = key})
	return true
end

-- SAFELY EXECUTE REMOTE CALLS
local function processPurchaseQueue()
	if purchaseInProgress or not BuyShopItem then return end
	local request = table.remove(purchaseQueue, 1)
	if not request then return end
	purchaseInProgress = true
	queuedPurchases[request.key] = nil
	local elapsed = os.clock() - lastPurchaseAt
	if elapsed < buyDelay then task.wait(buyDelay - elapsed) end

	task.spawn(function()
		pcall(function()
			if BuyShopItem:IsA("RemoteEvent") then
				BuyShopItem:FireServer(tostring(request.shopId), tostring(request.itemName), tonumber(request.qty))
			elseif BuyShopItem:IsA("RemoteFunction") then
				BuyShopItem:InvokeServer(tostring(request.shopId), tostring(request.itemName), tonumber(request.qty))
			end
		end)
	end)
	sessionSpent = sessionSpent + (request.price * request.qty)
	lastPurchaseAt = os.clock()
	refreshLimitStatus("Purchase dispatched successfully")
	purchaseInProgress = false
end

task.spawn(function()
	while scriptRunning do
		processPurchaseQueue()
		task.wait(0.05)
	end
end)

