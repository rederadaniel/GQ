-- Visual Styling Utility Helpers
local function addStroke(instance, color, thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Color3.fromRGB(0, 200, 255)
	stroke.Thickness = thickness or 1
	stroke.Transparency = transparency or 0.7
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = instance
	return stroke
end

local function formatCompactNumber(value)
	local number = tonumber(value)
	if not number then return tostring(value or "Unknown") end
	local absolute = math.abs(number)
	local suffix = ""
	local divisor = 1
	if absolute >= 1e12 then suffix, divisor = "t", 1e12
	elseif absolute >= 1e9 then suffix, divisor = "b", 1e9
	elseif absolute >= 1e6 then suffix, divisor = "m", 1e6
	elseif absolute >= 1e3 then suffix, divisor = "k", 1e3 end
	local scaled = number / divisor
	if suffix == "" then return tostring(math.floor(scaled)) end
	local text = string.format("%.1f", scaled):gsub("%.0$", "")
	return text .. suffix
end

local function rebuildAllowedRarities()
	allowedRarities = {}
	for _, rarity in ipairs(string.split(rarityPriorityText, ",")) do
		rarity = rarity:gsub("^%s+", ""):gsub("%s+$", "")
		if rarity ~= "" then allowedRarities[rarity:lower()] = true end
	end
end

local function isRarityAllowed(rarity)
	if not allowedTiersEnabled then return true end
	return allowedRarities[tostring(rarity):lower()] == true
end

