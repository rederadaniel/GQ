	table.insert(connections, ShopStateUpdated.OnClientEvent:Connect(function(state)
		if type(state) ~= "table" then return end
		local sId = state.ShopId
		local items = state.Items
		if type(sId) ~= "string" or type(items) ~= "table" then return end

		-- Silently register shop if state update arrives for unknown node
		registerShop(sId)

		shopStateMap[sId] = state
		shopItems[sId] = items
		
		local timer = state.RestockTimeRemaining or state.RestockSeconds or state.SecondsUntilRestock or state.RestockTimer or state.RestockTime or state.TimeUntilRestock or state.NextRestock
		if type(timer) == "table" then
			timer = timer.Value or timer.Seconds or timer.Remaining
		end
		
		local restockAt = state.RestockAt or state.NextRestockAt or state.RestockTimestamp
		if type(restockAt) == "number" then
			local now = os.time()
			if restockAt > now then timer = restockAt - now end
		end
		if tonumber(timer) then
			restockDueAtMap[sId] = os.clock() + math.max(0, tonumber(timer))
		end
		if shopTimerLabels[sId] then
			shopTimerLabels[sId].Text = "Restock Countdown: " .. formatTimer(timer)
		end

		local itemCount = 0
		for itemName, itemInfo in pairs(items) do
			if type(itemName) == "string" then
				itemCount = itemCount + 1
				makeCard(sId, itemName, itemCount, itemInfo)
			end
		end

		addOrUpdateLogRow(sId, "Loaded", itemCount)
	end))
end

