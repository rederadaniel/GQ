local function executeBuySelected()
	local qty = getQuantity()
	local hasPurchased = false

	for key, isSel in pairs(selected) do
		if not isAutoLoopOn or selectedBuyMode ~= "Selected" then break end
		if isSel then
			local shopId, itemName = key:match("^(.-)|(.*)$")
			if shopId and itemName and not excludedShops[shopId] and not excludedItems[key] then
				if enqueuePurchase(shopId, itemName, qty) then hasPurchased = true end
				task.wait(0.05)
			end
		end
	end

	if not hasPurchased then task.wait(0.2) end
end

local function executeBuyCurrentShop()
	local qty = getQuantity()
	local targetShop = currentShopFilter
	local hasPurchased = false

	if targetShop == "All" then
		for sId, items in pairs(shopItems) do
			if not isAutoLoopOn or selectedBuyMode ~= "CurrentShop" then break end
			if not excludedShops[sId] then
				for itemName in pairs(items) do
					if not isAutoLoopOn or selectedBuyMode ~= "CurrentShop" then break end
					local itemKey = sId .. "|" .. itemName
					if not excludedItems[itemKey] then
						if enqueuePurchase(sId, itemName, qty) then hasPurchased = true end
						task.wait(0.05)
					end
				end
			end
		end
	else
		if shopItems[targetShop] and not excludedShops[targetShop] then
			for itemName in pairs(shopItems[targetShop]) do
				if not isAutoLoopOn or selectedBuyMode ~= "CurrentShop" then break end
				local itemKey = targetShop .. "|" .. itemName
				if not excludedItems[itemKey] then
					if enqueuePurchase(targetShop, itemName, qty) then hasPurchased = true end
					task.wait(0.05)
				end
			end
		end
	end

	if not hasPurchased then task.wait(0.2) end
end

local function executeBuyAllShops()
	local qty = getQuantity()
	local hasPurchased = false

	for sId, items in pairs(shopItems) do
		if not isAutoLoopOn or selectedBuyMode ~= "AllShops" then break end
		if not excludedShops[sId] then
			for itemName in pairs(items) do
				if not isAutoLoopOn or selectedBuyMode ~= "AllShops" then break end
				local itemKey = sId .. "|" .. itemName
				if not excludedItems[itemKey] then
					if enqueuePurchase(sId, itemName, qty) then hasPurchased = true end
					task.wait(0.05)
				end
			end
		end
	end

	if not hasPurchased then task.wait(0.2) end
end

task.spawn(function()
	while scriptRunning do
		if isAutoLoopOn then
			if selectedBuyMode == "Selected" then
				executeBuySelected()
			elseif selectedBuyMode == "CurrentShop" then
				executeBuyCurrentShop()
			elseif selectedBuyMode == "AllShops" then
				executeBuyAllShops()
			end
		else
			task.wait(0.2)
		end
	end
end)

local function refreshBottomBarStyles()
	local activeGreen = Color3.fromRGB(35, 180, 90)
	local defaultDark = Color3.fromRGB(28, 35, 50)

	buySelectedBtn.BackgroundColor3 = (selectedBuyMode == "Selected") and activeGreen or Color3.fromRGB(0, 120, 180)
	buyCurrentShopBtn.BackgroundColor3 = (selectedBuyMode == "CurrentShop") and activeGreen or Color3.fromRGB(180, 110, 30)
	buyWholeShopsBtn.BackgroundColor3 = (selectedBuyMode == "AllShops") and activeGreen or Color3.fromRGB(140, 40, 140)

	if isAutoLoopOn then
		autoLoopBtn.Text = "Auto Loop: ON"
		autoLoopBtn.BackgroundColor3 = activeGreen
	else
		autoLoopBtn.Text = "Auto Loop: OFF"
		autoLoopBtn.BackgroundColor3 = defaultDark
	end
end

refreshBottomBarStyles()

