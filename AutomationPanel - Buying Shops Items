			rarityPriorityText = table.concat(selectedNames, ",")
			if rarityPriorityText == "" then rarityPriorityText = "Common,Uncommon,Rare,Epic,Legendary,Mythical,Ethereal" end
			rarityBox.Text = "Active Tiers: " .. rarityPriorityText
			rebuildAllowedRarities()
