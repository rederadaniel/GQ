-- Inventory snapshot tracking to enrich catch logs with real catch data

local knownInventory = {}

local function refreshInventorySnapshot()

	knownInventory = {}

	if InventoryState.HasFullSnapshot then

		for id in pairs(InventoryState.InventoryById) do

			knownInventory[id] = true

		end

	end

end

refreshInventorySnapshot()


local function enrichCatchPayload(entryType, payload)

	if not InventoryState or not InventoryDataAdapter or not InventoryState.HasFullSnapshot then return payload end

	local newEntries = {}

	for id, entry in pairs(InventoryState.InventoryById) do

		if not knownInventory[id] then

			table.insert(newEntries, entry)

		end

	end

	local best = nil

	for _, entry in ipairs(newEntries) do

		local isFish = InventoryDataAdapter.IsCaughtFishItem(entry)

		local isBug = InventoryDataAdapter.IsCritterItem(entry) and not isFish

		if (entryType == "Fish" and isFish) or (entryType == "Bug" and isBug) then

			best = entry

			break

		end

	end

	refreshInventorySnapshot()

	if not best then return payload end

	local meta = (type(best.Metadata) == "table") and best.Metadata or best

	local enriched = table.clone(payload)

	enriched.name = enriched.name or InventoryDataAdapter.GetBaseDisplayName(best.ItemName, best)

	enriched.sizeMultiplier = enriched.sizeMultiplier or meta.SizeMultiplier

	enriched.patternId = enriched.patternId or meta.PatternId

	enriched.displayWeight = enriched.displayWeight or meta.DisplayWeight

	enriched.weightGrams = enriched.weightGrams or InventoryDataAdapter.GetWeightGrams(best)

	enriched.weight = enriched.weight or meta.Weight

	enriched.price = enriched.price or meta.Price or meta.SellPrice

	enriched.rarity = enriched.rarity or meta.Rarity

	return enriched

end


local RARITY_ORDER = {

	Ethereal = 1, Mythical = 2, Legendary = 3, Epic = 4, Rare = 5, Uncommon = 6, Common = 7

}

local function getRarityRank(r)

	return RARITY_ORDER[r] or 99

end


local RARITY_PRICE = {

	Ethereal = 100000, Mythical = 50000, Legendary = 25000, Epic = 10000, Rare = 5000, Uncommon = 1000, Common = 100

}

local function getRarityPrice(r)

	return RARITY_PRICE[r] or 100

end

local RARITY_FILTERS = {"All", "Ethereal", "Mythical", "Legendary", "Epic", "Rare", "Uncommon", "Common"}


local function getItemRarity(itemType, displayName)

	local module = (itemType == "Bug") and CaughtBugs or CaughtFish 

	for _, def in pairs(module) do

		if type(def) == "table" and def.DisplayName == displayName then

			if itemType == "Bug" then

				return def.Rarity or "Common"

			else

				local so = def.SortOrder or 60

				if so <= 10 then return "Common"

				elseif so <= 20 then return "Uncommon"

				elseif so <= 30 then return "Rare"

				elseif so <= 40 then return "Epic"

				elseif so <= 50 then return "Legendary"

				elseif so <= 60 then return "Mythical"

				else return "Ethereal" end

			end

		end

	end

	return "Common"

end


local function addCatchLog(entryType, payload)

	payload = enrichCatchPayload(entryType, payload)

	local displayName = payload.DisplayName or payload.displayName or payload.name or payload.Name or payload.type or "Unknown"

	local rarity

	if entryType == "Fish" then

		rarity = payload.rarity or getItemRarity("Fish", displayName)

	else

		rarity = fishRarityMap[displayName] or getItemRarity("Bug", displayName)

	end

	local entry = {

		payload = payload,

		name = displayName,

		rarity = rarity,

		price = tonumber(payload.price) or getRarityPrice(rarity),

		sortOrder = payload.SortOrder or 0,

		time = os.time()

	}

	if entryType == "Fish" then

		table.insert(fishCatchEntries, entry)

		entry.winNo = #fishCatchEntries

		fishRarityMap[displayName] = rarity

	else

		table.insert(bugCatchEntries, entry)

		entry.winNo = #bugCatchEntries

	end

	renderCatchLogs()

end


local function firstPayloadValue(payload, ...)

	for _, key in ipairs({...}) do

		local value = payload[key]

		if value ~= nil and value ~= "" then return value end

	end

	return nil

end


local function formatWeightText(p)

	local grams = tonumber(p.weightGrams)

	if grams then

		return string.format("%.2f KG", grams / 1000)

	end

	local dw = firstPayloadValue(p, "displayWeight", "DisplayWeight", "weight", "Weight")

	if dw ~= nil and dw ~= "" then return tostring(dw) end

	return "N/A"

end


local function formatK(n)

	n = tonumber(n) or 0

	if n >= 1000 then

		return string.format("%.1fk", n / 1000)

	end

	return tostring(n)

end


local function formatCatchEntry(entryType, e)

	local p = e.payload or {}

	local lines = {}

	local winNo = e.winNo or 1

	local typeLabel = string.lower(entryType or "catch")

	table.insert(lines, "Win No." .. tostring(winNo) .. " " .. typeLabel)

	table.insert(lines, "----------------------------")

	table.insert(lines, "    name = " .. tostring(firstPayloadValue(p, "name", "Name", "DisplayName") or e.name))

	table.insert(lines, "    weight = " .. formatWeightText(p))

	local price = tonumber(firstPayloadValue(p, "price", "Price") or e.price) or 0

	local fee = math.floor(price * 0.1 + 0.5)

	local afterFee = price - fee

	table.insert(lines, "    price = " .. formatK(price))

	table.insert(lines, "    10% seller fee = " .. formatK(afterFee) .. " 10% - " .. tostring(fee) .. " seller fee")

	table.insert(lines, "    rarity = " .. tostring(firstPayloadValue(p, "rarity", "Rarity") or e.rarity))

	return table.concat(lines, "\n")

end


local function getSortedEntries(entries, sortMode)

	local sorted = {}

	for _, e in ipairs(entries) do table.insert(sorted, e) end

	if sortMode == "Rarity" then

		table.sort(sorted, function(a, b)

			local ra, rb = getRarityRank(a.rarity), getRarityRank(b.rarity)

			if ra == rb then return a.time < b.time end

			return ra < rb

		end)

	elseif sortMode == "Price" then

		table.sort(sorted, function(a, b)

			if a.price == b.price then return a.time < b.time end

			return a.price > b.price

		end)

	else

		table.sort(sorted, function(a, b) return a.time < b.time end)

	end

	return sorted

end


