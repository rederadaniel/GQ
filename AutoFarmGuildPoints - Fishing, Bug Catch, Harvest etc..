		mainPanel.Size = minimized and UDim2.fromOffset(528, 42) or UDim2.fromOffset(528, 605)

		minBtn.Text = minimized and "+" or "−"

	end)


	closeBtn.MouseButton1Click:Connect(function()

		mainPanel.Visible = false

		reopenBtn.Visible = true

	end)


	reopenBtn.MouseButton1Click:Connect(function()

		mainPanel.Visible = true

		reopenBtn.Visible = false

	end)


	destroyBtn.MouseButton1Click:Connect(function()

		_G.AutoHarvestRunning = false

		stopAutoFarmGuildPoints()

		isAutoFishingActive = false

		isAutoBugCatchActive = false

		isAutoTradeCropsActive = false

		isAutoTradeBugsActive = false

		isAutoTradeFishActive = false

		if fishKeybindConnection then fishKeybindConnection:Disconnect() fishKeybindConnection = nil end

		if bugKeybindConnection then bugKeybindConnection:Disconnect() bugKeybindConnection = nil end

		if fishInputConnection then fishInputConnection:Disconnect() fishInputConnection = nil end

		if fishAutoCastConnection then fishAutoCastConnection:Disconnect() fishAutoCastConnection = nil end

		if bugHoldConnection then bugHoldConnection:Disconnect() bugHoldConnection = nil end

		screenGui:Destroy()

	end)

end


buildGui()

