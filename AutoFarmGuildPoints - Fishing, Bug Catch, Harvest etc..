-- Mutual-exclusive Auto Trade toggles (only one active at a time)

local tradeToggleActive = {}

local tradeToggleButtons = {}

local tradeToggleSaved = {}

local tradeExclusiveActive = nil

local function setTradeToggleVisual(label, on)

	local btn = tradeToggleButtons[label]

	if btn then

		btn.Text = on and "ON" or "OFF"

		btn.BackgroundColor3 = on and Colors.TOGGLE_ON or Colors.TOGGLE_OFF

	end

end

local function syncTradeFlags()

	tradeToggleActive["Auto Trade Crops/Fruits"] = tradeToggleActive["Auto Trade Crops/Fruits"] or false

	tradeToggleActive["Auto Trade All Bugs"] = tradeToggleActive["Auto Trade All Bugs"] or false

	tradeToggleActive["Auto Trade All Fish"] = tradeToggleActive["Auto Trade All Fish"] or false

	isAutoTradeCropsActive = tradeToggleActive["Auto Trade Crops/Fruits"]

	isAutoTradeBugsActive = tradeToggleActive["Auto Trade All Bugs"]

	isAutoTradeFishActive = tradeToggleActive["Auto Trade All Fish"]

end

local function handleTradeToggle(label, on)

	if on then

		tradeExclusiveActive = label

		tradeToggleSaved = {}

		for other, wasOn in pairs(tradeToggleActive) do

			if other ~= label and wasOn then

				tradeToggleSaved[other] = true

				tradeToggleActive[other] = false

				setTradeToggleVisual(other, false)

			end

		end

		tradeToggleActive[label] = true

		setTradeToggleVisual(label, true)

	else

		if tradeExclusiveActive == label then tradeExclusiveActive = nil end

		tradeToggleActive[label] = false

		setTradeToggleVisual(label, false)

	end

	syncTradeFlags()

end

local function restoreTradeToggles()

	if tradeExclusiveActive then

		tradeToggleActive[tradeExclusiveActive] = false

		setTradeToggleVisual(tradeExclusiveActive, false)

		tradeExclusiveActive = nil

	end

	for label in pairs(tradeToggleSaved) do

		tradeToggleActive[label] = true

		setTradeToggleVisual(label, true)

	end

	tradeToggleSaved = {}

	syncTradeFlags()

end


