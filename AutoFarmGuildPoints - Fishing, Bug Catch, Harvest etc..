		local filterLower = string.lower(filter or "")

		local sorted = {}

		for _, f in ipairs(fruitList) do

			if (fruitRarityFilter == "All" or f.rarity == fruitRarityFilter) and (filterLower == "" or string.find(string.lower(f.name), filterLower, 1, true)) then

				table.insert(sorted, f)

			end

		end

		if fruitSortMode == "Rarity" then

			table.sort(sorted, function(a, b)

				local ra, rb = getRarityRank(a.rarity), getRarityRank(b.rarity)

				if ra == rb then return a.name < b.name end

				return ra < rb

			end)

		elseif fruitSortMode == "OwnFruits" or fruitSortMode == "Fruit in your garden" then

			local owned = getOwnedFruitSet()

			local filtered = {}

			for _, f in ipairs(sorted) do

				if owned[f.key] then table.insert(filtered, f) end

			end

			sorted = filtered

			table.sort(sorted, function(a, b) return a.name < b.name end)

