	bugSortLabel.Font = Enum.Font.GothamMedium
	bugSortLabel.TextSize = 12
	bugSortLabel.Size = UDim2.fromOffset(42, 34)
	bugSortLabel.Position = UDim2.fromOffset(8, 0)
	bugSortLabel.TextXAlignment = Enum.TextXAlignment.Left
	bugSortLabel.Parent = bugSortRow
	local bugSortButtons = {}
	local bugSortModes = {"Newest", "Rarity", "Price"}
	local function setBugSort(mode)
		bugSortMode = mode
		for i, btn in ipairs(bugSortButtons) do
			btn.BackgroundColor3 = (bugSortModes[i] == mode) and Colors.ACCENT or Colors.ACCENT_2
		end
		renderCatchLogs()
	end
	for i, mode in ipairs(bugSortModes) do
		local btn = Instance.new("TextButton")
		btn.BackgroundColor3 = (mode == "Newest") and Colors.ACCENT or Colors.ACCENT_2
		btn.BorderSizePixel = 0
		btn.Text = mode
		btn.TextColor3 = Colors.TEXT
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 10
		btn.Size = UDim2.fromOffset(58, 24)
		btn.Position = UDim2.new(0, 52 + (i - 1) * 62, 0.5, -12)
		btn.Parent = bugSortRow
		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 6)
		btnCorner.Parent = btn
		btn.MouseButton1Click:Connect(function() setBugSort(mode) end)
		bugSortButtons[i] = btn
	end

	local bugFilterRow = Instance.new("Frame")
	bugFilterRow.Visible = true
	bugFilterRow.BackgroundColor3 = Colors.LOG_BG
	bugFilterRow.BorderSizePixel = 0
	bugFilterRow.Size = UDim2.new(1, 0, 0, 34)
	bugFilterRow.LayoutOrder = nextOrder()
