local function calculateOffsetCFrame(targetCFrame)
	local backVector = targetCFrame.LookVector * -BACK_OFFSET
	local upVector = Vector3.new(0, FLY_HEIGHT_OFFSET, 0)
	return targetCFrame + backVector + upVector
end

