	local function updateBugPrediction()

		local islandName = getCurrentIslandName()

		bugPredictionIslandLabel.Text = "Current Island: " .. islandName

		local lines = { "Bugs you can win at " .. islandName .. ":" }

		local bugList = {}

		for _, def in pairs(CaughtBugs) do

			if type(def) == "table" and def.DisplayName and def.IslandIds then

				for _, id in ipairs(def.IslandIds) do

					if id == islandName then

						local r = def.Rarity or "Common"

						if (bugPredRarity == "All" or r == bugPredRarity) and (bugPredSearchText == "" or string.find(string.lower(def.DisplayName), string.lower(bugPredSearchText), 1, true)) then

							table.insert(bugList, { name = def.DisplayName, rarity = r })

						end

						break

					end

				end

			end

		end

		table.sort(bugList, function(a, b)

			local ra, rb = getRarityRank(a.rarity), getRarityRank(b.rarity)

			if ra == rb then return a.name < b.name end

			return ra < rb

		end)

		for i, b in ipairs(bugList) do

			table.insert(lines, tostring(i) .. ".) " .. b.name .. " [" .. b.rarity .. "]")

		end

		bugPredictionLabel.Text = table.concat(lines, "\n")

	end


