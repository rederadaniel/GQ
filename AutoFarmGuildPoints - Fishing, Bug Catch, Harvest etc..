local function destroyWhirlpoolFlightForce()
	if whirlpoolFlightForce then
		whirlpoolFlightForce:Destroy()
		whirlpoolFlightForce = nil
	end
	local root = getCharacterRootAndHumanoid()
	local existing = root and root:FindFirstChild("WhirlpoolFlightForce")
	if existing then existing:Destroy() end
end

local function startFloating(targetCFrame)
	local root, humanoid = getCharacterRootAndHumanoid()
	if not root or not humanoid or not targetCFrame then return false end
	root.CFrame = calculateOffsetCFrame(targetCFrame)
	humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	if not whirlpoolFlightForce or whirlpoolFlightForce.Parent ~= root then
		destroyWhirlpoolFlightForce()
		whirlpoolFlightForce = Instance.new("BodyVelocity")
		whirlpoolFlightForce.Name = "WhirlpoolFlightForce"
		whirlpoolFlightForce.Velocity = Vector3.new(0, 0, 0)
		whirlpoolFlightForce.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		whirlpoolFlightForce.Parent = root
	end
	return true
end

local function returnToOriginalPosition()
