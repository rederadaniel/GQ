				if mutationSortMode == "Exist" then

					showRow = exist > 0

				elseif mutationSortMode == "0 Exist" then

					showRow = exist == 0

				elseif mutationSortMode == "Selected" then

					showRow = _G.AutoHarvestMutations[displayName] == true

				end

				if showRow and (filterLower == "" or string.find(string.lower(displayName), filterLower, 1, true)) then

					local mult = CropMutationConfig.GetSellMultiplier(key) or 0

					rowOrder += 1

					local row = Instance.new("Frame")

