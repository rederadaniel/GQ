-- Auto Fishing: instant re-cast when the minigame finishes

local fishInputConnection = nil

local fishAutoCastConnection = nil

local wasMinigameActive = false


local function simulateHold(holding)

	if holding then

		VirtualUser:Button1Down(Vector2.new(0, 0))

	else

		VirtualUser:Button1Up(Vector2.new(0, 0))

	end

end


local function manualTrackInput()

	local FishingGui = PlayerGui:FindFirstChild("FishingMinigameGui")

	local Container = FishingGui and FishingGui:FindFirstChild("FishingBoxContainer")

	local catchBox = Container and Container:FindFirstChild("CatchBox")

	local fishBox = Container and Container:FindFirstChild("FishBox")

	if catchBox and fishBox then

		simulateHold(catchBox.AbsolutePosition.X < fishBox.AbsolutePosition.X)

	else

		simulateHold(false)

	end

end


local function checkMinigameState()

	if not isAutoFishingActive or fishingPausedForWhirlpool then return end

	local gui = PlayerGui:FindFirstChild("FishingMinigameGui")

	local container = gui and gui:FindFirstChild("FishingBoxContainer")

	local minigameActive = container ~= nil and container.Visible ~= false


	if minigameActive then

		wasMinigameActive = true

		local now = os.clock()

		if fishMiniGameRemote and not fishWonThisSession and now - fishLastCompleteFire > 1.0 then

			fishLastCompleteFire = now

			fishWonThisSession = true

			simulateHold(false)

			pcall(function()

				fishMiniGameRemote:FireServer("Complete", tostring(fishSessionId), {result = "Caught", reason = "ProgressComplete", elapsed = now - fishLastCastAt})

			end)

		end

	else

		if wasMinigameActive then

			wasMinigameActive = false

			if isAutoFishingActive and not fishingPausedForWhirlpool then

				task.delay(0.1, function()

					if isAutoFishingActive and not fishingPausedForWhirlpool then performCast() end

				end)

			end

		end

	end

end


local function toggleFishingCore(state)

	if state then

		if not fishInputConnection then

			fishInputConnection = RunService.Heartbeat:Connect(manualTrackInput)

		end

		if not fishAutoCastConnection then

			fishAutoCastConnection = RunService.Heartbeat:Connect(checkMinigameState)

		end

		performCast()

	else

		if not isAutoFishingActive then

			if fishInputConnection then fishInputConnection:Disconnect() fishInputConnection = nil end

			if fishAutoCastConnection then fishAutoCastConnection:Disconnect() fishAutoCastConnection = nil end

			simulateHold(false)

			wasMinigameActive = false

		end

	end

end


local function stopAutoFarmGuildPoints()

	autoFarmGuildPointsEnabled = false

	autoFarmGuildPointsStarting = false

	if whirlpoolTransitionThread and coroutine.status(whirlpoolTransitionThread) ~= "dead" then

		task.cancel(whirlpoolTransitionThread)

	end

	whirlpoolTransitionThread = nil

	whirlpoolCastForInstance = nil

	cancelAutoFarmGuildPointsTasks()

	if whirlpoolHeartbeatConnection then

		whirlpoolHeartbeatConnection:Disconnect()

		whirlpoolHeartbeatConnection = nil

	end

	if whirlpoolMonitorConnection then

		whirlpoolMonitorConnection:Disconnect()

		whirlpoolMonitorConnection = nil

	end

	if whirlpoolRemovedConnection then

		whirlpoolRemovedConnection:Disconnect()

		whirlpoolRemovedConnection = nil

	end

	isAutoFishingActive = false

	whirlpoolFarmingEnabled = false

	autoWhirlpoolEnabled = false

	fishingPausedForWhirlpool = false

	toggleFishingCore(false)

	returnToOriginalPosition()

	setAutoFarmGuildPointsToggleState("Just Fishing mode 1", false)

	setAutoFarmGuildPointsToggleState("Auto Fishing + Whirlpool mode 3", false)

	setAutoFarmGuildPointsToggleState("Start Fishing", false)

end


local function runWhirlpoolAutoFarm()

	local activeWhirlpools = Workspace:FindFirstChild("ActiveWhirlpools")

	if not activeWhirlpools then

		returnToOriginalPosition()

		return

	end

	whirlpoolMonitorConnection = activeWhirlpools.ChildAdded:Connect(function(child)

		if autoFarmGuildPointsEnabled and whirlpoolFarmingEnabled and child.Name == "Whirlpool" then

			fishingPausedForWhirlpool = true

			local targetCFrame = getWhirlpoolCFrame(child)

			if targetCFrame then

				startFloating(targetCFrame)

				whirlpoolCastForInstance = nil

				if autoWhirlpoolEnabled then

					if whirlpoolTransitionThread and coroutine.status(whirlpoolTransitionThread) ~= "dead" then task.cancel(whirlpoolTransitionThread) end

					whirlpoolTransitionThread = task.spawn(function()

						task.wait(CAST_DELAY)

						if autoFarmGuildPointsEnabled and autoWhirlpoolEnabled and child.Parent == activeWhirlpools and not wasMinigameActive and not fishCasting then

							performCast()

							whirlpoolCastForInstance = child

							-- Resume auto-fishing minigame logic after casting at the whirlpool

							fishingPausedForWhirlpool = false

						end

					end)

				end

			end

		end

	end)

	whirlpoolRemovedConnection = activeWhirlpools.ChildRemoved:Connect(function(child)

		if autoFarmGuildPointsEnabled and whirlpoolFarmingEnabled and child.Name == "Whirlpool" then

			whirlpoolCastForInstance = nil

			fishingPausedForWhirlpool = false

			returnToOriginalPosition()

			-- Whirlpool gone: resume normal fishing (mode 1)

			if autoFarmGuildPointsEnabled and autoFishingMode == "Auto Fishing + Whirlpool mode 3" and isAutoFishingActive and not wasMinigameActive and not fishCasting then

				performCast()

			end

		end

	end)

	while autoFarmGuildPointsEnabled and whirlpoolFarmingEnabled do

		local whirlpool = activeWhirlpools:FindFirstChild("Whirlpool")

		local targetCFrame = getWhirlpoolCFrame(whirlpool)

		if targetCFrame then

			startFloating(targetCFrame)

			if autoWhirlpoolEnabled and whirlpoolCastForInstance ~= whirlpool and not fishCasting and not wasMinigameActive then

				if whirlpoolTransitionThread == nil or coroutine.status(whirlpoolTransitionThread) == "dead" then

					whirlpoolTransitionThread = task.spawn(function()

						task.wait(CAST_DELAY)

						if autoFarmGuildPointsEnabled and autoWhirlpoolEnabled and whirlpool.Parent == activeWhirlpools and not wasMinigameActive and not fishCasting then

							performCast()

							whirlpoolCastForInstance = whirlpool

							-- resume the auto-fishing minigame logic after casting at the whirlpool

							fishingPausedForWhirlpool = false

						end

					end)

				end

			end

			task.wait(0.2)

		else

			fishingPausedForWhirlpool = false

			whirlpoolCastForInstance = nil

			returnToOriginalPosition()

			-- No whirlpool active: normal fishing (mode 1) is handled by the heartbeat re-cast logic.

			-- Do NOT manually cast here, otherwise it multi-casts.

			task.wait(0.5)

		end

	end

end


local function startAutoFarmGuildPoints()

	if autoFarmGuildPointsEnabled or autoFarmGuildPointsStarting then return end

	local root = getCharacterRootAndHumanoid()

	if not root then return end

	autoFarmGuildPointsStarting = true

	autoFarmGuildPointsEnabled = true

	originalPlayerCFrame = root.CFrame

	isAutoFishingActive = true

	whirlpoolFarmingEnabled = autoFishingMode == "Auto Fishing + Whirlpool mode 3"

	autoWhirlpoolEnabled = whirlpoolFarmingEnabled

	setAutoFarmGuildPointsToggleState("Just Fishing mode 1", autoFishingMode == "Just Fishing mode 1")

	setAutoFarmGuildPointsToggleState("Auto Fishing + Whirlpool mode 3", autoFishingMode == "Auto Fishing + Whirlpool mode 3")

	setAutoFarmGuildPointsToggleState("Start Fishing", true)

	if whirlpoolFarmingEnabled and not whirlpoolHeartbeatConnection then

		whirlpoolHeartbeatConnection = RunService.Heartbeat:Connect(function()

			if not autoFarmGuildPointsEnabled or not whirlpoolFarmingEnabled then return end

			local targetCFrame = getWhirlpoolCFrame(getActiveWhirlpool())

			if targetCFrame then startFloating(targetCFrame) end

		end)

	end

	if not fishInputConnection then fishInputConnection = RunService.Heartbeat:Connect(manualTrackInput) end

	if not fishAutoCastConnection then fishAutoCastConnection = RunService.Heartbeat:Connect(checkMinigameState) end

	local thread = task.spawn(function()

		if whirlpoolFarmingEnabled then

			local activeWhirlpools = Workspace:FindFirstChild("ActiveWhirlpools")

			if activeWhirlpools and not getActiveWhirlpool() then

				-- No whirlpool active: do normal fishing (mode 1) first

				fishingPausedForWhirlpool = false

				returnToOriginalPosition()

				performCast()

			end

			if autoFarmGuildPointsEnabled and getActiveWhirlpool() then

				fishingPausedForWhirlpool = true

				local targetCFrame = getWhirlpoolCFrame(getActiveWhirlpool())

				if targetCFrame then startFloating(targetCFrame) end

				task.wait(CAST_DELAY)

				if autoFarmGuildPointsEnabled and autoWhirlpoolEnabled then

					performCast()

					whirlpoolCastForInstance = getActiveWhirlpool()

					-- Resume auto-fishing minigame logic after casting at the whirlpool

					fishingPausedForWhirlpool = false

				end

			end

			runWhirlpoolAutoFarm()

		else

			performCast()

		end

	end)

	table.insert(autoFarmGuildPointsTasks, thread)

	autoFarmGuildPointsStarting = false

end


