	local function getOwnedFruitSet()

		local owned = {}

		local map = workspace:FindFirstChild("Map")

		local island = map and map:FindFirstChild("MainIsland")

		local gardens = island and island:FindFirstChild("PlayerGardens")

		local plots = gardens and gardens:FindFirstChild("Plots")

		if plots then

			for _, plot in ipairs(plots:GetChildren()) do

				local ownerId = plot:GetAttribute("OwnerUserId")

				if ownerId == LocalPlayer.UserId then

					local plantedSeeds = plot:FindFirstChild("PlantedSeeds") or plot

					for _, plant in ipairs(plantedSeeds:GetChildren()) do

						local baseName = string.split(plant.Name, ":")[1]

						owned[baseName] = true

					end

				end

			end

		end

		return owned

	end


	updateFruitRarityCounts = function()

		local counts = { All = 0, Ethereal = 0, Mythical = 0, Legendary = 0, Epic = 0, Rare = 0, Uncommon = 0, Common = 0 }

		local owned = nil

		if fruitSortMode == "Fruit in your garden" then

			owned = getOwnedFruitSet()

		end

		for _, f in ipairs(fruitList) do

			if owned == nil or owned[f.key] then

				counts.All += 1

				if counts[f.rarity] then counts[f.rarity] += 1 end

			end

		end

		fruitRarityCountLabel.Text = "All: " .. counts.All

			.. "  Ethereal: " .. counts.Ethereal

			.. "  Mythical: " .. counts.Mythical

			.. "  Legendary: " .. counts.Legendary

			.. "  Epic: " .. counts.Epic

			.. "  Rare: " .. counts.Rare

			.. "  Uncommon: " .. counts.Uncommon

			.. "  Common: " .. counts.Common

	end

