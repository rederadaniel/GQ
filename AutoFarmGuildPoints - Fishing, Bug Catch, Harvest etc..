	local bugFilterLabel = Instance.new("TextLabel")
	bugFilterLabel.BackgroundTransparency = 1
	bugFilterLabel.Text = "Filter:"
	bugFilterLabel.TextColor3 = Colors.TEXT
	bugFilterLabel.Font = Enum.Font.GothamMedium
	bugFilterLabel.TextSize = 12
	bugFilterLabel.Size = UDim2.fromOffset(42, 34)
	bugFilterLabel.Position = UDim2.fromOffset(8, 0)
	bugFilterLabel.TextXAlignment = Enum.TextXAlignment.Left
	bugFilterLabel.Parent = bugFilterRow
	local bugFilterButtons = {}
	local bugFilterModes = {"All", "Fish", "Bug"}
	local function setBugFilter(mode)
		catchFilterMode = mode
		for i, btn in ipairs(bugFilterButtons) do
			btn.BackgroundColor3 = (bugFilterModes[i] == mode) and Colors.ACCENT or Colors.ACCENT_2
		end
		renderCatchLogs()
	end
	for i, mode in ipairs(bugFilterModes) do
		local btn = Instance.new("TextButton")
		btn.BackgroundColor3 = (mode == "All") and Colors.ACCENT or Colors.ACCENT_2
		btn.BorderSizePixel = 0
		btn.Text = mode
		btn.TextColor3 = Colors.TEXT
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 10
		btn.Size = UDim2.fromOffset(52, 24)
		btn.Position = UDim2.new(0, 52 + (i - 1) * 62, 0.5, -12)
		btn.Parent = bugFilterRow
		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 6)
		btnCorner.Parent = btn
		btn.MouseButton1Click:Connect(function() setBugFilter(mode) end)
		bugFilterButtons[i] = btn
	end

	local bugClearBtn = Instance.new("TextButton")
	bugClearBtn.Visible = true
	bugClearBtn.BackgroundColor3 = Colors.ACCENT_2
	bugClearBtn.BorderSizePixel = 0
	bugClearBtn.Text = "Clear Fish/Bug Logs"
	bugClearBtn.TextColor3 = Colors.TEXT
	bugClearBtn.Font = Enum.Font.GothamBold
	bugClearBtn.TextSize = 11
	bugClearBtn.Size = UDim2.new(1, 0, 0, 28)
	bugClearBtn.LayoutOrder = nextOrder()
	bugClearBtn.Parent = content
	local bugClearCorner = Instance.new("UICorner")
	bugClearCorner.CornerRadius = UDim.new(0, 8)
	bugClearCorner.Parent = bugClearBtn
	bugClearBtn.MouseButton1Click:Connect(function()
		fishCatchEntries = {}
		bugCatchEntries = {}
		renderCatchLogs()
	end)

	local bugCatchLogScroll = Instance.new("ScrollingFrame")
	bugCatchLogScroll.Visible = true
	bugCatchLogScroll.Name = "BugCatchLogScroll"
	bugCatchLogScroll.BackgroundColor3 = Colors.LOG_BG
	bugCatchLogScroll.BorderSizePixel = 0
	bugCatchLogScroll.Size = UDim2.new(1, 0, 0, 200)
	bugCatchLogScroll.ScrollBarThickness = 4
	bugCatchLogScroll.ScrollBarImageColor3 = Colors.ACCENT
	bugCatchLogScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	bugCatchLogScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	bugCatchLogScroll.LayoutOrder = nextOrder()
	bugCatchLogScroll.Parent = content
	local bugCatchLogCorner = Instance.new("UICorner")
	bugCatchLogCorner.CornerRadius = UDim.new(0, 6)
