	local bugCatchLogPadding = Instance.new("UIPadding")
	bugCatchLogPadding.PaddingLeft = UDim.new(0, 8)
	bugCatchLogPadding.PaddingRight = UDim.new(0, 8)
	bugCatchLogPadding.PaddingTop = UDim.new(0, 6)
	bugCatchLogPadding.PaddingBottom = UDim.new(0, 6)
	bugCatchLogPadding.Parent = bugCatchLogScroll

	bugCatchLabel = Instance.new("TextLabel")
	bugCatchLabel.BackgroundTransparency = 1
	bugCatchLabel.Text = "Fish/Bug Catch Logs"
	bugCatchLabel.TextColor3 = Colors.TEXT_MUTED
	bugCatchLabel.Font = Enum.Font.Code
	bugCatchLabel.TextSize = 11
	bugCatchLabel.TextWrapped = false
	bugCatchLabel.TextXAlignment = Enum.TextXAlignment.Left
	bugCatchLabel.TextYAlignment = Enum.TextYAlignment.Top
	bugCatchLabel.Size = UDim2.new(1, 0, 0, 0)
	bugCatchLabel.AutomaticSize = Enum.AutomaticSize.Y
	bugCatchLabel.Parent = bugCatchLogScroll

	-- Catch Log toggle handler (defined after all referenced widgets exist)
	catchLogToggleBtn.MouseButton1Click:Connect(function()
		catchLogExpanded = not catchLogExpanded
		catchLogToggleBtn.Text = (catchLogExpanded and "▼" or "▶") .. " Fish/Bug Catch Logs"
		bugSearchBox.Visible = catchLogExpanded
		bugSortRow.Visible = catchLogExpanded
		bugFilterRow.Visible = catchLogExpanded
		bugClearBtn.Visible = catchLogExpanded
		bugCatchLogScroll.Visible = catchLogExpanded
		catchLogGuide.Visible = catchLogExpanded
	end)

	-- Window Actions
	local minimized = false
	minBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		content.Visible = not minimized
		mainPanel.Size = minimized and UDim2.fromOffset(528, 38) or UDim2.fromOffset(528, 605)
		minBtn.Text = minimized and "+" or "-"
	end)

	closeBtn.MouseButton1Click:Connect(function()
		mainPanel.Visible = false
		reopenBtn.Visible = true
	end)

	reopenBtn.MouseButton1Click:Connect(function()
		mainPanel.Visible = true
		reopenBtn.Visible = false
	end)

	destroyBtn.MouseButton1Click:Connect(function()
		_G.AutoHarvestRunning = false
		stopAutoFarmGuildPoints()
		isAutoFishingActive = false
		isAutoBugCatchActive = false
		isAutoTradeCropsActive = false
		isAutoTradeBugsActive = false
		isAutoTradeFishActive = false
		if fishKeybindConnection then fishKeybindConnection:Disconnect() fishKeybindConnection = nil end
		if bugKeybindConnection then bugKeybindConnection:Disconnect() bugKeybindConnection = nil end
		if fishInputConnection then fishInputConnection:Disconnect() fishInputConnection = nil end
		if fishAutoCastConnection then fishAutoCastConnection:Disconnect() fishAutoCastConnection = nil end
		if bugHoldConnection then bugHoldConnection:Disconnect() bugHoldConnection = nil end
		screenGui:Destroy()
	end)
end

buildGui()
