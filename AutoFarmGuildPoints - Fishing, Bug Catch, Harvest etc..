-- Apply a smooth diagonal gradient to a GuiObject

local function applyGradient(guiObject, fromColor, toColor, angle, animate)

	local grad = Instance.new("UIGradient")

	grad.Color = ColorSequence.new(fromColor, toColor)

	grad.Rotation = angle or 90

	grad.Parent = guiObject

	if animate then

		local dir = 1

		task.spawn(function()

			while grad.Parent do

				local tw = game:GetService("TweenService"):Create(grad, TweenInfo.new(3.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Offset = Vector2.new(dir * 0.08, 0) })

				tw:Play()

				tw.Completed:Wait()

				if not grad.Parent then break end

				dir = -dir

			end

		end)

	end

	return grad

end


-- Glassmorphism: translucent surface + soft inner glow + crisp border

local function applyGlass(guiObject, baseColor, transparency, strokeColor, strokeTransparency)

	guiObject.BackgroundColor3 = baseColor or Colors.PANEL

