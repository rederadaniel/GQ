local function createToggle(parent, labelText, initialState, callback)
	local percentLabel
	local function updatePercent()
		local npcPath = labelText == "Auto Trade Crops/Fruits" and {"FruitTurnInNpc", "CatOrangeNpc"}
			or labelText == "Auto Trade All Bugs" and {"BugTurnInNpc", "CatBlackNPC"}
			or labelText == "Auto Trade All Fish" and {"FishTurnInNpc", "CatGreyNpc"}
		if not npcPath then return end
		local npcFolder = workspace:FindFirstChild("FillMeterNpcs")
		local npc = npcFolder and npcFolder:FindFirstChild(npcPath[1])
		local label = npc and npc:FindFirstChild(npcPath[2]) and npc[npcPath[2]]:FindFirstChild("PercentageSign", true)
		label = label and label:FindFirstChild("SurfaceGui") and label.SurfaceGui:FindFirstChild("TextLabel")
		if label and label:IsA("TextLabel") then percentLabel.Text = label.Text end
	end
	local container = Instance.new("Frame")
	container.Name = labelText:gsub("%s+", "") .. "Toggle"
	container.BackgroundColor3 = Colors.LOG_BG
	container.BorderSizePixel = 0
	container.Size = UDim2.new(1, 0, 0, 36)
	container.LayoutOrder = nextOrder()
	container.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = container

	percentLabel = Instance.new("TextLabel")
	percentLabel.Name = "Percentage"
	percentLabel.BackgroundTransparency = 1
	percentLabel.Text = ""
	percentLabel.TextColor3 = Colors.ACCENT
	percentLabel.Font = Enum.Font.GothamBold
	percentLabel.TextSize = 12
	percentLabel.Size = UDim2.fromOffset(48, 36)
	percentLabel.Position = UDim2.new(1, -108, 0, 0)
	percentLabel.TextXAlignment = Enum.TextXAlignment.Right
	percentLabel.Parent = container
	updatePercent()

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = Colors.TEXT
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 13
	label.Size = UDim2.new(1, -60, 1, 0)
	label.Position = UDim2.fromOffset(10, 0)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = container

	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Name = "Toggle"
	local isModeToggle = labelText == "Just Fishing mode 1" or labelText == "Auto Fishing + Whirlpool mode 3"
	toggleBtn.BackgroundColor3 = isModeToggle and (initialState and Colors.ACCENT or Colors.TOGGLE_OFF) or (initialState and Colors.TOGGLE_ON or Colors.TOGGLE_OFF)
	toggleBtn.BorderSizePixel = 0
	toggleBtn.Text = isModeToggle and (initialState and "SELECTED" or "SELECT") or (initialState and "ON" or "OFF")
	toggleBtn.TextColor3 = Colors.TEXT
	toggleBtn.Font = Enum.Font.GothamBold
	toggleBtn.TextSize = 12
	toggleBtn.Size = UDim2.fromOffset(44, 22)
	toggleBtn.Position = UDim2.new(1, -54, 0.5, -11)
	toggleBtn.Parent = container
	if labelText == "Auto Trade Crops/Fruits" or labelText == "Auto Trade All Bugs" or labelText == "Auto Trade All Fish" then
		task.spawn(function()
			while container.Parent do
				updatePercent()
				task.wait(0.001)
			end
		end)
	end

	local toggleCorner = Instance.new("UICorner")
	toggleCorner.CornerRadius = UDim.new(0, 10)
	toggleCorner.Parent = toggleBtn

	local state = initialState
	toggleBtn.MouseButton1Click:Connect(function()
		if isModeToggle then
			state = true
			toggleBtn.Text = "SELECTED"
			toggleBtn.BackgroundColor3 = Colors.ACCENT
			callback(true)
			return
		end
		state = not state
		toggleBtn.Text = state and "ON" or "OFF"
		toggleBtn.BackgroundColor3 = state and Colors.TOGGLE_ON or Colors.TOGGLE_OFF
		callback(state)
	end)

	autoFarmGuildPointsToggleButtons[labelText] = toggleBtn
	return container, toggleBtn
end

