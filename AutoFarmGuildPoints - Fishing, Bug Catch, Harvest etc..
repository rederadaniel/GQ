-- Helper: Determine the current island name from character position
local function getCurrentIslandName()
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return "MainIsland" end
	local map = workspace:FindFirstChild("Map")
	if not map then return "MainIsland" end
	for _, island in ipairs(map:GetChildren()) do
		if island:IsA("Model") or island:IsA("Folder") then
			local ok, pivot, size = pcall(function()
				return island:GetBoundingBox()
			end)
			if ok and pivot then
				local rel = pivot.Position - root.Position
				if math.abs(rel.X) <= size.X / 2 and math.abs(rel.Y) <= size.Y / 2 and math.abs(rel.Z) <= size.Z / 2 then
					return island.Name
				end
			end
		end
	end
	return "MainIsland"
end

-- Auto Harvest Logic
local fruitLastAttempt = {}
local fruitHarvestBusy = {}

local function getFruitServerConfig(plantFolder, fruitIndex)
	local serverConfiguration = plantFolder:FindFirstChild("ServerConfiguration")
	local fruits = serverConfiguration and serverConfiguration:FindFirstChild("Fruits")
	return fruits and fruits:FindFirstChild(tostring(fruitIndex))
end

local function getFruitMutations(plantFolder, fruitIndex, fruitFolder)
	local names = {}
	local configFruit = getFruitServerConfig(plantFolder, fruitIndex)
	for _, obj in ipairs({configFruit, fruitFolder}) do
		if obj then
			local mutations = obj:FindFirstChild("Mutations", true)
			if mutations then
				if mutations:IsA("StringValue") then
					local v = mutations.Value
					if v and v ~= "" then
						for _, part in ipairs(string.split(v, ",")) do
							local trimmed = string.gsub(part, "^%s*(.-)%s*$", "%1")
							if trimmed ~= "" then table.insert(names, trimmed) end
						end
					end
				else
					for _, child in ipairs(mutations:GetChildren()) do
						table.insert(names, child.Name)
					end
				end
			end
		end
	end
	return names
end

local function isMutatedFruit(plantFolder, fruitIndex, fruitFolder)
	return #getFruitMutations(plantFolder, fruitIndex, fruitFolder) > 0
end

local function countMutations(plantFolder, fruitIndex, fruitFolder)
	return #getFruitMutations(plantFolder, fruitIndex, fruitFolder)
end

local function shouldHarvestByMutation(plantFolder, fruitIndex, fruitFolder)
	local names = getFruitMutations(plantFolder, fruitIndex, fruitFolder)
	if next(_G.AutoHarvestMutations) == nil then return true end
	for _, name in ipairs(names) do
		local display = CropMutationConfig.GetDisplayName(name) or name
		if _G.AutoHarvestMutations[display] then return true end
	end
	return false
end

local function getFruitDisplayName(seedKey)
	for key, def in pairs(HarvestedCrops) do
		if type(def) == "table" and key == seedKey then
			return def.DisplayName or seedKey
		end
	end
	return seedKey
end

local function shouldHarvestByName(plantFolder)
	if next(_G.AutoHarvestFruitNames) == nil then return true end
	local baseName = string.split(plantFolder.Name, ":")[1]
	local display = getFruitDisplayName(baseName)
	local lowerBase = string.lower(baseName)
	local lowerDisplay = string.lower(display)
	for _, name in ipairs(_G.AutoHarvestFruitNames) do
		local lower = string.lower(name)
		if lower == lowerBase or lower == lowerDisplay then return true end
	end
	return false
end

local function shouldHarvestSelectedFruit(plantFolder, fruitIndex, fruitFolder)
	local configFruit = getFruitServerConfig(plantFolder, fruitIndex)
	for _, object in ipairs({configFruit, fruitFolder}) do
		if object then
			local favorited = object:FindFirstChild("Favorited", true)
			if favorited and favorited:IsA("BoolValue") and favorited.Value then
				return true
			end
		if object:GetAttribute("Favorited") == true then
				return true
			end
		for _, descendant in ipairs(object:GetDescendants()) do
			if descendant:GetAttribute("Favorited") == true then
				return true
			end
			local descendantFavorited = descendant:FindFirstChild("Favorited")
			if descendantFavorited and descendantFavorited:IsA("BoolValue") and descendantFavorited.Value then
				return true
			end
		end
		end
	end
	return false
end

local function shouldHarvest(plantFolder, fruitIndex, fruitFolder)
	if _G.AutoHarvestMode == "Mutation Select" then
		return shouldHarvestByMutation(plantFolder, fruitIndex, fruitFolder)
	elseif _G.AutoHarvestMode == "Input Name" then
		return shouldHarvestByName(plantFolder)
	elseif _G.AutoHarvestMode == "Selected Fruits" then
		return shouldHarvestSelectedFruit(plantFolder, fruitIndex, fruitFolder)
	end
	return true
end

local function isReadyFruit(plantFolder, fruitIndex, fruitFolder)
	local configFruit = getFruitServerConfig(plantFolder, fruitIndex)
	local canHarvest = configFruit and configFruit:FindFirstChild("CanHarvest")
	if canHarvest and canHarvest:IsA("BoolValue") then return canHarvest.Value end

	for _, object in ipairs({configFruit, fruitFolder, plantFolder}) do
		if object then
			local ready = object:GetAttribute("CanHarvest")
			if ready ~= nil then return ready == true end
			local state = object:GetAttribute("State") or object:GetAttribute("Status")
			if type(state) == "string" and (string.find(string.lower(state), "ready") or string.find(string.lower(state), "done")) then return true end
		end
	end
	return false
end

local function getFruitTarget(plantFolder, fruitFolder)
	local prompt = fruitFolder:FindFirstChild("HarvestPrompt", true)
	if not prompt or not prompt:IsA("ProximityPrompt") then
		prompt = fruitFolder:FindFirstChildWhichIsA("ProximityPrompt", true)
	end
	if not prompt and plantFolder then
		prompt = plantFolder:FindFirstChild("HarvestPrompt", true)
		if not prompt or not prompt:IsA("ProximityPrompt") then
			prompt = plantFolder:FindFirstChildWhichIsA("ProximityPrompt", true)
		end
	end
	if prompt then
		local parent = prompt.Parent
		if parent:IsA("BasePart") then return parent.Position, prompt end
		local promptPart = prompt:FindFirstAncestorWhichIsA("BasePart")
		if promptPart then return promptPart.Position, prompt end
	end
	local fruit = fruitFolder:FindFirstChild("Fruit", true)
	if fruit and fruit:IsA("BasePart") then return fruit.Position, nil end
	local part = fruitFolder:FindFirstChildWhichIsA("BasePart", true)
	if not part and plantFolder then part = plantFolder:FindFirstChildWhichIsA("BasePart", true) end
	return part and part.Position, prompt
end

local function triggerFruitPrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then return false end
	pcall(function()
		if prompt.Enabled then
			prompt:InputHoldBegin()
			task.wait(math.max(prompt.HoldDuration, 0.05))
			prompt:InputHoldEnd()
		end
	end)
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
		task.wait(0.15)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
	end)
	return true
end

local function attemptFruitHarvest(plantFolder, fruitIndex, fruitFolder)
	if not isReadyFruit(plantFolder, fruitIndex, fruitFolder) then return false end
	if _G.AutoHarvestMode == "Selected Fruits" and not shouldHarvestSelectedFruit(plantFolder, fruitIndex, fruitFolder) then return false end
	if _G.AvoidAllMutation and isMutatedFruit(plantFolder, fruitIndex, fruitFolder) then return false end
	local attemptKey = plantFolder:GetFullName() .. "/" .. tostring(fruitIndex)
	if fruitHarvestBusy[attemptKey] then return false end
	local now = os.clock()
	if now - (fruitLastAttempt[attemptKey] or 0) < 0.1 then return false end
	fruitLastAttempt[attemptKey] = now
	fruitHarvestBusy[attemptKey] = true
	local position, prompt = getFruitTarget(plantFolder, fruitFolder)
	if not position then fruitHarvestBusy[attemptKey] = nil return false end

	teleportToPosition(position)
	task.wait(0.15)
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - position).Magnitude > 12 then fruitHarvestBusy[attemptKey] = nil return false end

	triggerFruitPrompt(prompt)
	task.wait(0.1)
	local fired = pcall(function()
		HarvestCropRemote:FireServer(plantFolder.Name, tostring(fruitIndex))
	end)
	fruitHarvestBusy[attemptKey] = nil
	return fired
end

local function collectHarvestQueue()
	local queue = {}
	local map = workspace:FindFirstChild("Map")
	local island = map and map:FindFirstChild("MainIsland")
	local gardens = island and island:FindFirstChild("PlayerGardens")
	local plots = gardens and gardens:FindFirstChild("Plots")
	if not plots then return queue end
	for _, plot in ipairs(plots:GetChildren()) do
		local plantedSeeds = plot:FindFirstChild("PlantedSeeds") or plot
		for _, plantFolder in ipairs(plantedSeeds:GetChildren()) do
			local fruitsFolder = plantFolder:FindFirstChild("Fruits")
			if fruitsFolder then
				for _, fruitFolder in ipairs(fruitsFolder:GetChildren()) do
					local isReady = isReadyFruit(plantFolder, fruitFolder.Name, fruitFolder)
					local isSelected = shouldHarvestSelectedFruit(plantFolder, fruitFolder.Name, fruitFolder)
					if isReady and (_G.AutoHarvestMode ~= "Selected Fruits" or isSelected) then
						table.insert(queue, {plantFolder, fruitFolder.Name, fruitFolder})
					end
				end
			end
		end
	end
	return queue
end


local function countSelectedMutationFruits()
	local count = 0
	local map = workspace:FindFirstChild("Map")
	local island = map and map:FindFirstChild("MainIsland")
	local gardens = island and island:FindFirstChild("PlayerGardens")
	local plots = gardens and gardens:FindFirstChild("Plots")
	if not plots then return 0 end
	for _, plot in ipairs(plots:GetChildren()) do
		local ownerId = plot:GetAttribute("OwnerUserId")
		if ownerId == LocalPlayer.UserId then
			local plantedSeeds = plot:FindFirstChild("PlantedSeeds") or plot
			for _, plant in ipairs(plantedSeeds:GetChildren()) do
				local sc = plant:FindFirstChild("ServerConfiguration")
				local fruits = sc and sc:FindFirstChild("Fruits")
				if fruits then
					for _, fruit in ipairs(fruits:GetChildren()) do
						local mut = fruit:FindFirstChild("Mutations")
						if mut and mut:IsA("StringValue") and mut.Value and mut.Value ~= "" then
							for _, part in ipairs(string.split(mut.Value, ",")) do
								local trimmed = string.gsub(part, "^%s*(.-)%s*$", "%1")
								if trimmed ~= "" then
									local display = CropMutationConfig.GetDisplayName(trimmed) or trimmed
									if _G.AutoHarvestMutations[display] then
										count += 1
									end
								end
							end
						end
					end
				end
			end
		end
	end
	return count
end

local function hasSelectedFruits()
	local map = workspace:FindFirstChild("Map")
	local island = map and map:FindFirstChild("MainIsland")
	local gardens = island and island:FindFirstChild("PlayerGardens")
	local plots = gardens and gardens:FindFirstChild("Plots")
	if not plots then return false end
	for _, plot in ipairs(plots:GetChildren()) do
		local plantedSeeds = plot:FindFirstChild("PlantedSeeds") or plot
		for _, plantFolder in ipairs(plantedSeeds:GetChildren()) do
			local fruitsFolder = plantFolder:FindFirstChild("Fruits")
			if fruitsFolder then
				for _, fruitFolder in ipairs(fruitsFolder:GetChildren()) do
					if shouldHarvestSelectedFruit(plantFolder, fruitFolder.Name, fruitFolder) then
						return true
					end
				end
			end
		end
	end
	return false
end

local function runAutoHarvest()
	if not _G.AutoHarvestRunning then return end
	if _G.AutoHarvestMode == "Mutation Select" and next(_G.AutoHarvestMutations) ~= nil then
		if countSelectedMutationFruits() == 0 then
			_G.AutoHarvestRunning = false
			addUiLog("🛑 Selected mutations have 0 fruits. Auto Harvest stopped.")
			return
		end
	end

	local queue = collectHarvestQueue()
	local harvestedAny = false
	for _, target in ipairs(queue) do
		if not _G.AutoHarvestRunning then break end
		if target[3] and target[3].Parent and shouldHarvest(target[1], target[2], target[3]) then
			harvestedAny = attemptFruitHarvest(target[1], target[2], target[3]) or harvestedAny
		end
	end

	if _G.AutoHarvestMode == "Selected Fruits" and not harvestedAny and not hasSelectedFruits() then
		_G.AutoHarvestRunning = false
		addUiLog("🔄 All selected fruits are done. Auto Harvest stopped.")
	end
end

