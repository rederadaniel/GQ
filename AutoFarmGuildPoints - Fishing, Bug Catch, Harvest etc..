local function applyConfigState(state)

	if not state then return end

	_G.AutoHarvestRunning = state.AutoHarvestRunning

	_G.AvoidMutationMode = state.AvoidMutationMode

	_G.AutoHarvestMutation1 = state.AutoHarvestMutation1

	_G.AutoHarvestMutation2 = state.AutoHarvestMutation2

