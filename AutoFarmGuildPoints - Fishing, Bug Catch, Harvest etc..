	local bugSearchBox = Instance.new("TextBox")
	bugSearchBox.Visible = true
	bugSearchBox.BackgroundColor3 = Colors.LOG_BG
	bugSearchBox.BorderSizePixel = 0
	bugSearchBox.Text = ""
	bugSearchBox.PlaceholderText = "Search fish/bug..."
	bugSearchBox.TextColor3 = Colors.TEXT
	bugSearchBox.PlaceholderColor3 = Colors.TEXT_MUTED
	bugSearchBox.Font = Enum.Font.GothamMedium
	bugSearchBox.TextSize = 12
	bugSearchBox.Size = UDim2.new(1, 0, 0, 28)
