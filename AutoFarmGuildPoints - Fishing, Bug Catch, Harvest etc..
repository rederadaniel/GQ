local function renderCatchLogs()

	if bugCatchLabel then

		local lines = {"Fish/Bug Catch Logs"}

		local combinedEntries = {}

		for _, entry in ipairs(fishCatchEntries) do

			table.insert(combinedEntries, {entry = entry, entryType = "Fish"})

		end

		for _, entry in ipairs(bugCatchEntries) do

			table.insert(combinedEntries, {entry = entry, entryType = "Bug"})

		end

		local sortMode = bugSortMode

		if sortMode == "Rarity" then

			table.sort(combinedEntries, function(a, b)

				local ra, rb = getRarityRank(a.entry.rarity), getRarityRank(b.entry.rarity)

				if ra == rb then return a.entry.time < b.entry.time end

				return ra < rb

			end)

		elseif sortMode == "Price" then

			table.sort(combinedEntries, function(a, b)

				if a.entry.price == b.entry.price then return a.entry.time < b.entry.time end

				return a.entry.price > b.entry.price

			end)

		else

			table.sort(combinedEntries, function(a, b) return a.entry.time > b.entry.time end)

		end

		for _, item in ipairs(combinedEntries) do

			local entry = item.entry

			if (catchFilterMode == "All" or item.entryType == catchFilterMode) and (bugSearchText == "" or string.find(string.lower(entry.name), string.lower(bugSearchText), 1, true)) then

				table.insert(lines, formatCatchEntry(item.entryType, entry))

			end

		end

		bugCatchLabel.Text = table.concat(lines, "\n")

	end

end


local function connectCatchEvent(pathParts, entryType)

	local node = ReplicatedStorage

	for _, part in ipairs(pathParts) do

		node = node:FindFirstChild(part)

		if not node then return end

	end

	if node:IsA("RemoteEvent") then

		node.OnClientEvent:Connect(function(result, payload)

			if result == "Win" and type(payload) == "table" then

				task.delay(0.5, function()

					addCatchLog(entryType or payload.type or "Catch", payload)

				end)

			end

		end)

	end

end


