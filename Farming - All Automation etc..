		HlBtnGrowthToggle.Text = S.growthTimeEnabled and "SHOW GROWTH TIME: ON" or "SHOW GROWTH TIME: OFF"
		if not S.growthTimeEnabled then
			S.clearAllHighlights()
		elseif S.highlightMode == "GROWTH ALL PLANTS" or S.highlightMode == "GROWTH ALL FRUITS" or S.highlightMode == "GROWTH SPECIFIC" then
			S.applyFruitHighlights()
		end
	end)
	local function toggleHighlightMode(mode, button, color, onActivated)
		if S.highlightMode == mode then
			resetHlButtons()
			S.highlightMode = "OFF"
			S.growthTimeEnabled = false
			HlBtnGrowthToggle.BackgroundColor3 = Color3.fromRGB(165, 60, 60)
			HlBtnGrowthToggle.Text = "SHOW GROWTH TIME: OFF"
			HlBtnOff.BackgroundColor3 = Color3.fromRGB(165, 60, 60)
			return
		end
		resetHlButtons()
		S.highlightMode = mode
		button.BackgroundColor3 = color
		if onActivated then onActivated() end
		S.applyFruitHighlights()
	end
