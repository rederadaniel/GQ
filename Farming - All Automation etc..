function S.applyActionHighlight(instance, textMsg, color, category, persist)
	if not instance then return end
	local enabled = true
	if category == "tool" then enabled = S.toolHighlightEnabled
	elseif category == "harvest" then enabled = S.harvestHighlightEnabled
	elseif category == "water" then enabled = S.waterHighlightEnabled
	end
	if not enabled then return end
	-- Reuse an existing highlight so auto loops never flicker or leak garbage.
	local hl = instance:FindFirstChild("ActionHighlight")
	if not hl then
		hl = Instance.new("Highlight")
		hl.Name = "ActionHighlight"
		hl.Parent = instance
	end
	hl.FillColor = color or Color3.fromRGB(175, 95, 85)
	hl.OutlineColor = Color3.fromRGB(200, 205, 210)
	hl.FillTransparency = 0.68
	hl.OutlineTransparency = 0
