	local function refreshLogDisplay(categoryName)
		-- Preserve the user's scroll position unless they were already at the bottom.
		local wasAtBottom = (S.LogScroll.AbsoluteCanvasSize.Y - S.LogScroll.CanvasPosition.Y) <= (S.LogScroll.AbsoluteWindowSize.Y + 4)
		for _, child in ipairs(S.LogScroll:GetChildren()) do
			if child:IsA("TextLabel") then child:Destroy() end
		end
		-- Collapse consecutive duplicate messages with a count (e.g. "(3x)")
		-- so the log stays compact even when the same event fires repeatedly.
		local entries = S.logEntries[categoryName]
		local i = 1
		while i <= #entries do
			local current = entries[i]
			local count = 1
			-- Strip the timestamp prefix to compare message bodies
			local function stripTs(s) return s:gsub("^%[%d%d:%d%d:%d%d%]%s*", "") end
			local base = stripTs(current)
			local j = i + 1
			while j <= #entries and stripTs(entries[j]) == base do
				count = count + 1
				j = j + 1
			end
			local displayText = current
			if count > 1 then
				displayText = current:gsub("(%[%d%d:%d%d:%d%d%])", "%1 (" .. count .. "x)")
			end
			local textLabel = Instance.new("TextLabel")
			textLabel.Size = UDim2.new(1, 0, 0, 0)
			textLabel.AutomaticSize = Enum.AutomaticSize.Y
			textLabel.BackgroundTransparency = 1
			textLabel.Text = displayText
			textLabel.TextColor3 = Color3.fromRGB(170, 200, 220)
			textLabel.TextSize = 11
			textLabel.Font = Enum.Font.Code
			textLabel.TextWrapped = true
			textLabel.TextXAlignment = Enum.TextXAlignment.Left
			textLabel.Parent = S.LogScroll
			i = j
		end
		if wasAtBottom then
			task.defer(function()
				if S.LogScroll and S.LogScroll.Parent then
					S.LogScroll.CanvasPosition = Vector2.new(0, S.LogScroll.AbsoluteCanvasSize.Y)
				end
			end)
		end
	end
