				if not plantCache or #plantCache == 0 or plantCacheMode ~= (S.plantMode .. "|" .. S.plantPattern) then
					plantCacheMode = S.plantMode .. "|" .. S.plantPattern
					rebuildPlantCache()
				end
				local planted = 0
