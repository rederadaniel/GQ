function S.createSpeedSlider(parent, yOff, labelText, minValue, maxValue, defaultValue, onValueChanged)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, -8, 0, 38)
	container.Position = UDim2.new(0, 4, 0, yOff)
	container.BackgroundTransparency = 1
	container.Parent = parent
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 14)
	label.Position = UDim2.new(0, 0, 0, 0)
	label.Text = labelText .. ": " .. tostring(defaultValue)
	label.TextColor3 = Color3.fromRGB(180, 185, 195)
	label.TextSize = 10
	label.Font = Enum.Font.SourceSansBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.BackgroundTransparency = 1
	label.Parent = container
	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, 0, 0, 8)
	track.Position = UDim2.new(0, 0, 0, 20)
	track.BackgroundColor3 = Color3.fromRGB(30, 32, 38)
	track.BorderSizePixel = 0
	track.Parent = container
	Instance.new("UICorner", track).CornerRadius = UDim.new(0.5, 0)
	local fill = Instance.new("Frame")
	local defaultPercent = (defaultValue - minValue) / (maxValue - minValue)
	fill.Size = UDim2.new(defaultPercent, 0, 1, 0)
	fill.Position = UDim2.new(0, 0, 0, 0)
	fill.BackgroundColor3 = Color3.fromRGB(0, 140, 200)
	fill.BorderSizePixel = 0
	fill.Parent = track
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0.5, 0)
	local handle = Instance.new("Frame")
	handle.Size = UDim2.new(0, 14, 0, 14)
	handle.Position = UDim2.new(defaultPercent, -7, 0.5, -7)
	handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	handle.BorderSizePixel = 0
	handle.ZIndex = 2
	handle.Parent = track
	Instance.new("UICorner", handle).CornerRadius = UDim.new(1, 0)
	local currentValue = defaultValue
	local dragging = false
	local function updateValue(value)
		currentValue = math.clamp(math.floor(value), minValue, maxValue)
		local percent = (currentValue - minValue) / (maxValue - minValue)
		fill.Size = UDim2.new(percent, 0, 1, 0)
		handle.Position = UDim2.new(percent, -7, 0.5, -7)
		label.Text = labelText .. ": " .. tostring(currentValue)
		if onValueChanged then onValueChanged(currentValue) end
	end
	local function startDrag(input)
		dragging = true
		local percent = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
		updateValue(minValue + math.clamp(percent, 0, 1) * (maxValue - minValue))
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			startDrag(input)
		end
	end)
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
		end
	end)
	S.UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local percent = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
			updateValue(minValue + math.clamp(percent, 0, 1) * (maxValue - minValue))
		end
	end)
	S.UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	return container, updateValue, function() return currentValue end
end
