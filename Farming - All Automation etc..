local _cmcCache = nil
function S.resolveMutationMultiplier(mutName)
	if not _cmcCache then
		local RS = game:GetService("ReplicatedStorage")
		local cmcPath = RS:FindFirstChild("Modules") and RS.Modules:FindFirstChild("PlantSystem")
		cmcPath = cmcPath and cmcPath:FindFirstChild("CropMutations")
		cmcPath = cmcPath and cmcPath:FindFirstChild("CropMutationConfig")
		if cmcPath then
			local ok, cmc = pcall(function() return require(cmcPath) end)
			if ok and type(cmc) == "table" then _cmcCache = cmc end
		end
	end
	local cmc = _cmcCache
	if cmc then
		if type(cmc.GetSellMultiplier) == "function" then
			local m = cmc.GetSellMultiplier(mutName)
			if m then return tostring(m) end
		end
		if type(cmc.GetDefinition) == "function" then
			local def = cmc.GetDefinition(mutName)
			if type(def) == "table" then
				local mult = def.SellMultiplier or def.Multiplier or 1
				return tostring(mult)
			end
		end
		if type(cmc.Definitions) == "table" then
			local key = string.lower(tostring(mutName or ""))
			for name, def in pairs(cmc.Definitions) do
				if type(def) == "table" and string.lower(tostring(name)) == key then
					local mult = def.SellMultiplier or def.Multiplier or 1
					return tostring(mult)
				end
			end
		end
	end
	return "1"
end
