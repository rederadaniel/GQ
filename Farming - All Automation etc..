	local function getItemList()
		local items = {}
		local seen = {}
		local RS = game:GetService("ReplicatedStorage")
		local IDC = RS:FindFirstChild("Modules") and RS.Modules:FindFirstChild("ItemDisplayDataCategories")
		if not IDC then return items end
		local function addItem(name, rarity, category, subCategory)
			local clean = cleanCropName(name)
			if clean == "" or seen[clean] then return end
			seen[clean] = true
			table.insert(items, {Name = clean, Rarity = tostring(rarity or "Common"), Category = category, SubCategory = subCategory})
		end
		-- HarvestedCrops (Fruits/Crops)
		local ok1, hc = pcall(function() return require(IDC:FindFirstChild("HarvestedCrops")) end)
		if ok1 and type(hc) == "table" then
			for name, cfg in pairs(hc) do
				if type(cfg) == "table" then addItem(name, cfg.Rarity, "Fruits/Crops") end
			end
		end
		-- Gear
		local ok2, gear = pcall(function() return require(IDC:FindFirstChild("Gear")) end)
		if ok2 and type(gear) == "table" then
			for name, cfg in pairs(gear) do
				if type(cfg) == "table" then addItem(name, cfg.Rarity, "Gear") end
			end
		end
		-- PetItems (part of Gear category)
		local ok3, petItems = pcall(function() return require(IDC:FindFirstChild("PetItems")) end)
		if ok3 and type(petItems) == "table" then
			for name, cfg in pairs(petItems) do
				if type(cfg) == "table" then addItem(name, cfg.Rarity, "Gear") end
			end
		end
		-- Pets
		local ok4, pets = pcall(function() return require(IDC:FindFirstChild("Pets")) end)
		if ok4 and type(pets) == "table" then
			for name, cfg in pairs(pets) do
				if type(cfg) == "table" then addItem(name, cfg.Rarity, "Pets") end
			end
		end
		-- PetEggs
		local ok5, petEggs = pcall(function() return require(IDC:FindFirstChild("PetEggs")) end)
		if ok5 and type(petEggs) == "table" then
			for name, cfg in pairs(petEggs) do
				if type(cfg) == "table" then addItem(name, cfg.Rarity, "Pets") end
			end
		end
		-- Eggs (Folder with Model children)
		local eggsFolder = RS:FindFirstChild("Eggs")
		if eggsFolder then
			for _, eggModel in ipairs(eggsFolder:GetChildren()) do
				if eggModel:IsA("Model") then
					addItem(eggModel.Name, "Common", "Pets")
				end
			end
		end
		-- Mounts (Pets category)
		local okMounts, mounts = pcall(function() return require(IDC:FindFirstChild("Mounts")) end)
		if okMounts and type(mounts) == "table" then
			for name, cfg in pairs(mounts) do
				if type(cfg) == "table" then addItem(name, cfg.Rarity or "Common", "Pets") end
			end
		end
		-- CaughtJunk (Critters)
		local ok6, junk = pcall(function() return require(IDC:FindFirstChild("CaughtJunk")) end)
		if ok6 and type(junk) == "table" then
			for name, cfg in pairs(junk) do
				if type(cfg) == "table" then addItem(name, cfg.Rarity, "Critters", "Junk") end
			end
		end
		-- CaughtFish (Critters)
		local ok7, fish = pcall(function() return require(IDC:FindFirstChild("CaughtFish")) end)
		if ok7 and type(fish) == "table" then
			for name, cfg in pairs(fish) do
				if type(cfg) == "table" then addItem(name, cfg.Rarity or "Common", "Critters", "Fish") end
			end
		end
		-- CaughtBugs (Critters)
		local ok8, bugs = pcall(function() return require(IDC:FindFirstChild("CaughtBugs")) end)
		if ok8 and type(bugs) == "table" then
			for name, cfg in pairs(bugs) do
				if type(cfg) == "table" then addItem(name, cfg.Rarity, "Critters", "Bug") end
			end
		end
		-- Seeds
		local okSeeds, seeds = pcall(function() return require(IDC:FindFirstChild("Seeds")) end)
		if okSeeds and type(seeds) == "table" then
			for name, cfg in pairs(seeds) do
				if type(cfg) == "table" then addItem(name, cfg.Rarity or "Common", "Seeds") end
			end
		end
		-- Ingredient (Food.IngredientData + ItemDisplayDataCategories.Ingredients)
		local foodMod = RS:FindFirstChild("Modules") and RS.Modules:FindFirstChild("Food")
		local ingDataMod = foodMod and foodMod:FindFirstChild("IngredientData")
		if ingDataMod then
			local okIng, ingData = pcall(function() return require(ingDataMod) end)
			if okIng and type(ingData) == "table" then
				for name, cfg in pairs(ingData) do
					if type(cfg) == "table" then addItem(name, cfg.Rarity or "Common", "Ingredient") end
				end
			end
		end
		local okIng2, ingCat = pcall(function() return require(IDC:FindFirstChild("Ingredients")) end)
		if okIng2 and type(ingCat) == "table" then
			for name, cfg in pairs(ingCat) do
				if type(cfg) == "table" then addItem(name, cfg.Rarity or "Common", "Ingredient") end
			end
		end
		-- Milk (Food.MilkConfig.Milks)
		local milkMod = foodMod and foodMod:FindFirstChild("MilkConfig")
		if milkMod then
			local okMilk, milkCfg = pcall(function() return require(milkMod) end)
			if okMilk and type(milkCfg) == "table" and type(milkCfg.Milks) == "table" then
				for name, cfg in pairs(milkCfg.Milks) do
					if type(cfg) == "table" then addItem(name, cfg.Rarity or "Common", "Milk") end
				end
			end
		end
		-- AdventureItems
		local ok9, adv = pcall(function() return require(IDC:FindFirstChild("AdventureItems")) end)
		if ok9 and type(adv) == "table" then
			for name, cfg in pairs(adv) do
				if type(cfg) == "table" then addItem(name, cfg.Rarity or "Common", "Adventure") end
			end
		end
		-- HatConfig (Hats sub-table, Adventure category)
		local hatsMod = RS:FindFirstChild("Modules") and RS.Modules:FindFirstChild("Hats")
		if hatsMod then
			local ok10, hatCfg = pcall(function() return require(hatsMod:FindFirstChild("HatConfig")) end)
			if ok10 and type(hatCfg) == "table" and type(hatCfg.Hats) == "table" then
				for name, cfg in pairs(hatCfg.Hats) do
					if type(cfg) == "table" then addItem(name, cfg.Rarity, "Adventure") end
				end
			end
		end
		-- Mounts (ItemDisplayDataCategories.Mounts) -> Pets category
		local ok15, mounts = pcall(function() return require(IDC:FindFirstChild("Mounts")) end)
		if ok15 and type(mounts) == "table" then
			for name, cfg in pairs(mounts) do
				if type(cfg) == "table" then addItem(name, cfg.Rarity or "Common", "Pets") end
			end
		end
		-- Mark Fruits/Crops items as Owned if planted in player's garden
		local ownedCrops = {}
		local ws = game:GetService("Workspace")
		local map = ws:FindFirstChild("Map")
		local mi = map and map:FindFirstChild("MainIsland")
		local pg = mi and mi:FindFirstChild("PlayerGardens")
		if pg then
			local plots = pg:FindFirstChild("Plots")
			if plots then
				for _, plot in ipairs(plots:GetChildren()) do
					local ps = plot:FindFirstChild("PlantedSeeds")
					if ps then
						for _, seed in ipairs(ps:GetChildren()) do
							local clean = cleanCropName(seed.Name)
							if clean ~= "" then ownedCrops[clean] = true end
						end
					end
				end
			end
		end
		for _, item in ipairs(items) do
			if item.Category == "Fruits/Crops" and ownedCrops[item.Name] then
				item.Owned = true
			end
		end
		-- Sort by rarity then name
		table.sort(items, function(a, b)
			local ra, rb = 0, 0
			for i, r in ipairs(RARITY_ORDER) do
				if a.Rarity == r then ra = i end
				if b.Rarity == r then rb = i end
			end
			if ra ~= rb then return ra < rb end
			return a.Name < b.Name
		end)
		return items
	end
