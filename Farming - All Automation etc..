-- Real-time FPS monitor: adjusts remote budget dynamically to prevent lag
S._fpsHeartbeatConn = S.RunService.Heartbeat:Connect(function()
	local now = os.clock()
	local dt = now - S._lastFrameTime
	S._lastFrameTime = now
	if dt > 0 and dt < 1 then
		local instantFps = 1 / dt
		S._currentFps = S._currentFps * 0.85 + instantFps * 0.15
	end
	-- Adaptive scaling: more remotes per frame at high FPS, fewer at low FPS
	if S._currentFps >= 55 then
		S._adaptiveRemotesPerFrame = 60
	elseif S._currentFps >= 40 then
		S._adaptiveRemotesPerFrame = 40
	elseif S._currentFps >= 25 then
		S._adaptiveRemotesPerFrame = 20
	else
		S._adaptiveRemotesPerFrame = 10
	end
end)
