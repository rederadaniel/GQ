function S.getTargetPlants()
	local matchedPlants = {}
	-- CUSTOM target mode with an empty/blank name must not act on anything.
	if S.targetMode == "CUSTOM" and (not S.customTargetName or S.customTargetName:gsub("%s", "") == "") then
		return matchedPlants
	end
	local query = S.getActiveTargetName():lower()
	local plots = S.Workspace:FindFirstChild("Map")
	if plots then plots = plots:FindFirstChild("MainIsland") end
	if plots then plots = plots:FindFirstChild("PlayerGardens") end
	if plots then plots = plots:FindFirstChild("Plots") end
	if not plots then return matchedPlants end
	for _, plot in ipairs(S.getOwnedPlots(true)) do
		local plantedSeeds = plot:FindFirstChild("PlantedSeeds")
		if plantedSeeds then
			for _, seed in ipairs(plantedSeeds:GetChildren()) do
				if not _G.FarmScriptRunning then break end
				if not S.RecentlyProcessedTool[seed] then
					local plantKey = seed:GetAttribute("PlantKey") or seed.Name
					local passesTarget = false
					if S.targetMode == "SELECTED IN CROP FILTER" then
						local cleanType = S.getCleanPlantType(plantKey)
						passesTarget = (S.cropFilterSelection and S.cropFilterSelection[cleanType] == true)
					else
						passesTarget = (query == "all" or query == "" or string.find(S.getPlantType(seed):lower(), query))
					end
					if passesTarget then
						-- SUPER FAST CHECK FOR FAVORITE / LOCKED / CAN HARVEST MODES
						local skipDueToLockOrFav = false
						local harvestConditionMet = false
						local serverConfig = seed:FindFirstChild("ServerConfiguration")
						local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
						if fruitsConfig then
							local fruits = fruitsConfig:GetChildren()
							if #fruits == 0 then
								if S.canHarvestMode == "FALSE" then harvestConditionMet = true end
							else
								for _, fruitCfg in ipairs(fruits) do
									local fav = fruitCfg:FindFirstChild("Favorited")
									local locked = fruitCfg:FindFirstChild("PermanentLocked")
									local isFav = (fav and fav.Value) or fruitCfg:GetAttribute("Favorited") == true
									local isLocked = (locked and locked.Value) or fruitCfg:GetAttribute("PermanentLocked") == true
									if isFav or isLocked then skipDueToLockOrFav = true break end
									local canHarvest = false
									local ch = fruitCfg:FindFirstChild("CanHarvest")
									if ch and ch:IsA("BoolValue") then
										canHarvest = ch.Value
									else
										local gp = fruitCfg:FindFirstChild("GrowthPercentage")
										canHarvest = (gp and typeof(gp.Value) == "number" and gp.Value >= 100)
									end
									if fruitCfg:IsA("ProximityPrompt") or fruitCfg:FindFirstChildWhichIsA("ProximityPrompt", true) then canHarvest = true end
									if S.canHarvestMode == "TRUE" and canHarvest then harvestConditionMet = true
									elseif S.canHarvestMode == "FALSE" and not canHarvest then harvestConditionMet = true end
								end
							end
						else
							if S.canHarvestMode == "FALSE" then harvestConditionMet = true end
						end
						if skipDueToLockOrFav then continue end 
						if not harvestConditionMet then continue end
						-- Fruit shoveling: only target plants that have at least one harvestable fruit
						if S.selectedMode == "Shovel" and S.shovelTargetType == "Fruit" then
							local hasHarvestableFruit = false
							local serverConfig = seed:FindFirstChild("ServerConfiguration")
							local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
							if fruitsConfig then
								for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
									local ch = fruitCfg:FindFirstChild("CanHarvest")
									local canHarvest = (ch and ch:IsA("BoolValue") and ch.Value) or (fruitCfg:FindFirstChild("GrowthPercentage") and typeof(fruitCfg.GrowthPercentage.Value) == "number" and fruitCfg.GrowthPercentage.Value >= 100)
									if canHarvest then hasHarvestableFruit = true break end
								end
							end
							if not hasHarvestableFruit then continue end
						end
						local skipDueToMutation = false
						if S.avoidAllMutations and S.plantHasMutations(seed) then skipDueToMutation = true end
						if not skipDueToMutation then table.insert(matchedPlants, {Instance = seed, PlantKey = plantKey, PlantType = S.getPlantType(seed)}) end
					end
				end
			end
		end
	end
	return matchedPlants
end
function S.getHarvestableFruits(targetNameFilter, modeFilter, isHarvestCall)
	local results = {}
	local query = (targetNameFilter or ""):lower()
	local isHighlightMode = modeFilter == "ALL FRUITS" or modeFilter == "SPECIFIC NAME" or modeFilter == "ALL MUT" or modeFilter == "SPECIFIC" or modeFilter == "IN MUTATION FILTER" or modeFilter == "ALL PLANTS"
	local plots = S.Workspace:FindFirstChild("Map")
	if plots then plots = plots:FindFirstChild("MainIsland") end
	if plots then plots = plots:FindFirstChild("PlayerGardens") end
	if plots then plots = plots:FindFirstChild("Plots") end
	if not plots then return results end
	local gardenMutationCounts, specificFruitMutationCounts = {}, {}
	local noMutationCount, hasMutationCount = 0, 0
	for _, plot in ipairs(S.getOwnedPlots(true)) do
		local plantedSeeds = plot:FindFirstChild("PlantedSeeds")
		if plantedSeeds then
			for _, seed in ipairs(plantedSeeds:GetChildren()) do
				local plantKey = seed:GetAttribute("PlantKey") or seed.Name
				local serverConfig = seed:FindFirstChild("ServerConfiguration")
				local seedMutationsFolder = serverConfig and serverConfig:FindFirstChild("Mutations")
				local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
				local seedHasMutFilter, seedMutText, seedMutList = S.checkMutationMatch(seedMutationsFolder, S.hlMutationValueText)
				local anySeedMutFound, anySeedMutText, allSeedMuts = S.checkMutationMatch(seedMutationsFolder, "")
				if fruitsConfig then
					for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
						-- HARVEST CONDITIONS AND FRUIT CHECKS
						local canHarvest = false
						local ch = fruitCfg:FindFirstChild("CanHarvest")
						if ch and ch:IsA("BoolValue") then
							canHarvest = ch.Value
						else
							local gp = fruitCfg:FindFirstChild("GrowthPercentage")
							canHarvest = (gp and typeof(gp.Value) == "number" and gp.Value >= 100)
						end
						local prompt = nil
						if fruitCfg:IsA("ProximityPrompt") then
							prompt = fruitCfg
							canHarvest = true
						else
							prompt = fruitCfg:FindFirstChildWhichIsA("ProximityPrompt", true)
							if prompt then canHarvest = true end
						end
						-- CAN HARVEST DYNAMIC FILTER
						local passesHarvestFilter = false
						if S.canHarvestMode == "TRUE" and canHarvest then passesHarvestFilter = true
						elseif S.canHarvestMode == "FALSE" and not canHarvest then passesHarvestFilter = true
						end
						local fav = fruitCfg:FindFirstChild("Favorited")
						local locked = fruitCfg:FindFirstChild("PermanentLocked")
						local isFav = (fav and fav.Value) or fruitCfg:GetAttribute("Favorited") == true
						local isLocked = (locked and locked.Value) or fruitCfg:GetAttribute("PermanentLocked") == true
						local fruitMutationsFolder = fruitCfg:FindFirstChild("Mutations")
						local fruitHasMutFilter, fruitMutText, fruitMutList = S.checkMutationMatch(fruitMutationsFolder, S.hlMutationValueText)
						local anyFruitMutFound, anyFruitMutText, allFruitMuts = S.checkMutationMatch(fruitMutationsFolder, "")
						local combinedMuts = {}
						for _, m in ipairs(allSeedMuts) do table.insert(combinedMuts, m) end
						for _, m in ipairs(allFruitMuts) do table.insert(combinedMuts, m) end
						local anyMutFound = anySeedMutFound or anyFruitMutFound
						if anyMutFound or #combinedMuts > 0 then hasMutationCount = hasMutationCount + 1 else noMutationCount = noMutationCount + 1 end
						for _, mutName in ipairs(combinedMuts) do
							gardenMutationCounts[mutName] = (gardenMutationCounts[mutName] or 0) + 1
							local targetFruitCheck = ""
							if modeFilter == "SPECIFIC" then
								targetFruitCheck = S.hlMutFruitNameText
							elseif modeFilter == "SPECIFIC NAME" or modeFilter == "SPECIFIC MUT" then
								targetFruitCheck = query 
								if modeFilter == "SPECIFIC NAME" and S.hlSpecificFruitName ~= "" then targetFruitCheck = S.hlSpecificFruitName end
							end
							if targetFruitCheck ~= "" and string.find(S.getPlantType(seed):lower(), targetFruitCheck:lower()) ~= nil then
								local targetMutCheck = S.hlMutationValueText:lower():gsub("%s+", "")
								local mutClean = mutName:lower():gsub("%s+", "")
								if targetMutCheck == "" or string.find(mutClean, targetMutCheck) then specificFruitMutationCounts[mutName] = (specificFruitMutationCounts[mutName] or 0) + 1 end
							end
						end
						local foundMutationLabel = (fruitMutText ~= "" and fruitMutText) or (seedMutText ~= "" and seedMutText) or anyFruitMutText or anySeedMutText
						local isMatch = false
						if modeFilter == "HARVEST ALL FRUITS" or modeFilter == "ALL FRUITS" then isMatch = true
						elseif modeFilter == "SPECIFIC NAME" then
							local specFilter = (not isHarvestCall and S.hlSpecificFruitName ~= "" and S.hlSpecificFruitName) or query
							if specFilter ~= "" then
								local normalizedFilter = specFilter:lower()
								isMatch = string.find(plantKey:lower(), normalizedFilter, 1, true) ~= nil or string.find(S.getFruitDisplayName(fruitCfg):lower(), normalizedFilter, 1, true) ~= nil
							end
						elseif modeFilter == "SPECIFIC MUT" then
							local mutFilter = S.harvestTargetMutName or ""
							if mutFilter ~= "" then
								local hasTargetMut, _, _ = S.checkMutationMatch(seedMutationsFolder, mutFilter)
								local fruitHasTargetMut, _, _ = S.checkMutationMatch(fruitMutationsFolder, mutFilter)
								isMatch = hasTargetMut or fruitHasTargetMut
							end
						elseif modeFilter == "ALL MUT" then
							isMatch = seedHasMutFilter or fruitHasMutFilter or (S.hlMutationValueText == "" and anyMutFound)
						elseif modeFilter == "SPECIFIC" then
							local fruitNameMatch = (S.hlMutFruitNameText == "" or string.find(plantKey:lower(), S.hlMutFruitNameText:lower()) ~= nil)
							local mutMatch = (S.hlMutationValueText == "" and anyMutFound) or (seedHasMutFilter or fruitHasMutFilter)
							isMatch = fruitNameMatch and mutMatch
						elseif modeFilter == "SELECTED IN CROP FILTER" then
							local cleanType = S.getCleanPlantType(plantKey)
							isMatch = (S.cropFilterSelection and S.cropFilterSelection[cleanType] == true)
						elseif modeFilter == "IN MUTATION FILTER" then
							local hasSelectedMut = false
							for _, mutName in ipairs(combinedMuts) do
								if S.mutationFilterSelection[mutName] then hasSelectedMut = true break end
							end
							isMatch = hasSelectedMut
						end
						local isAvoided = S.isMutationAvoided(combinedMuts)
						local physicalFruit = nil
						local fruitsFolder = seed:FindFirstChild("Fruits")
						if fruitsFolder then
							local fruitFolder = fruitsFolder:FindFirstChild(fruitCfg.Name)
							if fruitFolder then physicalFruit = fruitFolder:FindFirstChild("Fruit") or fruitFolder end
							if not physicalFruit and modeFilter == "ALL FRUITS" then
								for _, candidate in ipairs(fruitsFolder:GetChildren()) do
									local candidateFruit = candidate:FindFirstChild("Fruit") or candidate
									if candidateFruit:IsA("Model") or candidateFruit:IsA("BasePart") then
										physicalFruit = candidateFruit
										break
									end
								end
							end
						end
						local uniqueTargetKey = tostring(seed) .. "_" .. tostring(fruitCfg.Name)
						local isRecentlyProcessed = S.RecentlyProcessedHarvest[uniqueTargetKey]
						if isMatch and (not isHarvestCall or passesHarvestFilter) and (not isHarvestCall or (not isFav and not isLocked and not isAvoided and not isRecentlyProcessed)) then
							table.insert(results, {UniqueKey = uniqueTargetKey, PlantKey = plantKey, PlantName = seed.Name, FruitNumber = fruitCfg.Name, FruitName = S.getFruitDisplayName(fruitCfg), PhysicalInstance = physicalFruit, SeedInstance = seed, HasMutation = anyMutFound or (foundMutationLabel ~= ""), MutationNameText = foundMutationLabel, AllMutations = combinedMuts})
						end
					end
				end
			end
		end
	end
	results.GardenMutationCounts = gardenMutationCounts
	results.SpecificFruitMutationCounts = specificFruitMutationCounts
	results.NoMutationCount = noMutationCount
	results.HasMutationCount = hasMutationCount
	return results
end
function S.getCleanPlantType(plantName)
	return tostring(plantName or "Unknown"):gsub(":%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x", ""):gsub(":.*$", "")
end
function S.getPlantType(seed)
	return tostring(seed and (seed:GetAttribute("PlantType") or seed:GetAttribute("PlantName") or seed.Name) or "Unknown")
end
function S.logMutationSummary(mutationCounts, plantName)
	local plantType = S.getCleanPlantType(plantName)
	for mutationText, count in pairs(mutationCounts or {}) do
		S.addUiLog(string.format("-> %dx %s PlantType %s", count, tostring(mutationText), plantType))
	end
end
function S.logMutationReportOnce(reportKey, lines)
	if not lines or #lines == 0 then return end
	local signature = reportKey .. "|" .. table.concat(lines, "\n")
	if signature == S.lastMutationReportSignature then return end
	S.lastMutationReportSignature = signature
	for _, line in ipairs(lines) do S.addUiLog(line) end
end
function S.getGrowthNumber(instance, name)
	if not instance then return nil end
	local attributeValue = instance:GetAttribute(name)
	if typeof(attributeValue) == "number" then return attributeValue end
	local valueObject = instance:FindFirstChild(name)
	if valueObject and valueObject:IsA("ValueBase") and typeof(valueObject.Value) == "number" then
		return valueObject.Value
	end
	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant.Name == name and descendant:IsA("ValueBase") and typeof(descendant.Value) == "number" then
			return descendant.Value
		end
	end
	return nil
end
function S.getGrowthText(instance)
	return nil
end
function S.growthNameMatches(seed, fruitCfg, filterName)
	if filterName == "" then return true end
	local query = filterName:lower()
	local plantName = tostring(seed:GetAttribute("PlantKey") or seed.Name):lower()
	local fruitName = fruitCfg and S.getFruitDisplayName(fruitCfg):lower() or ""
	local fruitKey = fruitCfg and tostring(fruitCfg.Name):lower() or ""
	return string.find(plantName, query, 1, true) ~= nil or string.find(fruitName, query, 1, true) ~= nil or string.find(fruitKey, query, 1, true) ~= nil
end
function S.applyGrowthTimeHighlights(mode, filterName)
	local count = 0
	local report = {}
	local function reportGrowth(name, growthText)
		table.insert(report, name .. " | " .. growthText)
	end
	for _, plot in ipairs(S.getOwnedPlots()) do
		local planted = plot:FindFirstChild("PlantedSeeds")
		if planted then
			for _, seed in ipairs(planted:GetChildren()) do
				local seedGrowthText = S.getGrowthText(seed)
				if mode == "GROWTH ALL PLANTS" and seedGrowthText then
					if S.createFruitHighlight(seed, string.format("%s: %s", S.getPlantType(seed), seedGrowthText), Color3.fromRGB(80, 115, 170)) then count += 1 end
					reportGrowth(tostring(seed:GetAttribute("PlantKey") or seed.Name), seedGrowthText)
				end
				local serverConfig = seed:FindFirstChild("ServerConfiguration")
				local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
				if fruitsConfig and mode ~= "GROWTH ALL PLANTS" then
					for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
						if S.growthNameMatches(seed, fruitCfg, filterName) then
							local growthText = S.getGrowthText(fruitCfg)
							local physicalFruit = S.getPhysicalFruit(seed, fruitCfg)
							if growthText and physicalFruit and (physicalFruit:IsA("Model") or physicalFruit:IsA("BasePart")) then
								local fruitName = S.getFruitDisplayName(fruitCfg)
								local label = string.format("%s FRUIT: %s", fruitName, growthText)
								if S.createFruitHighlight(physicalFruit, label, Color3.fromRGB(185, 155, 75)) then count += 1 end
								reportGrowth(fruitName, growthText)
							end
						end
					end
				end
			end
		end
	end
	S.connectFruitHighlightRefresh()
	for _, line in ipairs(report) do S.addUiLog(line) end
end
S.applyFruitHighlights = function()
	if S.highlightMode == "OFF" then
		S.clearAllHighlights()
		return
	end
	S.clearAllHighlights()
	if S.highlightMode == "ALL PLANTS" then
		local plantCount = 0
		for _, plot in ipairs(S.getOwnedPlots(true)) do
			local plantedSeeds = plot:FindFirstChild("PlantedSeeds")
			if plantedSeeds then
				for _, seed in ipairs(plantedSeeds:GetChildren()) do
					if seed:IsA("Model") or seed:IsA("BasePart") then
						local plantType = S.getPlantType(seed)
						local label = "🌱 " .. plantType
						S.createFruitHighlight(seed, label, Color3.fromRGB(50, 170, 120))
						plantCount += 1
					end
				end
			end
		end
		S.connectFruitHighlightRefresh()
		S.addUiLog(string.format("ALL PLANTS highlighted: %d", plantCount))
		return
	end
	if false then
		local filterName = S.highlightMode == "FRUIT PCT SPEC" and S.hlPctSpecificName or ""
		local count = 0
		for _, plot in ipairs(S.getOwnedPlots()) do
			local planted = plot:FindFirstChild("PlantedSeeds")
			if planted then
				for _, seed in ipairs(planted:GetChildren()) do
					local serverConfig = seed:FindFirstChild("ServerConfiguration")
					local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
					local physicalFruits = seed:FindFirstChild("Fruits")
					if fruitsConfig and physicalFruits then
						local plantKey = tostring(seed:GetAttribute("PlantKey") or seed.Name):lower()
						for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
							local fruitName = S.getFruitDisplayName(fruitCfg)
							local fruitKey = tostring(fruitCfg.Name):lower()
							local nameMatch = filterName == "" or string.find(plantKey, filterName, 1, true) ~= nil or string.find(fruitName:lower(), filterName, 1, true) ~= nil or string.find(fruitKey, filterName, 1, true) ~= nil
							if nameMatch then
								local physicalFruit = S.getPhysicalFruit(seed, fruitCfg)
								if physicalFruit and (physicalFruit:IsA("Model") or physicalFruit:IsA("BasePart")) then
									local gp = fruitCfg:FindFirstChild("GrowthPercentage")
									local pct = gp and typeof(gp.Value) == "number" and math.floor(math.clamp(gp.Value, 0, 100)) or 0
									local ch = fruitCfg:FindFirstChild("CanHarvest")
									if ch and ch:IsA("BoolValue") and ch.Value then pct = 100 end
									local label = string.format("Fruit %s: 📊%d%%📊", tostring(fruitCfg.Name), pct)
									if S.createFruitHighlight(physicalFruit, label, Color3.fromRGB(50, 170, 120)) then
										count += 1
									end
								end
							end
						end
					end
				end
			end
		end
		S.connectFruitHighlightRefresh()
		S.addUiLog(string.format("ALL FRUITS highlighted: %d", count))
		return
	end
	local targetFruits = S.getHarvestableFruits(S.harvestTargetName, S.highlightMode, false)
	local allMutCounts = targetFruits.GardenMutationCounts or {}
	local specificMutCounts = targetFruits.SpecificFruitMutationCounts or {}
	for _, fruitData in ipairs(targetFruits) do
		if S.highlightMode == "SELECTED IN CROP FILTER" then
			if S.highlightFilterSub == "FRUITS" and fruitData.HasMutation then continue end
			if S.highlightFilterSub == "MUTATIONS" and not fruitData.HasMutation then continue end
		end
		local targetObj = fruitData.PhysicalInstance or fruitData.SeedInstance
		if targetObj and (targetObj:IsA("Model") or targetObj:IsA("BasePart")) then
			local mutTag = (fruitData.MutationNameText ~= "") and ("[" .. fruitData.MutationNameText .. "] ") or ""
			local label = mutTag .. S.getPlantType(fruitData.SeedInstance) .. " F" .. tostring(fruitData.FruitNumber)
			local color = fruitData.HasMutation and Color3.fromRGB(185, 110, 70) or Color3.fromRGB(50, 170, 120)
			S.createFruitHighlight(targetObj, label, color)
		end
	end
	S.connectFruitHighlightRefresh()
	if S.highlightMode == "ALL FRUITS" then
		local noMut = targetFruits.NoMutationCount or 0
		local hasMut = targetFruits.HasMutationCount or 0
		S.addUiLog(string.format("ALL FRUITS highlighted: %d", noMut + hasMut))
		S.addUiLog(string.format("No Mutation Fruit -> %d", noMut))
		S.addUiLog(string.format("With Mutation Fruit -> %d", hasMut))
	elseif S.highlightMode == "ALL MUT" then
		if next(allMutCounts) ~= nil then
			local total = 0
			local report = {}
			for mutationName, count in pairs(allMutCounts) do
				table.insert(report, string.format("-> %dx %s PlantType Garden", count, tostring(mutationName)))
				total += count
			end
			table.insert(report, string.format("TOTAL MUTATION IN YOUR GARDEN FRUITS IS = %dx", total))
			S.logMutationReportOnce("ALL MUT", report)
		else
			S.addUiLog("❌ No mutation found for '" .. (S.hlMutationValueText ~= "" and S.hlMutationValueText or "Any") .. "'")
		end
	elseif S.highlightMode == "SPECIFIC" then
		if next(specificMutCounts) ~= nil then
			local total = 0
			local report = {}
			for mutationName, count in pairs(specificMutCounts) do
				table.insert(report, string.format("-> %dx %s PlantType %s", count, tostring(mutationName), S.getCleanPlantType(S.hlMutFruitNameText)))
				total += count
			end
			table.insert(report, string.format("TOTAL MUTATION IN YOUR GARDEN FRUITS IS = %dx", total))
			S.logMutationReportOnce("SPECIFIC", report)
		else
			S.addUiLog("❌ No mutation found for specific name -> " .. (S.hlMutFruitNameText ~= "" and S.hlMutFruitNameText or "Unknown") .. ".")
		end
	elseif S.highlightMode == "SPECIFIC NAME" then
		if next(specificMutCounts) ~= nil then
			for mutName, count in pairs(specificMutCounts) do S.addUiLog(string.format("%s %dx", mutName, count)) end
		end
	elseif S.highlightMode == "IN MUTATION FILTER" then
		local total = #targetFruits
		S.addUiLog(string.format("IN MUTATION FILTER highlighted: %d fruits", total))
	end
end
function S.teleportToInstance(targetInst)
	if not targetInst then return end
	local character = S.LocalPlayer.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	if targetInst:IsA("Model") then
		local cf, _ = targetInst:GetBoundingBox()
		hrp.CFrame = cf + Vector3.new(0, 3, 0)
	elseif targetInst:IsA("BasePart") then
		hrp.CFrame = targetInst.CFrame + Vector3.new(0, 3, 0)
