					if name == "All" or name == "Exist" then
						active = (name == selectedType and selectedRarity == nil)
					else
						active = (name == selectedRarity)
					end
					b.BackgroundColor3 = active and Color3.fromRGB(0, 140, 200) or Color3.fromRGB(28, 32, 42)
				end
				refresh()
			end)
		end
		refresh()
		-- Auto-refresh crop counts in background (updates cached plant/fruit totals)
		task.spawn(function()
			while frame.Parent do
				local totalPlanted = 0
				local totalFruits = 0
				for _, crop in ipairs(getCropList()) do
					if crop.PlantedCount and crop.PlantedCount > 0 then
						totalPlanted = totalPlanted + crop.PlantedCount
					end
					if crop.FruitCount and crop.FruitCount > 0 then
						totalFruits = totalFruits + crop.FruitCount
					end
				end
				local changed = (totalPlanted ~= cachedPlanted or totalFruits ~= cachedFruits)
				cachedPlanted = totalPlanted
				cachedFruits = totalFruits
				updateCropCount()
				if changed then refresh() end
				task.wait(0.5)
			end
		end)
		return frame
	end
