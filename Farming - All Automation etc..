	local function refreshLogDisplay(categoryName)
		-- Preserve the user's scroll position unless they were already at the bottom.
		local wasAtBottom = (S.LogScroll.AbsoluteCanvasSize.Y - S.LogScroll.CanvasPosition.Y) <= (S.LogScroll.AbsoluteWindowSize.Y + 4)
		for _, child in ipairs(S.LogScroll:GetChildren()) do
			if child:IsA("TextLabel") then child:Destroy() end
		end
		S.lastLogMessage = "" S.lastLogLabel = nil S.lastLogCount = 1
		for _, entry in ipairs(S.logEntries[categoryName]) do
			local textLabel = Instance.new("TextLabel")
			textLabel.Size = UDim2.new(1, 0, 0, 0)
			textLabel.AutomaticSize = Enum.AutomaticSize.Y
			textLabel.BackgroundTransparency = 1
			textLabel.Text = entry
			textLabel.TextColor3 = Color3.fromRGB(170, 200, 220)
			textLabel.TextSize = 11
			textLabel.Font = Enum.Font.Code
			textLabel.TextWrapped = true
			textLabel.TextXAlignment = Enum.TextXAlignment.Left
			textLabel.Parent = S.LogScroll
		end
		if wasAtBottom then
			S.LogScroll.CanvasPosition = Vector2.new(0, S.LogScroll.AbsoluteCanvasSize.Y)
		end
	end
	local function createLogCategoryButton(categoryKey, labelText, scaleX, scaleW)
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(scaleW, -4, 1, 0)
		button.Position = UDim2.new(scaleX, 0, 0, 0)
		button.BackgroundColor3 = Color3.fromRGB(28, 32, 42)
