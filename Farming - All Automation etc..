function S.buildFarmingShell(parentPage)
	if not parentPage then return end
	S.AutoFarmMainFrame = Instance.new("Frame")
	-- ===== REUSABLE CROP FILTER PANEL =====
	local RARITY_ORDER = {"All", "Ethereal", "Mythical", "Legendary", "Epic", "Rare", "Uncommon", "Common"}
	local function cleanCropName(name)
		return tostring(name or ""):gsub(":%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x", "")
	end
	local function getCropList()
		local crops = {}
		local seen = {}
		local owned = {}
		local ok, hc = pcall(function()
			return require(game:GetService("ReplicatedStorage").Modules.ItemDisplayDataCategories.HarvestedCrops)
		end)
		if ok and type(hc) == "table" then
			for name, cfg in pairs(hc) do
				if type(cfg) == "table" then
					local clean = cleanCropName(name)
					if not seen[clean] then
						seen[clean] = true
						table.insert(crops, {Name = clean, Rarity = tostring(cfg.Rarity or "Common"), Owned = false})
					end
				end
			end
		end
		local plantedCounts = {}
		local fruitCounts = {}
		for _, plot in ipairs(S.getOwnedPlots(true)) do
			local ps = plot:FindFirstChild("PlantedSeeds")
			if ps then
				for _, seed in ipairs(ps:GetChildren()) do
					local clean = cleanCropName(seed.Name)
					if clean ~= "" then
						owned[clean] = true
						plantedCounts[clean] = (plantedCounts[clean] or 0) + 1
						local sc = seed:FindFirstChild("ServerConfiguration")
						local fc = sc and sc:FindFirstChild("Fruits")
						if fc then
							for _, fruitCfg in ipairs(fc:GetChildren()) do
								local canHarvest = false
								local ch = fruitCfg:FindFirstChild("CanHarvest")
								if ch and ch:IsA("BoolValue") then
									canHarvest = ch.Value
								else
									local gp = fruitCfg:FindFirstChild("GrowthPercentage")
									canHarvest = (gp and typeof(gp.Value) == "number" and gp.Value >= 100)
								end
								if canHarvest then
									fruitCounts[clean] = (fruitCounts[clean] or 0) + 1
								end
							end
						end
						if not seen[clean] then
							seen[clean] = true
							table.insert(crops, {Name = clean, Rarity = "Common", Owned = true})
						end
					end
				end
			end
		end
		for _, crop in ipairs(crops) do
			if owned[crop.Name] then crop.Owned = true end
			crop.PlantedCount = plantedCounts[crop.Name] or 0
			crop.FruitCount = fruitCounts[crop.Name] or 0
		end
		table.sort(crops, function(a, b)
			local ra, rb = 0, 0
			for i, r in ipairs(RARITY_ORDER) do
				if a.Rarity == r then ra = i end
				if b.Rarity == r then rb = i end
			end
			if ra ~= rb then return ra < rb end
			return a.Name < b.Name
		end)
		return crops
	end
