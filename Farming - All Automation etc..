function S.getDelayInSeconds()
	local val = tonumber(S.rawSpeedInput)
	if not val or val <= 0 then return S.MAX_AUTOMATION_DELAY end
	return math.max(val / math.clamp(S.automationSpeedMultiplier, 1, 1000), S.MAX_AUTOMATION_DELAY)
end
function S.getHarvestDelayInSeconds()
	local val = tonumber(S.harvestSpeedInput)
	if not val or val <= 0 then return S.MAX_AUTOMATION_DELAY end
	return math.max(val / math.clamp(S.automationSpeedMultiplier, 1, 1000), S.MAX_AUTOMATION_DELAY)
end
function S.getAutomationDelay(value, fallback)
	local delay = tonumber(value)
	if not delay or delay <= 0 then delay = fallback end
	return math.max(delay / math.clamp(S.automationSpeedMultiplier, 1, 1000), S.MAX_AUTOMATION_DELAY)
end
-- ==========================================
-- HEARTBEAT FRAME PACING (super smooth, no lag)
-- ==========================================
-- Cap how many redundant remotes we fire per action. The server only needs a
-- few to register a harvest/use; firing 1000 floods it and causes lag.
S.MAX_ACTION_REMOTES = 100
-- Max remotes fired per rendered frame before yielding to the next frame.
S.REMOTES_PER_FRAME = 80
S._remoteBudget = 0
function S.paceRemotes()
	S._remoteBudget += 1
	if S._remoteBudget >= S.REMOTES_PER_FRAME then
		S._remoteBudget = 0
		S.RunService.Heartbeat:Wait()
	end
end
function S.fireRemoteBatch(remote, payload, amount, secondPayload, cap)
	if not remote then return end
	local total = math.max(1, math.floor(tonumber(amount) or 1))
	-- Cap redundant bursts so the server isn't flooded and the client stays smooth.
	total = math.min(total, cap or S.MAX_ACTION_REMOTES)
	for index = 1, total do
		if secondPayload == nil then
			remote:FireServer(payload)
		else
			remote:FireServer(payload, secondPayload)
		end
		-- Heartbeat pacing: yield to the next rendered frame every
		-- REMOTES_PER_FRAME remotes so the render thread never blocks.
		S.paceRemotes()
	end
end
function S.firePlantRemote(remote, payload, interval)
	if not remote then return false end
	local ok = pcall(function()
		remote:FireServer(payload)
	end)
	S.paceRemotes()
	local delay = interval or S.PLANT_REMOTE_INTERVAL
	if delay and delay > 0 then task.wait(delay) end
	return ok
end
function S.getPlotFolder()
	local map = S.Workspace:FindFirstChild("Map")
	local island = map and map:FindFirstChild("MainIsland")
	local gardens = island and island:FindFirstChild("PlayerGardens")
	return gardens and gardens:FindFirstChild("Plots")
end
function S.isOwnedPlot(plot)
	if not plot then return false end
	local ownerUserId = plot:GetAttribute("OwnerUserId") or plot:GetAttribute("Owner")
	if typeof(ownerUserId) == "number" then return ownerUserId == S.LocalPlayer.UserId end
	if ownerUserId ~= nil then return tostring(ownerUserId) == tostring(S.LocalPlayer.UserId) or tostring(ownerUserId) == S.LocalPlayer.Name end
	local ownerValue = plot:FindFirstChild("OwnerUserId") or plot:FindFirstChild("Owner")
	if ownerValue and ownerValue:IsA("ValueBase") then
		return tostring(ownerValue.Value) == tostring(S.LocalPlayer.UserId) or tostring(ownerValue.Value) == S.LocalPlayer.Name
	end
	return false
end
function S.getOwnedPlots(ignoreDistance)
	local owned = {}
	local plots = S.getPlotFolder()
	if not plots then return owned end
	local root = S.LocalPlayer.Character and S.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	for _, plot in ipairs(plots:GetChildren()) do
		if S.isOwnedPlot(plot) then
			local position = plot:GetPivot().Position
			if ignoreDistance or not root or (position - root.Position).Magnitude <= S.plotRenderRadius then
				table.insert(owned, plot)
			end
		end
	end
	return owned
end
function S.getCropPercent(crop)
	local serverConfig = crop:FindFirstChild("ServerConfiguration")
	if serverConfig then
		local canHarvest = serverConfig:FindFirstChild("CanHarvest")
		if canHarvest and canHarvest:IsA("BoolValue") and canHarvest.Value then return 100 end
		local gp = serverConfig:FindFirstChild("GrowthPercentage")
		if gp and typeof(gp.Value) == "number" then return math.clamp(gp.Value, 0, 100) end
	end
	local canHarvestDirect = crop:FindFirstChild("CanHarvest")
	if canHarvestDirect and canHarvestDirect:IsA("BoolValue") and canHarvestDirect.Value then return 100 end
	for _, name in ipairs({"GrowthPercentage", "GrowthPercent", "Percent", "Progress"}) do
		local value = crop:GetAttribute(name) or (crop:FindFirstChild(name) and crop[name].Value)
		if typeof(value) == "number" then return math.clamp(value, 0, 100) end
	end
	return 0
end
