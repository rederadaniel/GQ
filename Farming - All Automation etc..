		if msg:find("Max crops") or msg:find("max crops") then S.maxCropsReached = true end
		if S.autoStopOnMaxPlants and (msg:find("Max plants") or msg:find("max plants")) then S.maxPlantsReached = true end
		local prefix = S.logFormatPrefix[category] or "Live Output Logs -> "
		local displayMessage = S.formatPlantTypeLogMessage(msg)
		local timestamp = os.date("%H:%M:%S")
		local formatted = string.format("[%s] %s%s", timestamp, prefix, displayMessage)
		table.insert(S.logEntries[category], formatted)
		if #S.logEntries[category] > S.MAX_LOG_ENTRIES then table.remove(S.logEntries[category], 1) end
		if not S.activeLogsEnabled or category ~= S.logCategory then return end
		if S.lowFpsMode then return end
		if displayMessage == S.lastLogMessage and S.lastLogLabel and S.lastLogLabel.Parent then
			S.lastLogCount = S.lastLogCount + 1
			S.lastLogLabel.Text = string.format("[%s] %s%s (%dx)", timestamp, prefix, displayMessage, S.lastLogCount)
		else
			S.lastLogMessage = displayMessage
