					local hrp = character and character:FindFirstChild("HumanoidRootPart")
					local map = S.Workspace:FindFirstChild("Map")
					local island = map and map:FindFirstChild("MainIsland")
					local gardens = island and island:FindFirstChild("PlayerGardens")
					local plots = gardens and gardens:FindFirstChild("Plots")
					local plot1 = plots and plots:FindFirstChild("Plot1")
					local invisibleFloor = plot1 and plot1:FindFirstChild("InvisibleFloor")
					if hrp and invisibleFloor and invisibleFloor:IsA("BasePart") then
						local waterArgs = {
							{
								TargetPosition = hrp.Position - Vector3.new(0, 3, 0),
								Action = "Water",
								TargetInstance = invisibleFloor,
								Material = "Plastic",
								InputMode = "WorldPoint",
								TargetNormal = Vector3.new(50, 50, 50),
							}
						}
						S.UseEquippedTool:FireServer(unpack(waterArgs))
					end
					task.wait(0.05)
				else
					local plots = S.getOwnedPlots(true)
					for _, plot in ipairs(plots) do
						local planted = plot:FindFirstChild("PlantedSeeds")
						if planted then
							for _, crop in ipairs(planted:GetChildren()) do
								local plantType = tostring(crop:GetAttribute("PlantType") or crop:GetAttribute("PlantName") or crop.Name)
								local serverConfig = crop:FindFirstChild("ServerConfiguration")
								local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
								if S.wateringTargetType == "Fruit" and fruitsConfig then
									-- Water EVERY fruit individually
									for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
										local fruitName = S.getFruitDisplayName(fruitCfg)
										local nameMatch = string.find(plantType:lower(), S.wateringSpecificName, 1, true) ~= nil or string.find(fruitName:lower(), S.wateringSpecificName, 1, true) ~= nil or string.find(fruitCfg.Name:lower(), S.wateringSpecificName, 1, true) ~= nil
										local passesNameFilter = S.wateringMode ~= "SPECIFIC" or (S.wateringSpecificName ~= "" and nameMatch)
										if passesNameFilter then
											local isGrown = false
											local ch = fruitCfg:FindFirstChild("CanHarvest")
											if ch and ch:IsA("BoolValue") and ch.Value then isGrown = true end
											if isGrown then
												fullyGrownCount += 1
												table.insert(fullyGrownNames, plantType)
											end
											local shouldWater = false
											if S.wateringMode == "SPECIFIC" then
												shouldWater = (S.wateringSpecificName ~= "" and passesNameFilter) and not isGrown
											elseif S.wateringMode == "POSITION" then
												shouldWater = false
											elseif S.wateringMode == "NOT_GROWN" then
												shouldWater = not isGrown
											elseif S.wateringMode == "ALL FRUITS" then
												shouldWater = not isGrown
											elseif S.wateringMode == "ALL" then
												shouldWater = not isGrown
											elseif S.wateringMode == "IN CROP FILTER" then
												local cleanType = S.getCleanPlantType(plantType)
												shouldWater = (S.cropFilterSelection and S.cropFilterSelection[cleanType] == true)
											end
											if shouldWater then
												local physicalFruit = S.getPhysicalFruit(crop, fruitCfg)
												local targetInst = physicalFruit or fruitCfg
												local pos = physicalFruit and physicalFruit:GetPivot().Position or crop:GetPivot().Position
												table.insert(targets, {Instance = targetInst, Position = pos, IsGrown = isGrown})
											end
										end
									end
								else
									local nameMatch = string.find(plantType:lower(), S.wateringSpecificName, 1, true) ~= nil
									local passesNameFilter = S.wateringMode ~= "SPECIFIC" or (S.wateringSpecificName ~= "" and nameMatch)
									if passesNameFilter then
										local isGrown = S.getCropPercent(crop) >= 100
										if not isGrown and fruitsConfig then
											for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
												local ch = fruitCfg:FindFirstChild("CanHarvest")
												if ch and ch:IsA("BoolValue") and ch.Value then isGrown = true break end
											end
										end
										if isGrown then
											fullyGrownCount += 1
											table.insert(fullyGrownNames, plantType)
										end
										local shouldWater = false
										if S.wateringMode == "SPECIFIC" then
											shouldWater = (S.wateringSpecificName ~= "" and passesNameFilter) and not isGrown
										elseif S.wateringMode == "POSITION" then
											shouldWater = false
										elseif S.wateringMode == "NOT_GROWN" then
											shouldWater = not isGrown
										elseif S.wateringMode == "ALL FRUITS" then
											shouldWater = not isGrown
										elseif S.wateringMode == "ALL" then
											shouldWater = not isGrown
										elseif S.wateringMode == "IN CROP FILTER" then
											local cleanType = S.getCleanPlantType(plantType)
											shouldWater = (S.cropFilterSelection and S.cropFilterSelection[cleanType] == true)
										end
										if shouldWater then
											table.insert(targets, {Instance = crop, Position = crop:GetPivot().Position, IsGrown = isGrown})
										end
									end
								end
							end
						end
					end
				end
				if S.wateringMode ~= "POSITION" then
					local grownCounts = {}
					local notGrownCounts = {}
					for _, plantType in ipairs(fullyGrownNames) do
						grownCounts[plantType] = (grownCounts[plantType] or 0) + 1
					end
					for _, target in ipairs(targets) do
						if not target.IsGrown then
							local plantType = tostring(target.Instance:GetAttribute("PlantType") or target.Instance:GetAttribute("PlantName") or target.Instance.Name)
							notGrownCounts[plantType] = (notGrownCounts[plantType] or 0) + 1
						end
					end
					local summaryParts = {}
					local summaryNames = {}
					for plantType in pairs(grownCounts) do summaryNames[plantType] = true end
					for plantType in pairs(notGrownCounts) do summaryNames[plantType] = true end
					local sortedNames = {}
					for plantType in pairs(summaryNames) do table.insert(sortedNames, plantType) end
					table.sort(sortedNames)
					for _, plantType in ipairs(sortedNames) do
						table.insert(summaryParts, string.format("%s %dx fully grow", plantType, grownCounts[plantType] or 0))
						table.insert(summaryParts, string.format("%s %dx not fully grow", plantType, notGrownCounts[plantType] or 0))
					end
					local summary = table.concat(summaryParts, " | ")
					if summary ~= "" and summary ~= S.lastWateringSummarySignature then
						S.addUiLog("Watering summary: " .. summary)
						S.lastWateringSummarySignature = summary
					end
					if #targets == 0 and fullyGrownCount > 0 then
						S.addUiLog("Watering " .. S.waterAllMode .. ": no not-grown plants available; all matching plants are fully grown")
					end
				end
				for index, target in ipairs(targets) do
					if index > 100 then break end
					if S.wateringTpMode == "TP_TO_PLANT" then
						local character = S.LocalPlayer.Character
						if character then
							character:PivotTo(CFrame.new(target.Position + Vector3.new(0, 3, 0)))
							task.wait()
						end
					end
					if not S.autoWateringActive then break end
					local waterActions = math.min(S.automationActionMultiplier, 5)
					S.growthSpeedMultiplier = S.PerformanceState.GetGrowthSpeedMultiplier()
					if S.autoWateringActive then
						S.fireRemoteBatch(S.UseEquippedTool, {TargetPosition = target.Position, Action = "Water", TargetInstance = target.Instance, Material = "Plastic", InputMode = "WorldPoint", TargetNormal = Vector3.yAxis}, waterActions)
					end
					local plantType = tostring(target.Instance:GetAttribute("PlantType") or target.Instance:GetAttribute("PlantName") or target.Instance.Name)
					S.applyActionHighlight(target.Instance, "[WATERING x" .. S.automationActionMultiplier .. "] " .. plantType, Color3.fromRGB(255, 170, 0), "water")
					if index == 1 then
						S.addUiLog(string.format("Auto water batch: %s at (%.2f, %.2f, %.2f)", plantType, target.Position.X, target.Position.Y, target.Position.Z))
					end
					task.wait(S.getAutomationDelay(S.wateringSpeedInput, 0.01))
				end
				task.wait(math.max(S.getAutomationDelay(S.wateringSpeedInput, 0.01), 0.01))
			else
				S.PerformanceState.SetWateringActive(false, S.wateringGrowthBonus)
			end
		end
	end)
