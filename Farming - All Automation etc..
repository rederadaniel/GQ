	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = "FruitNameTag"
		bb.Size = UDim2.new(0, 150, 0, 30)
		bb.StudsOffset = Vector3.new(0, 3, 0)
		bb.AlwaysOnTop = true
		bb.Parent = instance
		local txt = Instance.new("TextLabel")
		txt.Size = UDim2.new(1, 0, 1, 0)
		txt.BackgroundTransparency = 1
		txt.TextStrokeTransparency = 0
		txt.TextSize = 12
		txt.Font = Enum.Font.SourceSansBold
		txt.Parent = bb
	end
	local txt = bb:FindFirstChildOfClass("TextLabel")
	if txt then
		txt.Text = textMsg
		txt.TextColor3 = color or Color3.fromRGB(175, 95, 85)
	end
	-- Cap simultaneous action highlights so auto loops don't tank the FPS.
	table.insert(S.activeActionHighlights, hl)
	if #S.activeActionHighlights > S.MAX_ACTION_HIGHLIGHTS then
		local oldest = table.remove(S.activeActionHighlights, 1)
		if oldest and oldest.Parent then oldest:Destroy() end
	end
	task.delay(S.highlightDuration or 1.5, function()
		for i, h in ipairs(S.activeActionHighlights) do
			if h == hl then table.remove(S.activeActionHighlights, i) break end
		end
		if hl and hl.Parent then hl:Destroy() end
		if bb and bb.Parent then bb:Destroy() end
	end)
end
