						if not S.equipSeedForPlanting(S.plantMode == "RANDOM") then
							S.addUiLog("Planting: no seed tools found")
							task.wait(0.5)
							break
						end
						local position = cache.part.CFrame:PointToWorldSpace(Vector3.new(cell.x - cache.floorPos.X, cache.halfSize.Y + 0.05, cell.z - cache.floorPos.Z))
						if S.plantTpMode == "TP_TO_PLANT" then S.teleportToPosition(position) end
						S.showPlantPreview(position)
						S.firePlantRemote(Event, {
							TargetPart = cache.part,
							WorldPosition = position,
						}, S.plantMode == "RANDOM" and S.RANDOM_PLANT_REMOTE_INTERVAL or S.PLANT_REMOTE_INTERVAL)
						planted += 1
						batchPlanted = true
						if planted % S.FRAME_SMOOTH_INTERVAL == 0 then task.wait() end
					end
				end
				-- Rebuild the cache once every cell has been attempted
				local allExhausted = true
				for _, cache in ipairs(plantCache) do
					if cache.index <= #cache.empty then allExhausted = false break end
				end
				if allExhausted then plantCache = nil end
				-- Always yield to the next frame so the render thread stays smooth.
				if batchPlanted then task.wait(0.05) else task.wait(0.02) end
