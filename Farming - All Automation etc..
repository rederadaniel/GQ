					local ka = math.floor(a.z / 3) * 100 + a.x + ((a.x + a.z) % 4 == 0 and 50 or 0)
					local kb = math.floor(b.z / 3) * 100 + b.x + ((b.x + b.z) % 4 == 0 and 50 or 0)
					return ka < kb
				end)
			elseif S.plantPattern == "OASIS" then
				-- OASIS: lush center ring surrounded by barren edges
				local center = Vector3.new(floorPos.X, 0, floorPos.Z)
				table.sort(empty, function(a, b)
					local da = Vector3.new(a.x - center.X, 0, a.z - center.Z)
					local db = Vector3.new(b.x - center.X, 0, b.z - center.Z)
					local ra, rb = da.Magnitude, db.Magnitude
					local ringA = ra < 3 and 0 or 1
					local ringB = rb < 3 and 0 or 1
					if ringA ~= ringB then return ringA < ringB end
					if ringA == 0 then return ra < rb end
					return ra > rb
				end)
			elseif S.plantPattern == "MIRAGE" then
				-- MIRAGE: shimmering heat distortion waves
				table.sort(empty, function(a, b)
					local ka = a.z + math.sin(a.x * 0.8 + a.z * 0.3) * 4 + math.sin(a.x * 2.5) * 1.5
					local kb = b.z + math.sin(b.x * 0.8 + b.z * 0.3) * 4 + math.sin(b.x * 2.5) * 1.5
					if math.abs(ka - kb) < 0.001 then return a.x < b.x end
					return ka < kb
				end)
			elseif S.plantPattern == "RANDOM" then
				-- already shuffled
			end
			table.insert(plantCache, {
				part = soilPart,
				floorPos = floorPos,
				halfSize = halfSize,
				empty = empty,
				index = 1,
			})
		end
	end
	while true do
		if S.autoPlantActive and Event and not S.maxPlantsReached then
			if S.plantMode == "POSITION" then
				-- SMART POSITION: plant ONLY on the player's own soil parts, filling a grid
				-- outward from the character. When TP is enabled, teleport to the soil cell.
				if not plantCache or #plantCache == 0 or plantCacheMode ~= ("POSITION|" .. S.plantPattern) then
					plantCacheMode = "POSITION|" .. S.plantPattern
					rebuildPlantCache()
				end
				local planted = 0
				local batchPlanted = false
				-- SEQUENTIAL: fully plant the 1st soil part, then the next (+1), then the next.
				local cache = nil
				for _, c in ipairs(plantCache) do
					if c.index <= #c.empty then cache = c break end
				end
				if cache then
					while cache.index <= #cache.empty and planted < S.PLANT_BATCH_SIZE do
						if not S.autoPlantActive or S.maxPlantsReached then break end
						local cell = cache.empty[cache.index]
						cache.index += 1
						local key = cell.x .. "," .. cell.z
						if occupiedCells[key] then continue end
						occupiedCells[key] = true
						if not S.equipSeedForPlanting(false) then
							S.addUiLog("Planting: no seed tools found")
							task.wait(0.05)
							break
						end
						local position = cache.part.CFrame:PointToWorldSpace(Vector3.new(cell.x - cache.floorPos.X, cache.halfSize.Y + 0.05, cell.z - cache.floorPos.Z))
						if S.plantTpMode == "TP_TO_PLANT" then S.teleportToPosition(position) end
						S.showPlantPreview(position)
						S.firePlantRemote(Event, {
							TargetPart = cache.part,
							WorldPosition = position,
						}, S.PLANT_REMOTE_INTERVAL)
						planted += 1
						batchPlanted = true
						if planted % S.FRAME_SMOOTH_INTERVAL == 0 then task.wait() end
					end
				end
				local allExhausted = true
				for _, cache in ipairs(plantCache) do
					if cache.index <= #cache.empty then allExhausted = false break end
				end
				if allExhausted then plantCache = nil end
				-- Always yield between batches so the network + server can breathe.
				task.wait(math.max(0.016, 1 / S.plantSpeedMultiplier))
			else
				-- RANDOM / SMART: use the persistent grid cache
				if not plantCache or #plantCache == 0 or plantCacheMode ~= (S.plantMode .. "|" .. S.plantPattern) then
					plantCacheMode = S.plantMode .. "|" .. S.plantPattern
					rebuildPlantCache()
				end
				local planted = 0
				local batchPlanted = false
				-- SEQUENTIAL: fully plant the 1st soil part, then the next (+1), then the next.
				local cache = nil
				for _, c in ipairs(plantCache) do
					if c.index <= #c.empty then cache = c break end
				end
				if cache then
					while cache.index <= #cache.empty and planted < S.PLANT_BATCH_SIZE do
						if not S.autoPlantActive or S.maxPlantsReached then break end
						local cell = cache.empty[cache.index]
						cache.index += 1
						local key = cell.x .. "," .. cell.z
						if occupiedCells[key] then continue end
						occupiedCells[key] = true
						if not S.equipSeedForPlanting(S.plantMode == "RANDOM") then
							S.addUiLog("Planting: no seed tools found")
							task.wait(0.05)
							break
						end
						local position = cache.part.CFrame:PointToWorldSpace(Vector3.new(cell.x - cache.floorPos.X, cache.halfSize.Y + 0.05, cell.z - cache.floorPos.Z))
						if S.plantTpMode == "TP_TO_PLANT" then S.teleportToPosition(position) end
						S.showPlantPreview(position)
						S.firePlantRemote(Event, {
							TargetPart = cache.part,
							WorldPosition = position,
						}, S.plantMode == "RANDOM" and S.RANDOM_PLANT_REMOTE_INTERVAL or S.PLANT_REMOTE_INTERVAL)
						planted += 1
						batchPlanted = true
						if planted % S.FRAME_SMOOTH_INTERVAL == 0 then task.wait() end
					end
				end
				-- Rebuild the cache once every cell has been attempted
				local allExhausted = true
				for _, cache in ipairs(plantCache) do
					if cache.index <= #cache.empty then allExhausted = false break end
				end
				if allExhausted then plantCache = nil end
				-- Always yield to the next frame so the render thread stays smooth.
				task.wait(math.max(0.016, 1 / S.plantSpeedMultiplier))
			end
		else
			task.wait(0.1)
		end
	end
end)
