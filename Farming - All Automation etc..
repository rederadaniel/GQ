				local cache = nil
				for _, c in ipairs(plantCache) do
					if c.index <= #c.empty then cache = c break end
				end
				if cache then
					while cache.index <= #cache.empty and planted < S.PLANT_BATCH_SIZE do
						if not S.autoPlantActive or S.maxPlantsReached then break end
						local cell = cache.empty[cache.index]
						cache.index += 1
						local key = cell.x .. "," .. cell.z
						if occupiedCells[key] then continue end
