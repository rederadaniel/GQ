			if S.autoDeleteSpecific then
				local inventory = S.PlayerGui:FindFirstChild("InventoryGui")
				local main = inventory and inventory:FindFirstChild("MainFrame")
				local items = main and main:FindFirstChild("ItemsFrame")
				local remoteFolder = S.Remotes:FindFirstChild("MainInventory")
				local action = remoteFolder and remoteFolder:FindFirstChild("InventoryAction")
				if items and action then
					local seen = {}
					for _, item in ipairs(items:GetDescendants()) do
						local itemName = item:GetAttribute("ItemName") or item:GetAttribute("Name") or item.Name
						local itemId = item:GetAttribute("ItemId") or item:GetAttribute("ItemID") or item:GetAttribute("Id")
						if itemName and itemId and not seen[tostring(itemId)] then
							local shouldDelete = false
							if S.autoDeleteMode == "InputText" and S.autoDeleteName ~= "" then
								shouldDelete = tostring(itemName):lower():gsub("^%s+", ""):gsub("%s+$", "") == S.autoDeleteName
							elseif S.autoDeleteMode == "ItemsFilter" and S.itemFilterSelection then
								shouldDelete = S.itemFilterSelection[tostring(itemName)] == true
							end
							if shouldDelete then
								seen[tostring(itemId)] = true
								S.fireRemoteBatch(action, {Action = "DeleteItemStack", ItemId = tostring(itemId)}, S.autoDeleteActionMultiplier)
								S.addUiLog("Deleted item batch x" .. S.autoDeleteActionMultiplier .. ": " .. tostring(itemName))
							end
						end
					end
				end
			end
			task.wait(math.max(0.016, 1 / S.autoDeleteSpeedMultiplier))
		end
	end)
