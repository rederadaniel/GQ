function S.getMutationValuesFromFolder(mutationsTarget)
	local foundValues = {}
	if not mutationsTarget then return foundValues end
	if mutationsTarget:IsA("ValueBase") then
		if mutationsTarget.Value and tostring(mutationsTarget.Value) ~= "" then table.insert(foundValues, tostring(mutationsTarget.Value)) end
	end
	for attrName, attrVal in pairs(mutationsTarget:GetAttributes()) do table.insert(foundValues, tostring(attrVal)) end
	for _, mutItem in ipairs(mutationsTarget:GetDescendants()) do
		if mutItem:IsA("ValueBase") and mutItem.Value ~= nil and tostring(mutItem.Value) ~= "" then
			table.insert(foundValues, tostring(mutItem.Value))
		end
		local itemNameLower = mutItem.Name:lower()
		if itemNameLower ~= "mutations" and itemNameLower ~= "value" and itemNameLower ~= "getdate" then
			table.insert(foundValues, tostring(mutItem.Name))
		end
		local dateChild = mutItem:FindFirstChild("getDate") or mutItem:FindFirstChild("Date") or mutItem:FindFirstChild("Value")
		if dateChild and dateChild:IsA("ValueBase") and dateChild.Value ~= nil then table.insert(foundValues, tostring(dateChild.Value)) end
		for _, attrVal in pairs(mutItem:GetAttributes()) do table.insert(foundValues, tostring(attrVal)) end
	end
	return foundValues
end
function S.checkMutationMatch(mutationsTarget, queryText)
	local values = S.getMutationValuesFromFolder(mutationsTarget)
	if #values == 0 then return false, "", {} end
	local query = (queryText or ""):lower():gsub("%s+", "")
	local matchedList = {}
	for _, val in ipairs(values) do
		local valClean = tostring(val):lower():gsub("%s+", "")
		if query == "" then
			if valClean ~= "mutations" and valClean ~= "value" and valClean ~= "getdate" then table.insert(matchedList, tostring(val)) end
		elseif string.find(valClean, query) then
			table.insert(matchedList, tostring(val))
		end
	end
	if #matchedList > 0 then return true, matchedList[1], matchedList end
	if query == "" and #values > 0 then return true, tostring(values[1]), values end
	return false, "", {}
end
function S.isMutationAvoided(allFruitMutations)
	if S.avoidAllMutations and #allFruitMutations > 0 then return true end
	if S.avoidSpecificMutationsText ~= "" and #allFruitMutations > 0 then
		local blacklist = string.split(S.avoidSpecificMutationsText, ",")
		for _, rawAvoid in ipairs(blacklist) do
			local avoidQuery = rawAvoid:lower():gsub("%s+", "")
			if avoidQuery ~= "" then
				for _, mutVal in ipairs(allFruitMutations) do
					if string.find(tostring(mutVal):lower():gsub("%s+", ""), avoidQuery) then return true end
				end
			end
		end
	end
	return false
end
function S.plantHasMutations(plantInst)
	if not plantInst then return false end
	local serverConfig = plantInst:FindFirstChild("ServerConfiguration")
	if not serverConfig then serverConfig = plantInst.Parent and plantInst.Parent:FindFirstChild("ServerConfiguration") end
	local mutationsFolder = serverConfig and serverConfig:FindFirstChild("Mutations")
	local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
	local _, _, seedMuts = S.checkMutationMatch(mutationsFolder, "")
	if #seedMuts > 0 then return true end
	if fruitsConfig then
		for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
			local fruitMutFolder = fruitCfg:FindFirstChild("Mutations")
			local _, _, fruitMuts = S.checkMutationMatch(fruitMutFolder, "")
			if #fruitMuts > 0 then return true end
		end
	end
	return false
end
