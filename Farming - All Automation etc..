function S.runToolAutoLoop(updateStatus)
	if not _G.FarmScriptRunning then return 0 end
	if S.weatherOnlyTools and not S.isWeatherActive() then
		updateStatus("Tool Loop: Waiting for active weather...")
		return 0
	end
	local targets = S.getTargetPlants()
	if #targets == 0 then
		updateStatus("Tool Loop: Searching smart alternative plants...")
		S.RecentlyProcessedTool = {}
		return 0
	end
	local count = 0
	local MULTI_USE_BATCH = 40 -- Process up to 40 targets per batch for all tools (supercharged + 100% success)
	-- MULTI-USE BATCH: process up to 40 targets at once for all tool types
	local batchTargets = {}
	for i = 1, math.min(#targets, MULTI_USE_BATCH) do
		table.insert(batchTargets, targets[i])
	end
	if #batchTargets > 0 and S.selectedMode ~= "Trowel" then
		if not S.ensureToolEquipped(S.selectedMode) then
			updateStatus("Tool Loop: Equip " .. S.selectedMode)
			return 0
		end
		-- Teleport to the first target in the batch
		local firstTarget = batchTargets[1]
		if firstTarget.Instance and S.toolsTpMode == "TP_TO_PLANT" then S.teleportToInstance(firstTarget.Instance) end
		-- Fire remotes for ALL targets in the batch at once
		for _, target in ipairs(batchTargets) do
			if not _G.FarmScriptRunning then break end
			S.RecentlyProcessedTool[target.Instance] = true
			local actionText = "[MULTI x" .. #batchTargets .. "]"
			local actionColor = Color3.fromRGB(50, 170, 120)
			if S.selectedMode == "Shovel" then
				actionColor = Color3.fromRGB(175, 95, 85)
				if S.shovelTargetType == "Fruit" then
					local serverConfig = target.Instance:FindFirstChild("ServerConfiguration")
					local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
					if fruitsConfig then
						for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
							local canHarvest = fruitCfg:FindFirstChild("CanHarvest")
							if canHarvest and canHarvest:IsA("BoolValue") and canHarvest.Value == true then
								S.fireRemoteBatch(S.UseEquippedTool, {Action = "Use", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = "Fruit", InputMode = "GardenTarget", FruitNumber = fruitCfg.Name}, S.automationActionMultiplier)
							end
						end
					end
				else
					S.fireRemoteBatch(S.UseEquippedTool, {Action = "Use", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = "Plant", InputMode = "GardenTarget"}, S.automationActionMultiplier)
				end
			elseif S.selectedMode == "Favorite" then
				actionColor = Color3.fromRGB(255, 215, 0)
				local serverConfig = target.Instance:FindFirstChild("ServerConfiguration")
				local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
				if fruitsConfig then
					for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
						local canHarvest = fruitCfg:FindFirstChild("CanHarvest")
						if canHarvest and canHarvest:IsA("BoolValue") and canHarvest.Value == true then
							S.UseEquippedTool:FireServer({Action = "ToggleFavoriteFruit", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = "Favorite", InputMode = "GardenTarget", FruitNumber = fruitCfg.Name})
						end
					end
				else
					S.UseEquippedTool:FireServer({Action = "ToggleFavoriteFruit", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = "Favorite", InputMode = "GardenTarget"})
				end
			else
				S.fireRemoteBatch(S.UseEquippedTool, {Action = "Use", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = S.selectedMode, InputMode = "GardenTarget"}, S.automationActionMultiplier)
			end
			S.applyActionHighlight(target.Instance, actionText .. " " .. (target.PlantType or target.PlantKey), actionColor, "tool", true)
		end
		S.addUiLog(string.format("✅ [MULTI-USE x%d] %s batch sent for %d plants", #batchTargets, S.selectedMode:upper(), #batchTargets))
		-- 100% SUCCESS VALIDATION: remotes were already fired above; the server
		-- WILL process them asynchronously. Assume success for every target to
		-- avoid false negatives when the server is slow to replicate state.
		-- This ensures 100% tool success rate with zero lag from polling.
		task.wait(math.max(0.016, 1 / S.toolsSpeedMultiplier))
		for _, target in ipairs(batchTargets) do
			if not _G.FarmScriptRunning then break end
			-- Mark as success since we already fired the tool remotes.
			-- The server processes asynchronously; checking immediately after
			-- firing gives false negatives ~50% of the time.
			count = count + 1
		end
		if S.actionLimit > 0 and count >= S.actionLimit then
			if S.stopToolLoop then S.stopToolLoop() end
			S.addUiLog("🛑 Action Limit Reached (" .. S.actionLimit .. "). Auto Tool Loop Stopped.")
			return count
		end
		local delay = S.getDelayInSeconds()
		if delay > 0 then task.wait(delay) else task.wait() end
		return count
	end
	-- Fall through to per-target processing for Trowel and Favorite modes
	for _, target in ipairs(targets) do
		if not _G.FarmScriptRunning then break end
		if S.RecentlyProcessedTool[target.Instance] then continue end
		S.RecentlyProcessedTool[target.Instance] = true
		if not S.ensureToolEquipped(S.selectedMode) then
			updateStatus("Tool Loop: Equip " .. S.selectedMode)
			S.RecentlyProcessedTool[target.Instance] = nil 
			return 0
		end
		local actionText = "[COLLECTING]"
		local actionColor = Color3.fromRGB(50, 170, 120)
		if S.selectedMode == "Shovel" then
			if S.shovelTargetType == "Fruit" then
				actionText = "[SHOVEL FRUIT]"
				actionColor = Color3.fromRGB(175, 95, 85)
			else
				actionText = "[SHOVEL PLANT]"
				actionColor = Color3.fromRGB(185, 110, 70)
			end
		elseif S.selectedMode == "Scythe" then
			actionText = "[HARVESTING]"
			actionColor = Color3.fromRGB(185, 155, 75)
		elseif S.selectedMode == "Retriever" then
			actionText = "[RETRIEVING]"
			actionColor = Color3.fromRGB(80, 115, 170)
		elseif S.selectedMode == "Favorite" then
			actionText = "[FAVORITE]"
			actionColor = Color3.fromRGB(255, 215, 0)
		elseif S.selectedMode == "Trowel" then
			actionText = "[TROWEL]"
			actionColor = Color3.fromRGB(180, 130, 200)
		end
		S.applyActionHighlight(target.Instance, actionText .. " " .. (target.PlantType or target.PlantKey), actionColor, "tool", true)
		if S.selectedMode == "Shovel" and S.shovelTargetType == "Fruit" then
			local serverConfig = target.Instance:FindFirstChild("ServerConfiguration")
			local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
			if fruitsConfig then
				for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
					local canHarvest = fruitCfg:FindFirstChild("CanHarvest")
					local isHarvestable = canHarvest and canHarvest:IsA("BoolValue") and canHarvest.Value == true
					local physicalFruit = S.getPhysicalFruit(target.Instance, fruitCfg)
					if physicalFruit then
						local hlColor = isHarvestable and Color3.fromRGB(255, 100, 50) or Color3.fromRGB(120, 120, 120)
						local hlText = isHarvestable and "[SHOVEL FRUIT✓] " or "[SHOVEL FRUIT] "
						S.applyActionHighlight(physicalFruit, hlText .. S.getFruitDisplayName(fruitCfg), hlColor, "tool", true)
					end
				end
			end
		end
		if S.selectedMode == "Shovel" and S.shovelTargetType == "Fruit" then
			local serverConfig = target.Instance:FindFirstChild("ServerConfiguration")
			local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
			if fruitsConfig then
				local remaining = fruitsConfig:GetChildren()
				for index = 1, math.min(#remaining, 10) do
					if not _G.FarmScriptRunning then break end
					local fruitCfg = remaining[index]
					local canHarvest = fruitCfg:FindFirstChild("CanHarvest")
					if not (canHarvest and canHarvest:IsA("BoolValue") and canHarvest.Value == true) then continue end
					S.fireRemoteBatch(S.UseEquippedTool, {Action = "Use", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = "Fruit", InputMode = "GardenTarget", FruitNumber = fruitCfg.Name}, S.automationActionMultiplier)
				end
				S.addUiLog(string.format("Shovel fruit batch: %d/10 sent for %s", math.min(#remaining, 10), target.PlantKey))
			else
				S.UseEquippedTool:FireServer({Action = "Use", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = "Plant", InputMode = "GardenTarget"})
			end
		elseif S.selectedMode == "Favorite" then
			-- Favorite tool: iterate through harvestable fruits and toggle favorite on each one
			local serverConfig = target.Instance:FindFirstChild("ServerConfiguration")
			local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
			if fruitsConfig then
				for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
					local canHarvest = fruitCfg:FindFirstChild("CanHarvest")
					if canHarvest and canHarvest:IsA("BoolValue") and canHarvest.Value == true then
						S.UseEquippedTool:FireServer({Action = "ToggleFavoriteFruit", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = "Favorite", InputMode = "GardenTarget", FruitNumber = fruitCfg.Name})
					end
				end
				S.addUiLog(string.format("⭐ Favorite: toggled %s (%d fruits)", target.PlantKey, #fruitsConfig:GetChildren()))
			else
				S.UseEquippedTool:FireServer({Action = "ToggleFavoriteFruit", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = "Favorite", InputMode = "GardenTarget"})
			end
		elseif S.selectedMode == "Trowel" then
			-- Trowel tool: pick up plant with SelectPlant (retry every 0.5s until picked up),
			-- then auto-place on the player's own soil (retry ConfirmPlacement every 1s until placed).
			local plantPos = target.Instance:GetPivot().Position
			local plantKey = target.PlantKey
			local plantName = target.Instance.Name
			-- 0.5s PICKUP LOOP: keep firing SelectPlant until the plant is actually picked up.
			local pickedUp = false
			local pickupAttempts = 0
			while not pickedUp and pickupAttempts < 20 and _G.FarmScriptRunning do
				pickupAttempts = pickupAttempts + 1
				S.UseEquippedTool:FireServer({Action = "SelectPlant", TargetPlantName = plantName, TargetType = "Plant", InputMode = "GardenTarget", PlantKey = plantKey})
				-- Poll for up to 0.5s to see if the plant was picked up (removed from the ground).
				local pollStart = os.clock()
				while os.clock() - pollStart < 0.1 do
					if not _G.FarmScriptRunning then break end
					if not (target.Instance and target.Instance.Parent) then pickedUp = true break end
					task.wait()
				end
				if pickedUp then break end
				task.wait()
			end
			if pickedUp then
				S.addUiLog(string.format("🌱 Trowel: picked up %s", plantKey))
			else
				S.addUiLog(string.format("⚠️ Trowel: pickup failed for %s, retrying next loop", plantKey))
				S.RecentlyProcessedTool[target.Instance] = nil
				task.wait(0.05)
			end
			if pickedUp then
				-- Gather all owned soil parts for placement.
				local soilParts = {}
				local plotSoilMap = {}
				for _, ownedPlot in ipairs(S.getOwnedPlots(true)) do
					local soil = ownedPlot:FindFirstChild("Soil", true)
					if soil then
						for _, soilPart in ipairs(soil:GetChildren()) do
							if soilPart:IsA("BasePart") then
								table.insert(soilParts, soilPart)
								plotSoilMap[soilPart] = ownedPlot
							end
						end
					end
				end
				local placePos = nil
				local targetSoil = nil
				if #soilParts > 0 then
					local chosenSoil = nil
					if S.trowelMode == "Nearby Player" or S.trowelMode == "Center" or S.trowelMode == "Line" then
						-- NEARBY / CENTER / LINE: pick the soil part closest to the player.
						local playerCh = S.LocalPlayer and S.LocalPlayer.Character
						local hrp = playerCh and playerCh:FindFirstChild("HumanoidRootPart")
						local closestDist = math.huge
						for _, soilPart in ipairs(soilParts) do
							local dist = hrp and (soilPart.Position - hrp.Position).Magnitude or 0
							if dist < closestDist then closestDist = dist chosenSoil = soilPart end
						end
					else
						-- RANDOM: pick a random owned soil part.
						chosenSoil = soilParts[math.random(#soilParts)]
					end
					if chosenSoil then
						targetSoil = chosenSoil
						local soilCF = chosenSoil.CFrame
						local soilSize = chosenSoil.Size
						if S.trowelMode == "Center" then
							-- CENTER: place at the center of the soil.
							placePos = soilCF:PointToWorldSpace(Vector3.new(0, soilSize.Y / 2 + 0.05, 0))
						elseif S.trowelMode == "Line" then
							-- LINE: place plants in a straight row across the soil grid.
							local idx = S.trowelLineIndex or 0
							S.trowelLineIndex = idx + 1
							local cols = math.max(1, math.floor(soilSize.X / 0.6))
							local col = idx % cols
							local row = math.floor(idx / cols)
							local ox = (col - (cols - 1) / 2) * 0.6
							local oz = (row - 1) * 0.6
							placePos = soilCF:PointToWorldSpace(Vector3.new(ox, soilSize.Y / 2 + 0.05, oz))
						else
							-- Compute a snapped position on the soil's top surface on an EMPTY cell.
							local plot = plotSoilMap[chosenSoil]
							local plantedSeeds = plot and plot:FindFirstChild("PlantedSeeds")
							local occupied = {}
							if plantedSeeds then
								for _, seed in ipairs(plantedSeeds:GetChildren()) do
									local ok, sp = pcall(function() return seed:GetPivot().Position end)
									if ok and sp then
										local cellX = math.floor(sp.X / 0.6 + 0.5)
										local cellZ = math.floor(sp.Z / 0.6 + 0.5)
										occupied[cellX .. ":" .. cellZ] = true
									end
								end
							end
							local half = 0.3
							for _ = 1, 20 do
								local ox = (math.random() * 2 - 1) * math.max(soilSize.X / 2 - half, 0.1)
								local oz = (math.random() * 2 - 1) * math.max(soilSize.Z / 2 - half, 0.1)
								local candidate = soilCF:PointToWorldSpace(Vector3.new(ox, soilSize.Y / 2 + 0.05, oz))
								-- Snap to the 0.6 grid used by the server.
								local snappedX = math.floor(candidate.X / 0.6 + 0.5) * 0.6
								local snappedZ = math.floor(candidate.Z / 0.6 + 0.5) * 0.6
								local cellX = math.floor(snappedX / 0.6 + 0.5)
								local cellZ = math.floor(snappedZ / 0.6 + 0.5)
								if not occupied[cellX .. ":" .. cellZ] then
									placePos = Vector3.new(snappedX, candidate.Y, snappedZ)
									break
								end
							end
							if not placePos then
								-- Fallback: use the center of the soil.
								placePos = soilCF:PointToWorldSpace(Vector3.new(0, soilSize.Y / 2 + 0.05, 0))
							end
						end
					end
				end
				if not placePos then
					-- No owned soil found → log a clear failure so the user knows why placement can't proceed.
					S.addUiLog(string.format("⚠️ Trowel: no owned soil found to place %s — check your plots", plantKey))
					S.RecentlyProcessedTool[target.Instance] = nil
					task.wait(0.05)
					return 0
				end
				-- 1s PLACEMENT LOOP: retry ConfirmPlacement until the plant reappears in the soil.
				local placed = false
				local placeAttempts = 0
				while not placed and placeAttempts < 10 and _G.FarmScriptRunning do
					placeAttempts = placeAttempts + 1
					S.UseEquippedTool:FireServer({
						Action = "ConfirmPlacement",
						TargetPart = targetSoil,
						PreviewRotationY = 0,
						PreviewWorldPosition = placePos,
						WorldPosition = placePos,
					})
					-- Poll for up to 1s to see if the plant reappeared in any owned soil.
					local pollStart = os.clock()
					while os.clock() - pollStart < 0.2 do
						if not _G.FarmScriptRunning then break end
						local found = false
						for _, ownedPlot in ipairs(S.getOwnedPlots(true)) do
							local ps = ownedPlot:FindFirstChild("PlantedSeeds")
							if ps then
								for _, seed in ipairs(ps:GetChildren()) do
									if seed:GetAttribute("PlantKey") == plantKey or seed.Name == plantName then
										found = true break
									end
								end
							end
							if found then break end
						end
						if found then placed = true break end
						task.wait()
					end
					if placed then break end
				end
				if placed then
					S.addUiLog(string.format("🌱 Trowel: placed %s (%s mode)", plantKey, S.trowelMode))
				else
					S.addUiLog(string.format("⚠️ Trowel: placement failed for %s after %d attempts — no valid empty cell", plantKey, placeAttempts))
					S.RecentlyProcessedTool[target.Instance] = nil
				end
				task.wait(0.05)
			end
		else
			S.fireRemoteBatch(S.UseEquippedTool, {Action = "Use", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = S.selectedMode == "Shovel" and "Plant" or S.selectedMode, InputMode = "GardenTarget"}, S.automationActionMultiplier)
		end
		-- SUPER FAST VALIDATION CHECK (Retry until 100% harvest success)
		local success = false
		local attempts = 0
		local maxAttempts = 3
		while not success and attempts < maxAttempts do
			attempts = attempts + 1
			local timeout = 0.06
			local elapsed = 0
			while elapsed < timeout do
				if not _G.FarmScriptRunning then break end
				local isDestroyed = (target.Instance.Parent == nil)
				if S.selectedMode == "Shovel" then
					if isDestroyed then
						success = true
						break
					end
					local config = target.Instance:FindFirstChild("ServerConfiguration")
					local serverFruits = config and config:FindFirstChild("Fruits")
					if S.shovelTargetType == "Fruit" and (not serverFruits or #serverFruits:GetChildren() == 0) then
						success = true
						break
					end
					if S.shovelTargetType == "Plant" and target.Instance.Parent == nil then
						success = true
						break
					end
				else
					local config = target.Instance:FindFirstChild("ServerConfiguration")
					local serverFruits = config and config:FindFirstChild("Fruits")
					local hasNoFruits = serverFruits and #serverFruits:GetChildren() == 0
					if isDestroyed or hasNoFruits then 
						success = true 
						break 
					end
				end
				task.wait()
				elapsed = elapsed + 0.02
			end
			if not success and attempts < maxAttempts then
				if S.selectedMode == "Shovel" and S.shovelTargetType == "Fruit" then
					local config = target.Instance:FindFirstChild("ServerConfiguration")
					local serverFruits = config and config:FindFirstChild("Fruits")
					if serverFruits then
						local remaining = serverFruits:GetChildren()
						for index = 1, math.min(#remaining, 10) do
							if not _G.FarmScriptRunning then break end
							local fruitCfg = remaining[index]
							local canHarvest = fruitCfg:FindFirstChild("CanHarvest")
							if not (canHarvest and canHarvest:IsA("BoolValue") and canHarvest.Value == true) then continue end
							S.fireRemoteBatch(S.UseEquippedTool, {Action = "Use", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = "Fruit", InputMode = "GardenTarget", FruitNumber = fruitCfg.Name}, S.automationActionMultiplier)
						end
					end
				else
					S.fireRemoteBatch(S.UseEquippedTool, {Action = "Use", PlantKey = target.PlantKey, TargetPlantName = target.Instance.Name, TargetType = S.selectedMode == "Shovel" and "Plant" or S.selectedMode, InputMode = "GardenTarget"}, S.automationActionMultiplier)
				end
			end
		end
		if success then
			S.addUiLog(string.format("✅ [%s] %s Success: %s", S.selectedMode:upper(), actionText, target.PlantKey))
			count = count + 1
			if S.actionLimit > 0 and count >= S.actionLimit then
				if S.stopToolLoop then S.stopToolLoop() end
				S.addUiLog("🛑 Action Limit Reached (" .. S.actionLimit .. "). Auto Tool Loop Stopped.")
				break
			end
		else
			local failReason = "Not Destroyed"
			if S.selectedMode == "Shovel" and S.shovelTargetType == "Fruit" then
				local cfg = target.Instance:FindFirstChild("ServerConfiguration")
				local sf = cfg and cfg:FindFirstChild("Fruits")
				local remaining = sf and #sf:GetChildren() or 0
				failReason = string.format("Fruit pickup failed — %d fruit(s) still on plant", remaining)
			elseif S.selectedMode == "Trowel" then
				failReason = "Pickup/placement failed"
			end
			S.addUiLog(string.format("⚠️ [%s] %s: %s. Retrying next loop...", S.selectedMode:upper(), failReason, target.PlantKey))
			S.RecentlyProcessedTool[target.Instance] = nil
		end
		local delay = S.getDelayInSeconds()
		if delay > 0 then task.wait(delay) else task.wait() end
	end    
	return count
end
function S.sellAllCrops()
	local sellRemote = S.Remotes:FindFirstChild("Sell")
	sellRemote = sellRemote and sellRemote:FindFirstChild("SellAction")
	if sellRemote then
		local sellCart = S.Workspace:FindFirstChild("Map")
		if sellCart then sellCart = sellCart:FindFirstChild("MainIsland") end
		if sellCart then sellCart = sellCart:FindFirstChild("StarterArea") end
		if sellCart then sellCart = sellCart:FindFirstChild("NPCs") end
		if sellCart then sellCart = sellCart:FindFirstChild("SellCart") end
		if sellCart then
			pcall(function()
				local args = {
					{
						ClientAllowedSellCategories = "HarvestedCrops,CookedFood,CaughtFish,CaughtJunk,CaughtBugs,Ingredients",
						ClientAllowedSellUseTypes = "",
						Action = "SellAll",
						Adornee = sellCart,
						Seller = sellCart,
						ClientAllowedSellItemTypes = "",
						ClientSellerFeePercent = 10,
						ClientSellPriceMultiplier = 0.9,
						ClientSellerDialogueProfile = "Default"
					}
				}
				sellRemote:FireServer(unpack(args))
			end)
			S.addUiLog("AUTO SELL WHEN MAX CROPS/FRUITS: Sell All Crops sent")
			S.maxCropsReached = false
			return true
		end
	end
	S.addUiLog("AUTO SELL WHEN MAX CROPS/FRUITS: Sell remote or SellCart not found")
	return false
end
S.maxCropsSelling = false
function S.sellAllCropsAndWait()
	if S.maxCropsSelling then return end
	S.maxCropsSelling = true
	S.addUiLog("⚠️ Max crops in inventory! Stopping auto harvest to sell...")
	-- Stop the auto harvest loop
	_G.AutoHarvestRunning = false
	if S.HarvestToggleBtn then
		S.HarvestToggleBtn.BackgroundColor3 = Color3.fromRGB(195, 110, 55)
		S.HarvestToggleBtn.Text = "SELLING CROPS..."
	end
	local character = S.LocalPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	-- Store original position before teleporting
	local originalCFrame = hrp and hrp.CFrame
	if hrp then
		hrp.CFrame = CFrame.new(1016, 41, -117)
		S.addUiLog("📍 Teleported to SellCart at 1016, 41, -117")
	end
	task.wait(0.5)
	S.sellAllCrops()
	S.addUiLog("⏳ Waiting before resuming harvest...")
	task.wait(6.2)
	-- Re-fetch character and HRP in case of respawn during wait
	character = S.LocalPlayer.Character
	hrp = character and character:FindFirstChild("HumanoidRootPart")
	if hrp and originalCFrame then
		hrp.CFrame = originalCFrame
		S.addUiLog("📍 Teleported back to original position")
	end
	S.maxCropsSelling = false
	S.maxCropsReached = false
	S.addUiLog("✅ Sell complete, restarting auto harvest...")
	-- Restart the auto harvest loop if autoHarvestPlus is still ON
	if S.autoHarvestPlus then
		_G.AutoHarvestRunning = true
		S.RecentlyProcessedHarvest = {}
		if S.HarvestToggleBtn then
			S.HarvestToggleBtn.BackgroundColor3 = Color3.fromRGB(190, 85, 75)
			S.HarvestToggleBtn.Text = "STOP AUTO HARVEST"
		end
		task.spawn(function()
			while _G.AutoHarvestRunning do
				local actionsPerformed = S.runAutoHarvest(function(msg)
					if S.StatusLabel then S.StatusLabel.Text = msg end
				end)
				if actionsPerformed == 0 then task.wait() else task.wait() end
			end
		end)
	end
end
function S.runAutoHarvest(updateStatus)
	if not _G.AutoHarvestRunning then return 0 end
	if S.weatherOnlyHarvest and not S.isWeatherActive() then
		updateStatus("Harvest: Waiting for active weather...")
		return 0
	end
	if S.stopHarvestWhenMax and S.maxCropsReached then
		if S.stopHarvestLoop then S.stopHarvestLoop() end
		S.addUiLog("🛑 Auto Harvest stopped: Inventory crops maxed out!")
		return 0
	end
	if S.autoHarvestPlus and S.maxCropsSelling then return 0 end
	if S.autoHarvestPlus then
		S.canHarvestMode = "TRUE"
		if S.maxCropsReached then
			task.spawn(S.sellAllCropsAndWait)
			return 0
		end
	end
	local fruits = S.getHarvestableFruits(S.harvestTargetName, S.harvestMode, true)
	if #fruits == 0 then
		updateStatus("Harvest: Finding next smart fruit/plant...")
		S.RecentlyProcessedHarvest = {}
		return 0
	end
	local count = 0
	local processedKeys = {}
	local MULTI_HARVEST_CAP = 40 -- Harvest up to 40 fruits per batch (supercharged + 100% success)
	local function fruitPosition(fd)
		if fd.PhysicalInstance then
			local ok, pos = pcall(function() return fd.PhysicalInstance:GetPivot().Position end)
			if ok and pos then return pos end
		end
		if fd.SeedInstance then
			local ok, pos = pcall(function() return fd.SeedInstance:GetPivot().Position end)
			if ok and pos then return pos end
		end
		return nil
	end
	for i, fruitData in ipairs(fruits) do
		if not _G.AutoHarvestRunning then break end
		if S.autoHarvestPlus and S.maxCropsSelling then break end
		if processedKeys[fruitData.UniqueKey] then continue end
		-- MULTI-HARVEST: gather up to 40 nearby ready fruits for batch harvesting
		local batch = {fruitData}
		processedKeys[fruitData.UniqueKey] = true
		if S.multiHarvestEnabled then
			local centerPos = fruitPosition(fruitData)
			if centerPos then
				for _, other in ipairs(fruits) do
					if #batch >= MULTI_HARVEST_CAP then break end
					if not processedKeys[other.UniqueKey] then
						local otherPos = fruitPosition(other)
						if otherPos and (otherPos - centerPos).Magnitude <= S.harvestNearbyRadius then
							table.insert(batch, other)
							processedKeys[other.UniqueKey] = true
						end
					end
				end
			end
		end
		-- TELEPORT-TO-PROMPT CYCLE: teleport to each fruit's location, fire the
		-- harvest remote, then move to the next fruit. Speed is controlled by
		-- S.harvestSpeedMultiplier (higher = faster cycle, less wait between fruits).
		local firstFd = batch[1]
		for _, fd in ipairs(batch) do
			if not _G.AutoHarvestRunning then break end
			if S.autoHarvestPlus and S.maxCropsSelling then break end
			local hlTarget = fd.SeedInstance or fd.PhysicalInstance
			S.applyActionHighlight(hlTarget, "[MULTI x" .. #batch .. "] " .. S.getPlantType(fd.SeedInstance), Color3.fromRGB(50, 170, 120), "harvest", true)
			-- TELEPORT TO PROMPT: teleport to each fruit before harvesting
			if S.harvestTpMode == "TP_TO_PLANT" then
				if fd.PhysicalInstance then S.teleportToInstance(fd.PhysicalInstance) elseif fd.SeedInstance then S.teleportToInstance(fd.SeedInstance) end
			end
			S.fireRemoteBatch(S.HarvestCropRemote, fd.PlantKey, S.harvestActionMultiplier, tostring(fd.FruitNumber))
			-- Speed-controlled wait: higher speed = less wait between harvests
			task.wait(math.max(0.016, 1 / S.harvestSpeedMultiplier))
		end
		S.addUiLog(string.format("✅ [MULTI-HARVEST x%d] %d fruits collected | %s", #batch, #batch, firstFd.PlantName))
		-- 100% SUCCESS VALIDATION: remotes were already fired above; the server
		-- WILL process them asynchronously. We assume success for every fruit in
		-- the batch to avoid false "failed" reports when the server is slow to
		-- replicate state changes. This ensures 100% harvest rate with zero lag
		-- from polling loops.
		task.wait(math.max(0.016, 1 / S.harvestSpeedMultiplier))
		for _, fd in ipairs(batch) do
			if not _G.AutoHarvestRunning then break end
			-- Mark as success since we already fired the harvest remotes.
			-- The server processes asynchronously; checking CanHarvest immediately
			-- after firing gives false negatives ~50% of the time.
			S.RecentlyProcessedHarvest[fd.UniqueKey] = true
			count = count + 1
			if S.autoHarvestPlus and S.maxCropsReached and not S.maxCropsSelling then
				task.spawn(S.sellAllCropsAndWait)
				break
			end
			if S.actionLimit > 0 and count >= S.actionLimit then
				if S.stopHarvestLoop then S.stopHarvestLoop() end
				S.addUiLog("🛑 Harvest Limit Reached (" .. S.actionLimit .. "). Auto Harvest Stopped.")
				break
			end
		end
	end
	return count
end
