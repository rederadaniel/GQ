-- Returns ONLY the player's own soil parts that auto-plant is allowed to target.
-- These are the BasePart children of Plot1.Soil (Soil.Part and Soil:GetChildren()[2]).
function S.getPlantSoilParts()
	local parts = {}
	for _, plot in ipairs(S.getOwnedPlots(true)) do
		local soil = plot:FindFirstChild("Soil")
		if soil then
			for _, child in ipairs(soil:GetChildren()) do
				if child:IsA("BasePart") then table.insert(parts, child) end
			end
		end
	end
	-- Deterministic order: plant 1st soil, then 2nd, then 3rd (X then Z).
	table.sort(parts, function(a, b)
		local pa, pb = a.Position, b.Position
		if math.abs(pa.X - pb.X) > 0.01 then return pa.X < pb.X end
		return pa.Z < pb.Z
	end)
	-- Custom fill order: plant the 3rd soil part first, then the 1st, then the 2nd.
	if #parts >= 3 then
		parts[1], parts[2], parts[3] = parts[3], parts[1], parts[2]
	end
	return parts
end
function S.getRandomInvisibleFloorPosition(invisibleFloor)
	local halfSize = invisibleFloor.Size * 0.5
	local margin = 0.5
	local localPosition = Vector3.new(
		(math.random() * 2 - 1) * math.max(halfSize.X - margin, 0),
		halfSize.Y + 0.05,
		(math.random() * 2 - 1) * math.max(halfSize.Z - margin, 0)
	)
	return invisibleFloor.CFrame:PointToWorldSpace(localPosition)
end
function S.getEmptyPlantTargets()
	local targets = {}
	local occupied = {}
	for _, plot in ipairs(S.getOwnedPlots(true)) do
		local planted = plot:FindFirstChild("PlantedSeeds")
		if planted then
			for _, seed in ipairs(planted:GetChildren()) do
				local pos = seed:GetPivot().Position
				occupied[math.floor(pos.X + 0.5) .. "," .. math.floor(pos.Z + 0.5)] = true
			end
		end
	end
	-- Only plant on the player's own soil parts
	for _, soilPart in ipairs(S.getPlantSoilParts()) do
		local halfSize = soilPart.Size * 0.5
		local margin = 1.0
		local floorPos = soilPart.Position
		local minX = math.ceil(floorPos.X - halfSize.X + margin)
		local maxX = math.floor(floorPos.X + halfSize.X - margin)
		local minZ = math.ceil(floorPos.Z - halfSize.Z + margin)
		local maxZ = math.floor(floorPos.Z + halfSize.Z - margin)
		local empty = {}
		for x = minX, maxX do
			for z = minZ, maxZ do
				local key = x .. "," .. z
				if not occupied[key] then table.insert(empty, {x = x, z = z}) end
			end
		end
		for i = #empty, 2, -1 do
			local j = math.random(1, i)
			empty[i], empty[j] = empty[j], empty[i]
		end
		for _, cell in ipairs(empty) do
			table.insert(targets, {
				part = soilPart,
				position = soilPart.CFrame:PointToWorldSpace(Vector3.new(cell.x - floorPos.X, halfSize.Y + 0.05, cell.z - floorPos.Z)),
			})
		end
	end
	return targets
end
function S.getPlayerFeetPosition()
	local character = S.LocalPlayer.Character
	if not character then return nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local feetOffset = humanoid and humanoid.HipHeight or 2
	return root.Position - Vector3.new(0, feetOffset + root.Size.Y * 0.5, 0)
end
function S.sortTargetsByDistance(targets)
	local hrp = S.LocalPlayer.Character and S.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return targets end
	local origin = hrp.Position
	table.sort(targets, function(a, b)
		return (a.position - origin).Magnitude < (b.position - origin).Magnitude
	end)
	return targets
end
task.spawn(function()
	local Event = nil
	pcall(function() Event = S.ReplicatedStorage:WaitForChild("Remotes", 5):WaitForChild("Farming", 5):WaitForChild("PlantSeed", 5) end)
	-- Persistent grid cache so we never rescan the whole 23k-cell floor every batch
	local plantCache = nil
	local plantCacheMode = nil
	local occupiedCells = {}
	local function rebuildPlantCache()
		plantCache = {}
		occupiedCells = {}
		-- Mark every existing plant cell as occupied
		for _, plot in ipairs(S.getOwnedPlots(true)) do
			local planted = plot:FindFirstChild("PlantedSeeds")
			if planted then
				for _, seed in ipairs(planted:GetChildren()) do
					local pos = seed:GetPivot().Position
					occupiedCells[math.floor(pos.X + 0.5) .. "," .. math.floor(pos.Z + 0.5)] = true
				end
			end
		end
		-- Build empty cell grids for each owned soil part (only the player's own soil)
		for _, soilPart in ipairs(S.getPlantSoilParts()) do
			local halfSize = soilPart.Size * 0.5
			local margin = 1.0
			local floorPos = soilPart.Position
			local minX = math.ceil(floorPos.X - halfSize.X + margin)
			local maxX = math.floor(floorPos.X + halfSize.X - margin)
			local minZ = math.ceil(floorPos.Z - halfSize.Z + margin)
			local maxZ = math.floor(floorPos.Z + halfSize.Z - margin)
			local empty = {}
			for x = minX, maxX do
				for z = minZ, maxZ do
					local key = x .. "," .. z
					if not occupiedCells[key] then
						table.insert(empty, {x = x, z = z})
					end
				end
			end
			-- Shuffle for randomness
			for i = #empty, 2, -1 do
				local j = math.random(1, i)
				empty[i], empty[j] = empty[j], empty[i]
			end
			-- PATTERN-DRIVEN LAYOUT: the selected plant pattern (STRAIGHT / CIRCLE /
			-- SPIRAL / DIAGONAL / RANDOM) ALWAYS controls the layout, regardless of
			-- which plant mode (POSITION / RANDOM / SMART / SIDE BY SIDE) is active.
			-- Switching the pattern instantly changes the fill order for every mode.
			if S.plantPattern == "STRAIGHT" then
				-- Side-by-side straight fill: plant in three-column groups (three columns
				-- at a time), front-to-back then left-to-right, so rows stay tidy and aligned.
				table.sort(empty, function(a, b)
					local ca = math.floor(a.x / 3)
					local cb = math.floor(b.x / 3)
					if ca == cb then
						if a.z == b.z then return a.x < b.x end
						return a.z < b.z
					end
					return ca < cb
				end)
			elseif S.plantPattern == "CIRCLE" then
				local center = Vector3.new(floorPos.X, 0, floorPos.Z)
				table.sort(empty, function(a, b)
					local pa = Vector3.new(a.x, 0, a.z)
					local pb = Vector3.new(b.x, 0, b.z)
					return (pa - center).Magnitude < (pb - center).Magnitude
				end)
			elseif S.plantPattern == "SPIRAL" then
				local center = Vector3.new(floorPos.X, 0, floorPos.Z)
				table.sort(empty, function(a, b)
					local da = Vector3.new(a.x - center.X, 0, a.z - center.Z)
					local db = Vector3.new(b.x - center.X, 0, b.z - center.Z)
					local ra, rb = da.Magnitude, db.Magnitude
					local aa = math.atan2(da.Z, da.X)
					local ab = math.atan2(db.Z, db.X)
					-- Proper Archimedean spiral: angle dominates so the planting path
					-- winds outward in a smooth spiral, with radius as a tiebreaker.
					local ka = aa + ra * 0.15
					local kb = ab + rb * 0.15
					if math.abs(ka - kb) < 0.001 then return ra < rb end
					return ka < kb
				end)
			elseif S.plantPattern == "DIAGONAL" then
				table.sort(empty, function(a, b)
					if a.x + a.z == b.x + b.z then return a.x < b.x end
					return a.x + a.z < b.x + b.z
				end)
			elseif S.plantPattern == "SIDE BY SIDE" then
				-- SIDE BY SIDE: solid 2-column bands, both columns filled together top-to-bottom
				table.sort(empty, function(a, b)
					local ca = math.floor(a.x / 2)
					local cb = math.floor(b.x / 2)
					if ca ~= cb then return ca < cb end
					if a.z == b.z then return a.x < b.x end
					return a.z < b.z
				end)
			elseif S.plantPattern == "SNAKE" then
				-- SNAKE: 3-column serpentine, snakes through 3-column-wide vertical bands
				table.sort(empty, function(a, b)
					local ca = math.floor(a.x / 3)
					local cb = math.floor(b.x / 3)
					if ca ~= cb then return ca < cb end
					if a.z == b.z then
						if (ca % 2) == 0 then return a.x < b.x end
						return a.x > b.x
					end
					return a.z < b.z
				end)
			elseif S.plantPattern == "CHECKER" then
				-- CHECKER: 3-column checkerboard, alternating cells within each 3-column band
				table.sort(empty, function(a, b)
					local ca = math.floor(a.x / 3)
					local cb = math.floor(b.x / 3)
					if ca ~= cb then return ca < cb end
					local pa = (a.x + a.z) % 2
					local pb = (b.x + b.z) % 2
					if pa ~= pb then return pa < pb end
					if a.z == b.z then return a.x < b.x end
					return a.z < b.z
				end)
			elseif S.plantPattern == "RINGS" then
				local center = Vector3.new(floorPos.X, 0, floorPos.Z)
				table.sort(empty, function(a, b)
					local da = Vector3.new(a.x - center.X, 0, a.z - center.Z)
					local db = Vector3.new(b.x - center.X, 0, b.z - center.Z)
					local ra, rb = da.Magnitude, db.Magnitude
					if math.abs(ra - rb) < 0.01 then
						local aa = math.atan2(da.Z, da.X)
						local ab = math.atan2(db.Z, db.X)
						return aa < ab
					end
					return ra < rb
				end)
			elseif S.plantPattern == "COLUMNS" then
				-- Single columns: fill one column at a time, alternating top-to-bottom /
				-- bottom-to-top on each column so it differs from the paired-column pattern.
				table.sort(empty, function(a, b)
					if a.x ~= b.x then return a.x < b.x end
					if (a.x % 2) == 0 then return a.z < b.z end
					return a.z > b.z
				end)
			elseif S.plantPattern == "RANDOM" then
				-- already shuffled
			end
			table.insert(plantCache, {
				part = soilPart,
				floorPos = floorPos,
				halfSize = halfSize,
				empty = empty,
				index = 1,
			})
		end
	end
	while true do
		if S.autoPlantActive and Event and not S.maxPlantsReached then
			if S.plantMode == "POSITION" then
				-- SMART POSITION: plant ONLY on the player's own soil parts, filling a grid
				-- outward from the character. When TP is enabled, teleport to the soil cell.
				if not plantCache or #plantCache == 0 or plantCacheMode ~= ("POSITION|" .. S.plantPattern) then
					plantCacheMode = "POSITION|" .. S.plantPattern
					rebuildPlantCache()
				end
				local planted = 0
