-- ==========================================
-- GRAY/WHITE TEXT THEME + LARGER TOGGLE TEXT
-- Applies a slightly-darkened white to every text element so all toggles,
-- headers, and instructions read as "little black but white", and bumps up
-- small text so it is easier to read.
-- ==========================================
local GRAY_WHITE = Color3.fromRGB(200, 205, 210)
-- A color is "dark" when its perceived brightness is low.
local function isDarkText(c)
	local brightness = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
	return brightness < 0.5
end
local function stylePanelText(obj)
	if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
		-- Only convert fully black/dark text to grayish-white; keep light text as-is.
		if isDarkText(obj.TextColor3) then
			obj.TextColor3 = GRAY_WHITE
		end
		if obj.TextSize < 12 then
			obj.TextSize = 12
		end
	end
end
for _, d in ipairs(S.ScreenGui:GetDescendants()) do
	stylePanelText(d)
end
