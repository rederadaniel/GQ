			local show = true
			if selectedMutSort == "Exist" and mut.OwnedCount == 0 then show = false end
			if selectedMutSort == "0" and mut.OwnedCount > 0 then show = false end
			if selectedMutSort == "Selected" and not S.mutationFilterSelection[mut.Name] then show = false end
