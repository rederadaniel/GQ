function S.performanceIsVisual(instance)
	return instance:IsA("ParticleEmitter") or instance:IsA("Trail") or instance:IsA("Beam") or instance:IsA("Smoke") or instance:IsA("Fire") or instance:IsA("Sparkles") or instance:IsA("Light") or instance:IsA("BasePart") or instance:IsA("Decal") or instance:IsA("Texture") or instance:IsA("Sound")
end
function S.performancePosition(instance)
	local model = instance:FindFirstAncestorOfClass("Model")
	local part = if instance:IsA("BasePart") then instance else if model then model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true) else nil
	return part and part.Position
end
function S.performanceInRadius(instance)
	local character = S.Player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local position = S.performancePosition(instance)
	return not root or not position or (position - root.Position).Magnitude <= S.PerformanceState.RenderRadius
end
function S.performanceSave(instance, property)
	S.performanceSaved[instance] = S.performanceSaved[instance] or {}
	if S.performanceSaved[instance][property] == nil then
		S.performanceSaved[instance][property] = instance[property]
	end
end
function S.performanceReduce(instance)
	if not S.performanceIsVisual(instance) or not S.performanceInRadius(instance) then return end
	if instance:IsA("ParticleEmitter") then
		S.performanceSave(instance, "Enabled")
		S.performanceSave(instance, "Rate")
		S.performanceSave(instance, "Lifetime")
		instance.Enabled = false
		instance.Rate = 0
		instance.Lifetime = NumberRange.new(0.01, 0.01)
	elseif instance:IsA("Trail") or instance:IsA("Beam") or instance:IsA("Smoke") or instance:IsA("Fire") or instance:IsA("Sparkles") then
		S.performanceSave(instance, "Enabled")
		instance.Enabled = false
	elseif instance:IsA("Light") then
		S.performanceSave(instance, "Enabled")
		S.performanceSave(instance, "Range")
		instance.Enabled = false
		instance.Range = 0
	elseif instance:IsA("BasePart") then
		S.performanceSave(instance, "CastShadow")
		instance.CastShadow = false
	elseif instance:IsA("Decal") or instance:IsA("Texture") then
		S.performanceSave(instance, "Transparency")
		instance.Transparency = 1
	elseif instance:IsA("Sound") then
		S.performanceSave(instance, "Volume")
		instance.Volume = 0
	end
end
function S.performanceRestore()
	for instance, properties in pairs(S.performanceSaved) do
		if instance.Parent then
			for property, value in pairs(properties) do instance[property] = value end
		end
	end
	S.performanceSaved = {}
end
function S.PerformanceState.Apply(root)
	if not root then return end
	S.performanceRoots[root] = true
	if S.PerformanceState.PotatoMode then
		S.performanceReduce(root)
		for _, instance in root:GetDescendants() do S.performanceReduce(instance) end
	end
end
function S.PerformanceState.Bind(root)
	if not root then return end
	S.PerformanceState.Apply(root)
	if S.performanceConnections[root] then return end
	S.performanceConnections[root] = root.DescendantAdded:Connect(function(instance)
		if S.PerformanceState.PotatoMode then S.performanceReduce(instance) end
	end)
end
function S.applyLightingPotatoMode(enabled)
	if enabled then
		if S.lightingSaved.GlobalShadows == nil then
			S.lightingSaved.GlobalShadows = S.Lighting.GlobalShadows
		end
		if S.lightingSaved.Brightness == nil then
			S.lightingSaved.Brightness = S.Lighting.Brightness
		end
		if S.lightingSaved.EnvironmentDiffuseScale == nil then
			S.lightingSaved.EnvironmentDiffuseScale = S.Lighting.EnvironmentDiffuseScale
		end
		if S.lightingSaved.EnvironmentSpecularScale == nil then
			S.lightingSaved.EnvironmentSpecularScale = S.Lighting.EnvironmentSpecularScale
		end
		S.Lighting.GlobalShadows = false
		S.Lighting.Brightness = 1
		S.Lighting.EnvironmentDiffuseScale = 0
		S.Lighting.EnvironmentSpecularScale = 0
		for _, child in ipairs(S.Lighting:GetChildren()) do
			if child:IsA("PostEffect") and S.lightingSaved.Effects[child] == nil then
				S.lightingSaved.Effects[child] = child.Enabled
				child.Enabled = false
			end
		end
	else
		if S.lightingSaved.GlobalShadows ~= nil then
			S.Lighting.GlobalShadows = S.lightingSaved.GlobalShadows
			S.lightingSaved.GlobalShadows = nil
		end
		if S.lightingSaved.Brightness ~= nil then
			S.Lighting.Brightness = S.lightingSaved.Brightness
			S.lightingSaved.Brightness = nil
		end
		if S.lightingSaved.EnvironmentDiffuseScale ~= nil then
			S.Lighting.EnvironmentDiffuseScale = S.lightingSaved.EnvironmentDiffuseScale
			S.lightingSaved.EnvironmentDiffuseScale = nil
		end
		if S.lightingSaved.EnvironmentSpecularScale ~= nil then
			S.Lighting.EnvironmentSpecularScale = S.lightingSaved.EnvironmentSpecularScale
			S.lightingSaved.EnvironmentSpecularScale = nil
		end
		for effect, wasEnabled in pairs(S.lightingSaved.Effects) do
			if effect and effect.Parent then
				effect.Enabled = wasEnabled
			end
		end
		table.clear(S.lightingSaved.Effects)
	end
end
function S.PerformanceState.SetPotatoMode(enabled, renderRadius)
	S.PerformanceState.PotatoMode = enabled == true
	if renderRadius then S.PerformanceState.RenderRadius = math.max(32, tonumber(renderRadius) or 180) end
	S.applyLightingPotatoMode(S.PerformanceState.PotatoMode)
	if not S.PerformanceState.PotatoMode then
		S.performanceRestore()
		return
	end
	S.PerformanceState.Apply(S.Workspace)
	for root in pairs(S.performanceRoots) do S.PerformanceState.Apply(root) end
end
function S.PerformanceState.SetRenderRadius(radius)
	S.PerformanceState.RenderRadius = math.max(32, tonumber(radius) or 180)
	if S.PerformanceState.PotatoMode then
		S.PerformanceState.SetPotatoMode(false)
		S.PerformanceState.SetPotatoMode(true)
	end
end
function S.PerformanceState.SetWateringActive(active, bonusMultiplier)
	S.PerformanceState.WateringGrowthBonus = math.max(1, tonumber(bonusMultiplier) or S.PerformanceState.WateringGrowthBonus)
	S.PerformanceState.GrowthSpeedMultiplier = active and S.PerformanceState.WateringGrowthBonus or 1
end
function S.PerformanceState.GetGrowthSpeedMultiplier()
	return S.PerformanceState.GrowthSpeedMultiplier
end
