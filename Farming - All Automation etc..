			textLabel.Parent = S.LogScroll
			S.lastLogLabel = textLabel
		end
		task.wait(0.01)
		S.LogScroll.CanvasPosition = Vector2.new(0, S.LogScroll.AbsoluteCanvasSize.Y)
	end
	-- AUTO-REFRESH: keep the Logs tab live even when lowFpsMode skips per-entry UI
