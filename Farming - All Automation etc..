			btn.Position = UDim2.new((i - 1) * (1 / 9), 0, 0, 0)
			btn.BackgroundColor3 = (r == "All") and Color3.fromRGB(0, 140, 200) or Color3.fromRGB(28, 32, 42)
			btn.TextColor3 = Color3.fromRGB(160, 168, 184)
			btn.Text = r
			btn.TextSize = 7
			btn.Font = Enum.Font.GothamBold
			btn.AutoButtonColor = false
