function S.addPageGuideToTop(page, lines)
	if not page then return end
	local guideBottom = S.addPageGuide(page, 0, lines)
	local shift = guideBottom
	for _, child in ipairs(page:GetChildren()) do
		if child.Name ~= "PageGuide" and child:IsA("GuiObject") then
			local pos = child.Position
			child.Position = UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset + shift)
			local sz = child.Size
			if sz.Y.Offset < 0 then
				child.Size = UDim2.new(sz.X.Scale, sz.X.Offset, sz.Y.Scale, sz.Y.Offset - shift)
			end
		end
	end
	page.CanvasSize = UDim2.new(0, 0, 0, page.CanvasSize.Y.Offset + shift)
end
