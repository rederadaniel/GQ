function S.ensureSeedPackEquipped()
	local character = S.LocalPlayer.Character or S.LocalPlayer.CharacterAdded:Wait()
	local backpack = S.LocalPlayer:WaitForChild("Backpack")
	local equippedTool = character:FindFirstChildOfClass("Tool")
	if equippedTool and string.find(equippedTool.Name, "SeedPack") then return true end
	for _, tool in ipairs(backpack:GetChildren()) do
		if tool:IsA("Tool") and string.find(tool.Name, "SeedPack") then
			tool.Parent = character
			task.wait() -- yield once to avoid freeze
			return true
		end
	end
	return false
end
