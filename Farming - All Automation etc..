		table.insert(S.logEntries[category], formatted)
		if #S.logEntries[category] > S.MAX_LOG_ENTRIES then table.remove(S.logEntries[category], 1) end
		if not S.activeLogsEnabled or category ~= S.logCategory then return end
		if S.lowFpsMode then return end
