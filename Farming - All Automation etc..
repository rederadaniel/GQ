	local function getMutationList()
		local mutations = {}
		local mutInfo = {} -- mutName -> {Multiplier, OwnedCount}
		-- First: load all mutation names from CropMutationConfig
		local RS = game:GetService("ReplicatedStorage")
		local cmcPath = RS:FindFirstChild("Modules") and RS.Modules:FindFirstChild("PlantSystem")
		cmcPath = cmcPath and cmcPath:FindFirstChild("CropMutations")
		cmcPath = cmcPath and cmcPath:FindFirstChild("CropMutationConfig")
		if cmcPath then
			local ok, cmc = pcall(function() return require(cmcPath) end)
			if ok and type(cmc) == "table" and type(cmc.Definitions) == "table" then
				for mutName, def in pairs(cmc.Definitions) do
					if type(def) == "table" then
						local mult = def.SellMultiplier or def.Multiplier or 1
						mutInfo[mutName] = {Multiplier = tostring(mult), OwnedCount = 0}
					end
				end
			end
		end
		-- Second: scan ALL player owned plots for fruit mutations using checkMutationMatch
		for _, plot in ipairs(S.getOwnedPlots(true)) do
			local planted = plot:FindFirstChild("PlantedSeeds")
			if planted then
				for _, seed in ipairs(planted:GetChildren()) do
					local serverConfig = seed:FindFirstChild("ServerConfiguration")
					local fruitsConfig = serverConfig and serverConfig:FindFirstChild("Fruits")
					if fruitsConfig then
						for _, fruitCfg in ipairs(fruitsConfig:GetChildren()) do
							local fMutFolder = fruitCfg:FindFirstChild("Mutations")
							if fMutFolder then
								local _, _, mutList = S.checkMutationMatch(fMutFolder, "")
								for _, mutName in ipairs(mutList) do
									if not tonumber(mutName) and mutName ~= "Mutations" and mutName ~= "Value" then
										if not mutInfo[mutName] then
											mutInfo[mutName] = {Multiplier = S.resolveMutationMultiplier(mutName), OwnedCount = 0}
										end
										mutInfo[mutName].OwnedCount = mutInfo[mutName].OwnedCount + 1
									end
								end
							end
						end
					end
					-- Also check plant-level mutations
					local mutFolder = serverConfig and serverConfig:FindFirstChild("Mutations")
					if mutFolder then
						local _, _, mutList = S.checkMutationMatch(mutFolder, "")
						for _, mutName in ipairs(mutList) do
							if not tonumber(mutName) and mutName ~= "Mutations" and mutName ~= "Value" then
								if not mutInfo[mutName] then
									mutInfo[mutName] = {Multiplier = S.resolveMutationMultiplier(mutName), OwnedCount = 0}
								end
								mutInfo[mutName].OwnedCount = mutInfo[mutName].OwnedCount + 1
							end
						end
					end
				end
			end
		end
		-- Build the list
		for mutName, info in pairs(mutInfo) do
			table.insert(mutations, {Name = mutName, Multiplier = info.Multiplier, OwnedCount = info.OwnedCount})
		end
		table.sort(mutations, function(a, b) return a.Name < b.Name end)
		return mutations
	end
