end
-- Returns ONLY the player's own soil parts that auto-plant is allowed to target.
-- These are the BasePart children of Plot1.Soil (Soil.Part and Soil:GetChildren()[2]).
function S.getPlantSoilParts()
	local parts = {}
	for _, plot in ipairs(S.getOwnedPlots(true)) do
		local soil = plot:FindFirstChild("Soil")
		if soil then
			for _, child in ipairs(soil:GetChildren()) do
				if child:IsA("BasePart") then table.insert(parts, child) end
			end
		end
	end
	-- Deterministic order: plant 1st soil, then 2nd, then 3rd (X then Z).
	table.sort(parts, function(a, b)
		local pa, pb = a.Position, b.Position
		if math.abs(pa.X - pb.X) > 0.01 then return pa.X < pb.X end
		return pa.Z < pb.Z
	end)
	-- Custom fill order: plant the 3rd soil part first, then the 1st, then the 2nd.
	if #parts >= 3 then
		parts[1], parts[2], parts[3] = parts[3], parts[1], parts[2]
	end
	return parts
end
function S.getRandomInvisibleFloorPosition(invisibleFloor)
	local halfSize = invisibleFloor.Size * 0.5
	local margin = 0.5
	local localPosition = Vector3.new(
		(math.random() * 2 - 1) * math.max(halfSize.X - margin, 0),
		halfSize.Y + 0.05,
		(math.random() * 2 - 1) * math.max(halfSize.Z - margin, 0)
	)
	return invisibleFloor.CFrame:PointToWorldSpace(localPosition)
end
function S.getEmptyPlantTargets()
	local targets = {}
	local occupied = {}
	for _, plot in ipairs(S.getOwnedPlots(true)) do
		local planted = plot:FindFirstChild("PlantedSeeds")
		if planted then
			for _, seed in ipairs(planted:GetChildren()) do
				local pos = seed:GetPivot().Position
				occupied[math.floor(pos.X + 0.5) .. "," .. math.floor(pos.Z + 0.5)] = true
			end
		end
	end
	-- Only plant on the player's own soil parts
	for _, soilPart in ipairs(S.getPlantSoilParts()) do
		local halfSize = soilPart.Size * 0.5
		local margin = 1.0
		local floorPos = soilPart.Position
		local minX = math.ceil(floorPos.X - halfSize.X + margin)
		local maxX = math.floor(floorPos.X + halfSize.X - margin)
		local minZ = math.ceil(floorPos.Z - halfSize.Z + margin)
		local maxZ = math.floor(floorPos.Z + halfSize.Z - margin)
		local empty = {}
		for x = minX, maxX do
			for z = minZ, maxZ do
				local key = x .. "," .. z
				if not occupied[key] then table.insert(empty, {x = x, z = z}) end
			end
		end
		for i = #empty, 2, -1 do
			local j = math.random(1, i)
			empty[i], empty[j] = empty[j], empty[i]
		end
		for _, cell in ipairs(empty) do
			table.insert(targets, {
				part = soilPart,
				position = soilPart.CFrame:PointToWorldSpace(Vector3.new(cell.x - floorPos.X, halfSize.Y + 0.05, cell.z - floorPos.Z)),
			})
		end
	end
	return targets
end
function S.getPlayerFeetPosition()
	local character = S.LocalPlayer.Character
	if not character then return nil end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	local feetOffset = humanoid and humanoid.HipHeight or 2
	return root.Position - Vector3.new(0, feetOffset + root.Size.Y * 0.5, 0)
end
function S.sortTargetsByDistance(targets)
	local hrp = S.LocalPlayer.Character and S.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return targets end
	local origin = hrp.Position
	table.sort(targets, function(a, b)
		return (a.position - origin).Magnitude < (b.position - origin).Magnitude
	end)
	return targets
end
