	local function applyTransitions()
		for _, d in ipairs(S.ScreenGui:GetDescendants()) do
			if d:IsA("TextButton") and d.Name ~= "RelaunchBtn" then
				local origColor = d.BackgroundColor3
				local hoverColor = Color3.new(
					math.min(origColor.R * 1.2, 1),
					math.min(origColor.G * 1.2, 1),
					math.min(origColor.B * 1.2, 1)
				)
				d.MouseEnter:Connect(function()
					S.TweenService:Create(d, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = hoverColor}):Play()
				end)
				d.MouseLeave:Connect(function()
					S.TweenService:Create(d, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = origColor}):Play()
				end)
			end
		end
		S.ScreenGui.DescendantAdded:Connect(function(obj)
			if obj:IsA("TextButton") and obj.Name ~= "RelaunchBtn" then
				local origColor = obj.BackgroundColor3
				local hoverColor = Color3.new(
					math.min(origColor.R * 1.2, 1),
					math.min(origColor.G * 1.2, 1),
					math.min(origColor.B * 1.2, 1)
				)
				obj.MouseEnter:Connect(function()
					S.TweenService:Create(obj, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = hoverColor}):Play()
				end)
				obj.MouseLeave:Connect(function()
					S.TweenService:Create(obj, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = origColor}):Play()
				end)
