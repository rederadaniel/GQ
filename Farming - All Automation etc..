		button.Text = labelText
		button.TextSize = 11
		button.Font = Enum.Font.GothamMedium
		button.AutoButtonColor = false
		button.Parent = S.LogCategoryFrame
		Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)
		logFilterBtns[categoryKey] = button
		button.MouseButton1Click:Connect(function()
			S.logCategory = categoryKey
			S.LogFrame.Visible = true
			LogTitleLabel.Text = S.logCategoryTitles[categoryKey] or categoryKey
			for filterName, btn in pairs(logFilterBtns) do
				btn.BackgroundColor3 = filterName == categoryKey and Color3.fromRGB(70, 165, 115) or Color3.fromRGB(28, 32, 42)
				btn.TextColor3 = filterName == categoryKey and Color3.fromRGB(200, 205, 210) or Color3.fromRGB(160, 168, 184)
			end
			refreshLogDisplay(categoryKey)
		end)
		return button
	end
