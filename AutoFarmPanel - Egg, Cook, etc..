		btn.MouseButton1Click:Connect(function()
			btn.BackgroundColor3 = Colors.TOGGLE_ON
			if sellStatusLabel then sellStatusLabel.Text = "Selling... (" .. actionType .. ")" end
			task.spawn(function()
				local ok, err = pcall(performSellAction, actionType, shouldReturn)
				btn.BackgroundColor3 = Colors.TOGGLE_OFF
				if sellStatusLabel then
					sellStatusLabel.Text = ok and ("Done: " .. actionType) or ("Failed: " .. tostring(err))
				end
			end)
		end)

		return btn
	end

	createSellButton("Sell Held Food", "SellHeld", true, 1)
	createSellButton("Sell All Food", "SellAll", true, 2)
	createSellButton("Check Price Food", "CheckHeldPrice", false, 3)

	-- Sell status label (global so the button handler can update it)
	sellStatusLabel = Instance.new("TextLabel")
	sellStatusLabel.Name = "SellStatusLabel"
	sellStatusLabel.BackgroundTransparency = 1
	sellStatusLabel.Text = "Sell actions teleport to the Inn Keeper, sell, then return."
	sellStatusLabel.TextColor3 = Colors.TEXT_MUTED
	sellStatusLabel.Font = Enum.Font.Gotham
	sellStatusLabel.TextSize = 11
	sellStatusLabel.TextWrapped = true
	sellStatusLabel.Size = UDim2.new(1, 0, 0, 30)
	sellStatusLabel.LayoutOrder = 4
	sellStatusLabel.Parent = sellFrame

	print("[AutoFarm] Part 8 loaded: Instant Cooking modal disable & selling controls in Auto Farm Panel")
end
