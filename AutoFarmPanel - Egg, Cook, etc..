-- Track incubator countdowns independently
local function trackIncubatorCountdown(incubator, status, index)
	local key = tostring(incubator)
	if status.hatchFinishAt and status.hatchStartAt and status.hatchFinishAt > 0 then
		if not incubatorCountdowns[key] then
			-- First time seeing this incubator with a timer
			incubatorCountdowns[key] = {
				finishAt = status.hatchFinishAt,
				startAt = status.hatchStartAt,
				totalSeconds = status.hatchFinishAt - status.hatchStartAt,
				name = incubator.Name,
				index = index,
			}
		else
			-- Update with latest values
			incubatorCountdowns[key].finishAt = status.hatchFinishAt
			incubatorCountdowns[key].startAt = status.hatchStartAt
			incubatorCountdowns[key].totalSeconds = status.hatchFinishAt - status.hatchStartAt
		end
	end

	-- Check our own countdown for completion
	local tracked = incubatorCountdowns[key]
	if tracked then
		local now = os.time()
		if now >= tracked.finishAt then
			-- Our countdown says it's done!
			return true  -- should trigger collection
		end
		-- Update remaining in tracked data
		tracked.remainingSeconds = math.max(0, tracked.finishAt - now)
	end

	return false
end

-- Main incubator check function
local function processIncubators()
	local plot = findPlayerPlot()
	if not plot then return {} end

	local incubators = findIncubators(plot)
	local logData = {}

	for i, incubator in ipairs(incubators) do
		local status = getIncubatorStatus(incubator)

		-- Build log data for this incubator
		logData[i] = {
			name = incubator.Name,
			totalSeconds = status.totalSeconds or 0,
			remainingSeconds = status.remainingSeconds or 0,
			isDone = status.isDone,
			isEmpty = status.isEmpty,
			signText = status.signText,
			eggItemName = status.eggItemName,
		}

		-- Track countdown independently
		local ourCountdownSaysDone = trackIncubatorCountdown(incubator, status, i)

		-- Determine action
		local shouldTrigger = false

		if status.isEmpty then
			-- No egg in incubator - place one
			shouldTrigger = true
		elseif status.isDone or ourCountdownSaysDone then
			-- Egg is ready - collect it
			shouldTrigger = true
		elseif status.hatchReady then
			-- HatchReady attribute is true
			shouldTrigger = true
		end

		if shouldTrigger and not isInteractingIncubator then
			isInteractingIncubator = true

			-- Teleport and trigger
			triggerIncubator(incubator)

			-- Wait a moment for the interaction to process
			task.delay(0.15, function()
				isInteractingIncubator = false
				-- Clear the countdown tracker since we collected
				local key = tostring(incubator)
				incubatorCountdowns[key] = nil
			end)

			-- Update log to show action
			if status.isEmpty then
				logData[i].isEmpty = true
			else
				logData[i].isDone = true
			end
		end
	end

	return logData
end

