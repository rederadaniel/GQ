	local SellRemotes = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Sell")
	local SellAction = SellRemotes and SellRemotes:FindFirstChild("SellAction")

	local SELL_NPC_PATH = {"Map", "MainIsland", "TownSquare", "NPCs", "Milky | Inn Keeper"}
	local SELL_TP_POSITION = Vector3.new(1089, 43, -555)

	local function getSellNpc()
		local current = Workspace
		for _, name in ipairs(SELL_NPC_PATH) do
			current = current:FindFirstChild(name)
			if not current then return nil end
		end
		return current
	end

	local function fireSellAction(actionType)
		if not SellAction then
			warn("[AutoFarm][Sell] SellAction remote not found")
			return false
		end
		local npc = getSellNpc()
		if not npc then
			warn("[AutoFarm][Sell] Sell NPC not found")
			return false
		end
		local args = {{
			ClientAllowedSellCategories = "CookedFood,Ingredients",
			ClientAllowedSellUseTypes = "",
			Action = actionType,
			Adornee = npc,
			Seller = npc,
			ClientAllowedSellItemTypes = "",
			ClientSellerFeePercent = 0,
			ClientSellPriceMultiplier = 1,
			ClientSellerDialogueProfile = "InnKeeper",
		}}
		local success, err = pcall(function()
			SellAction:FireServer(unpack(args))
		end)
		if not success then
			warn("[AutoFarm][Sell] Failed to fire SellAction: " .. tostring(err))
			return false
		end
		print("[AutoFarm][Sell] Fired SellAction: " .. actionType)
		return true
	end

	local function teleportToPosition(position)
		local character = LocalPlayer.Character
		if not character then return false end
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return false end
		hrp.CFrame = CFrame.new(position)
		return true
	end

	local function getOriginalPosition()
		local character = LocalPlayer.Character
		if not character then return nil end
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return nil end
		return hrp.CFrame
	end

	local function restorePosition(originalCFrame)
		if not originalCFrame then return false end
		local character = LocalPlayer.Character
		if not character then return false end
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return false end
		hrp.CFrame = originalCFrame
		return true
	end

	local isSellingBusy = false

	local function performSellAction(actionType, shouldReturn)
		if isSellingBusy then return end
		isSellingBusy = true
		local originalCFrame = getOriginalPosition()
		teleportToPosition(SELL_TP_POSITION)
		task.wait(actionType == "CheckHeldPrice" and 0.5 or 0.3)
		if actionType == "CheckHeldPrice" then
			pressE(0.25)
			task.wait(0.1)
		end
		fireSellAction(actionType)
		if shouldReturn then
			task.wait(5)
			restorePosition(originalCFrame)
		end
		isSellingBusy = false
	end

