	-- Helper: get avoid items list from comma-separated string
	local function getAvoidItemsList()
		local avoidStr = AutoFarm.avoidItems or ""
		local list = {}
		for item in string.gmatch(avoidStr, "[^,]+") do
			item = string.gsub(item, "^%s+", "")
			item = string.gsub(item, "%s+$", "")
			if item ~= "" then
				list[string.lower(item)] = true
			end
		end
		return list
	end

	-- Helper: pick lowest-quantity item from inventory by category (Fruit/Milk/Fish)
	-- Respects avoidItems list. Returns item name with lowest quantity.
	local function pickLowestQuantityFromInventory(category)
		local inventoryGui = PlayerGui:FindFirstChild("InventoryGui")
		if not inventoryGui then return nil end
		local mainFrame = inventoryGui:FindFirstChild("MainFrame")
		if not mainFrame then return nil end
		local itemsFrame = mainFrame:FindFirstChild("ItemsFrame")
		if not itemsFrame then return nil end

		local avoidList = getAvoidItemsList()
		local candidates = {}
		for _, item in ipairs(itemsFrame:GetChildren()) do
			local attrName = item:GetAttribute("ItemName")
			if attrName and attrName ~= "" then
				-- Skip avoided items
				if avoidList[string.lower(attrName)] then
					continue
				end
				local isMatch = false
				if category == "Fruit" and IngredientDataModule and IngredientDataModule.hasFoodType(attrName, "Fruit") then
					isMatch = true
				elseif category == "Milk" and IngredientDataModule and IngredientDataModule.hasFoodType(attrName, "Milk") then
					isMatch = true
				elseif category == "Fish" then
					local lower = string.lower(attrName)
					if string.find(lower, "fish") then
						isMatch = true
					else
						local cat = item:GetAttribute("Category")
						if cat == "CaughtFish" then
							isMatch = true
						end
					end
				end
				if isMatch then
					-- Skip favorited items
					local contentFrame = item:FindFirstChild("ContentFrame")
					if contentFrame then
						local favBtn = contentFrame:FindFirstChild("FavoriteButton")
						if favBtn then
							local data = favBtn:FindFirstChild("Data")
							if data and data.Visible then
								isMatch = false
							end
						end
					end
				end
				if isMatch then
					-- Get quantity from AmountLabel
					local amount = 999999
					local contentFrame = item:FindFirstChild("ContentFrame")
					if contentFrame then
						local amountLabel = contentFrame:FindFirstChild("AmountLabel")
						if amountLabel and amountLabel:IsA("TextLabel") then
							local amt = tonumber(string.match(amountLabel.Text or "", "%d+"))
							if amt then amount = amt end
						end
					end
					table.insert(candidates, {name = attrName, amount = amount})
				end
			end
		end
		if #candidates == 0 then return nil end
		-- Sort by lowest quantity
		table.sort(candidates, function(a, b) return a.amount < b.amount end)
		return candidates[1].name
	end

	-- Continuous 0.1s scanning for random fruit/milk/fish
	-- Prioritizes items with lowest quantity, respects avoidItems list
	local lastRandomPick = {Fruit = "", Milk = "", Fish = ""}
	local function startRandomScanner(category, toggleName)
		task.spawn(function()
			while true do
				task.wait(0.1)
				if AutoFarm[toggleName == "RandomFruit" and "randomFruit" or toggleName == "RandomMilk" and "randomMilk" or "randomFish"] then
					local catMap = {RandomFruit = "Fruit", RandomMilk = "Milk", RandomFish = "Fish"}
					local picked = pickLowestQuantityFromInventory(catMap[toggleName])
					if picked and picked ~= lastRandomPick[category] then
						lastRandomPick[category] = picked
						AutoFarm.fruitSlots[1] = picked
						AutoFarm.autoHeldFruitName = picked
						if fruitSlotInputs[1] then fruitSlotInputs[1].Text = picked end
					end
				end
			end
		end)
	end
