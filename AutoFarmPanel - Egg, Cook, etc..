		local function collectCookingCauldronLogData(cauldrons, fruitName, requestState)
			local logData = {}
			for index, cauldron in ipairs(cauldrons) do
				local placementId = getCauldronPlacementId(cauldron)
				local state = requestState and waitForCauldronState(placementId, 0.25) or cookingStates[placementId]
				local ingredients, filledSlots, timer, status, result = getCookingStateText(state, fruitName)

				-- Fallback: read FoodName and ingredient info from the cauldron model attributes
				if result == "-" or result == "" then
					local foodName = cauldron:GetAttribute("FoodName") or cauldron:GetAttribute("OutputItemName") or cauldron:GetAttribute("OutputDisplayName")
					if foodName and foodName ~= "" then
						result = foodName
					end
				end
				-- Fallback: read ingredient slots from cauldron attributes if state is incomplete
				if filledSlots == 0 or (ingredients and ingredients[1] == "Empty" and ingredients[2] == "Empty") then
					local attrIngredients = {}
					local attrFilled = 0
					for i = 1, 4 do
						local ingName = cauldron:GetAttribute("Ingredient" .. i) or cauldron:GetAttribute("Slot" .. i .. "Item")
						if ingName and tostring(ingName) ~= "" then
							attrIngredients[i] = tostring(ingName)
							attrFilled = attrFilled + 1
						else
							attrIngredients[i] = "Empty"
						end
					end
					if attrFilled > 0 then
						ingredients = attrIngredients
						filledSlots = attrFilled
						if status == "Hold food to add" then
							status = "Cook"
						end
					end
				end
				-- Fallback: read cooking status from cauldron attributes
				if status == "Hold food to add" then
					local cauldronStatus = cauldron:GetAttribute("Status") or cauldron:GetAttribute("CookingStatus")
					if cauldronStatus then
						local statusLower = string.lower(tostring(cauldronStatus))
						if string.find(statusLower, "ready") or string.find(statusLower, "done") then
							status = "Ready"
							timer = "0s"
						elseif string.find(statusLower, "cook") then
							status = "Cook"
						end
					end
				end

				logData[index] = {ingredients = ingredients, timer = timer, status = status, result = result}
			end
			return logData
		end

