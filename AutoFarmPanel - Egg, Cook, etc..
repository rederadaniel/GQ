		waitForCauldronState = function(placementId, timeout)
			if placementId == "" then return nil end
			local deadline = os.clock() + timeout
			requestCauldronState(placementId)
			while os.clock() < deadline do
				local state = cookingStates[placementId]
				if state then return state end
				task.wait(0.08)
				requestCauldronState(placementId)
