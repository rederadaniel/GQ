			end
		end
	end)

	-- Update the timer if it successfully ran
	if clicked then
		lastClickTime = os.clock()
	end

	return clicked
end
-- Convert camelCase to spaced words (e.g., "BasicNet" -> "Basic Net", "OceanSeedPack" -> "Ocean Seed Pack")
local function formatCamelCase(str)
	if not str or str == "" then return str end
	-- Insert space between lowercase letter followed by uppercase letter
	local result = str:gsub("(%l)(%u)", "%1 %2")
	-- Also handle sequences of uppercase letters followed by lowercase (e.g., "HTMLParser" -> "HTML Parser")
	result = result:gsub("(%u)(%u%l)", "%1 %2")
	return result
end

