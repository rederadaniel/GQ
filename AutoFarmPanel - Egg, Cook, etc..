			end

			teleportToPart(interactionPart)
			task.wait(0.2)

			-- Add food to each slot by firing the proximity prompt
			for _ = 1, math.clamp(fruitSlots, 1, 4) do
				if not fireCookingPrompt(addPrompt) then
					return false, "CookingCauldron add-food prompt could not be triggered"
				end
				task.wait(0.25)
			end

			if shouldStart == false then
				return true, waitForCauldronState(placementId, 0.25)
			end
			-- Unequip food so the start cooking prompt can work
			unequipFood()
			task.wait(0.15)

			-- Try RequestStartCooking remote first
			if RequestStartCooking then
				pcall(function()
					RequestStartCooking:FireServer(placementId)
				end)
			end

			local state = waitForCauldronState(placementId, 0.8)
			if cauldronHasStartedCooking(state) and not isCookingJobReady(state) then
				return true, state
			end

			-- Fallback: fire the start prompt directly
			for attempt = 1, 4 do
				teleportToPart(interactionPart)
				task.wait(0.15)
				fireCookingPrompt(startPrompt)
				task.wait(0.35)
				state = waitForCauldronState(placementId, 0.7)
				if cauldronHasStartedCooking(state) and not isCookingJobReady(state) then
					return true, state
				end
			end
			return false, "CookingCauldron did not start after retrying the start prompt"
		end

