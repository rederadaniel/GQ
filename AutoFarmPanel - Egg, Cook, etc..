		-- Format a number with thousands separators (e.g. 10000 -> 10,000)
		local function formatNumber(n)
			n = tonumber(n) or 0
			local s = tostring(math.floor(n))
			local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
			formatted = formatted:gsub("^,", "")
			return formatted
		end

		-- Get reward text from quest data (deduplicated, no double reward)
		local function getQuestRewardText(rewardPreview)
			if type(rewardPreview) ~= "table" or #rewardPreview == 0 then
				return "Reward: Unknown"
			end
			local parts = {}
			local seen = {}
			for _, reward in ipairs(rewardPreview) do
				if type(reward) == "table" then
					local name = reward.DisplayName or reward.RewardId or reward.ItemName or "Reward"
					local amount = tonumber(reward.Amount or reward.Quantity) or 1
					local key = tostring(name)
					if not seen[key] then
						seen[key] = true
						if amount > 1 then
							table.insert(parts, "x" .. formatNumber(amount) .. " " .. tostring(name))
						else
							table.insert(parts, tostring(name))
						end
					end
				end
			end
			if #parts == 0 then return "Reward: Unknown" end
			return "Reward: " .. table.concat(parts, ", ")
		end

