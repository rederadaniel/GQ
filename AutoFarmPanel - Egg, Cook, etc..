		processCookingCauldrons = function()
			if cookingBusy then return end
			local plot = findPlayerPlot()
			local cauldrons = findCookingCauldrons(plot)
			if #cauldrons == 0 then
				updateCauldronPredictLog({})
				return
			end

			local fruitName = AutoFarm.fruitSlots[1] or ""
			if not AutoFarm.autoHeldFruitInventory and not AutoFarm.autoHeldFruitHotbar then
				refreshCookingCauldronLogs()
				return
			end

			cookingBusy = true

			for _, cauldron in ipairs(cauldrons) do
				local placementId = getCauldronPlacementId(cauldron)
				local state = waitForCauldronState(placementId, 0.35)
				local _, filledSlots, _, status = getCookingStateText(state, fruitName)
				local targetFruit = AutoFarm.fruitSlots[math.min(filledSlots + 1, 4)] or ""

				-- Override status if cooking job is ready (handles timing edge cases)
				if isCookingJobReady(state) then
					status = "Ready"
				end

				if status == "Ready" then
					-- Claim the cooked food via remote
					if RequestClaimCooking then
						pcall(function()
							RequestClaimCooking:FireServer(placementId)
						end)
					end
					-- Also try firing the prompt as fallback
					local prompts = findCookingPrompts(cauldron)
					if prompts[1] then
						local interactionPart = cauldron:FindFirstChild("InteractionPart", true)
						if interactionPart then
							teleportToPart(interactionPart)
							task.wait(0.15)
							fireCookingPrompt(prompts[1])
						end
					end
					task.wait(0.3)
					-- Clear the cached state so it refreshes
					cookingStates[placementId] = nil
					-- Re-request state to confirm claim went through
					state = waitForCauldronState(placementId, 0.4)
					-- If still showing ready, claim failed - skip this cauldron
					if isCookingJobReady(state) then
						continue
					end
					-- Claim succeeded - immediately fall through to add food
					filledSlots = 0
				end

				-- If cooking is in progress, skip this cauldron
				if cauldronHasStartedCooking(state) and not isCookingJobReady(state) then
					continue
				end

				-- If all slots are filled but cooking hasn't started, start cooking
				if filledSlots >= AutoFarm.autoCookingFruitSlots then
					unequipFood()
					task.wait(0.15)
					if RequestStartCooking then
						pcall(function()
							RequestStartCooking:FireServer(placementId)
						end)
					end
					-- Also try firing the start prompt as fallback
					local prompts = findCookingPrompts(cauldron)
					local startPrompt = prompts[2] or prompts[1]
					if startPrompt then
						local interactionPart = cauldron:FindFirstChild("InteractionPart", true)
						if interactionPart then
							teleportToPart(interactionPart)
							task.wait(0.1)
							fireCookingPrompt(startPrompt)
						end
					end
					task.wait(0.3)
				else
					local slotsToFill = math.clamp(AutoFarm.autoCookingFruitSlots - filledSlots, 0, 4 - filledSlots)
					-- Teleport to the cauldron ONCE before filling all needed slots
					local interactionPart = cauldron:FindFirstChild("InteractionPart", true)
					if interactionPart then
						teleportToPart(interactionPart)
						task.wait(0.2)
					end
					for slotOffset = 0, slotsToFill - 1 do
						local targetFruitName = AutoFarm.fruitSlots[filledSlots + slotOffset + 1] or ""
						if targetFruitName == "" then
							break
						end
						-- Hold the specific fruit (checks inventory and hotbar)
						if not isSelectedFruitEquipped(targetFruitName) then
							holdFruitForCooking(targetFruitName)
							task.wait(0.2)
						end
						if not isSelectedFruitEquipped(targetFruitName) then
							break
						end
						-- Add fruit 1
						local success, response = triggerCookingCauldron(cauldron, 1, placementId, false)
						if not success then
							break
						end
						cookingStates[placementId] = response or cookingStates[placementId]
						-- Stop held fruit
						unequipFood()
						task.wait(0.15)
					end
					local refreshedState = waitForCauldronState(placementId, 0.35)
					local _, refreshedFilled = getCookingStateText(refreshedState, fruitName)
					if refreshedFilled >= AutoFarm.autoCookingFruitSlots then
