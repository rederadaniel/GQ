	local clearSlotFrame
	setToggleState = function(name, state)
		local t = toggleButtons[name]
		if not t then return end
		t.state = state
		if state then
			t.status.Text = "ON"
			t.status.TextColor3 = Color3.fromRGB(255, 255, 255)
			t.btn.BackgroundColor3 = Color3.fromRGB(40, 170, 80)
		else
			t.status.Text = "OFF"
			t.status.TextColor3 = Colors.TEXT_MUTED
			t.btn.BackgroundColor3 = Colors.TOGGLE_OFF
		end
		if name == "AutoEgg" then AutoFarm.autoEgg = state
		elseif name == "AutoCookingCauldron" then AutoFarm.autoCookingCauldron = state
		elseif name == "AutoClaim" then AutoFarm.autoClaim = state
		elseif name == "AutoRefresh" then AutoFarm.autoRefresh = state
