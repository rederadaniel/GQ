-- Check if the player is currently holding/equipped with the specified item
local function isItemHeld(itemName)
	if not itemName or itemName == "" then return false end
	local character = LocalPlayer.Character
	if not character then return false end
	local itemNameLower = string.lower(itemName)
	for _, child in ipairs(character:GetChildren()) do
		if string.find(string.lower(child.Name), itemNameLower) then
			return true
		end
	end
	return false
end

-- Find an item in the inventory GUI by ItemName attribute, return ItemId
local function findInventoryItem(itemName)
	if not itemName or itemName == "" then return nil end
	local inventoryGui = PlayerGui:FindFirstChild("InventoryGui")
	if not inventoryGui then return nil end
	local mainFrame = inventoryGui:FindFirstChild("MainFrame")
	if not mainFrame then return nil end
	local itemsFrame = mainFrame:FindFirstChild("ItemsFrame")
	if not itemsFrame then return nil end

	local itemNameLower = string.lower(itemName)
	for _, item in ipairs(itemsFrame:GetChildren()) do
		-- Skip favorited items
		local contentFrame = item:FindFirstChild("ContentFrame")
		if contentFrame then
			local favBtn = contentFrame:FindFirstChild("FavoriteButton")
			if favBtn then
				local data = favBtn:FindFirstChild("Data")
				if data and data.Visible then
					continue
				end
			end
		end
		local attrName = item:GetAttribute("ItemName")
		if attrName and string.lower(attrName) == itemNameLower then
			local itemId = item:GetAttribute("ItemId")
			if itemId then
				return itemId
			end
		end
	end
	return nil
end

-- Find a hotbar slot by item name (checks both ItemName attribute and NameLabel text)
local function findHotbarSlotByName(itemName)
	if not itemName or itemName == "" then return nil end
	local hotbarGui = PlayerGui:FindFirstChild("HotbarGui")
	if not hotbarGui then return nil end
	local mainFrame = hotbarGui:FindFirstChild("MainFrame")
	if not mainFrame then return nil end

	local itemNameLower = string.lower(itemName)
	for i = 1, 8 do
		local slot = mainFrame:FindFirstChild("Slot" .. i)
		if slot then
			local attrName = slot:GetAttribute("ItemName")
			if attrName and string.lower(attrName) == itemNameLower then
				return i
			end
			local nameLabel = slot:FindFirstChild("NameLabel")
			if nameLabel and nameLabel.Text and string.lower(nameLabel.Text) == itemNameLower then
				return i
			end
		end
	end
	return nil
end

-- Auto equip from inventory: find item in inventory GUI and fire UseItem action
local function autoEquipFromInventory(itemName)
	if not itemName or itemName == "" then return false end
	local itemId = findInventoryItem(itemName)
	if itemId then
		pcall(function()
			InventoryAction:FireServer({
				Action = "UseItem",
				ItemId = itemId
			})
		end)
		return true
	end
	return false
end

-- Auto equip from hotbar: find slot and fire UseHotbarSlot
local function autoEquipFromHotbar(itemName)
	if not itemName or itemName == "" then return false end
	local slot = findHotbarSlotByName(itemName)
	if slot then
		pcall(function()
			UseHotbarSlot:FireServer(slot)
		end)
		return true
	end
	return false
end

local function resolveFruitItemId(itemName)
	return findInventoryItem(itemName)
end

local function getHotbarItemName(slotNumber)
	local hotbarGui = PlayerGui:FindFirstChild("HotbarGui")
	local mainFrame = hotbarGui and hotbarGui:FindFirstChild("MainFrame")
	local slot = mainFrame and mainFrame:FindFirstChild("Slot" .. tostring(slotNumber))
	if not slot then return nil end

	local itemName = slot:GetAttribute("ItemName")
	if type(itemName) == "string" and itemName ~= "" then
		return itemName
	end

	local nameLabel = slot:FindFirstChild("NameLabel")
	if nameLabel and nameLabel:IsA("TextLabel") and nameLabel.Text ~= "" then
		return nameLabel.Text
	end
	return nil
end

local function holdFruitFromInventory(itemName)
	itemName = itemName or AutoFarm.autoHeldFruitName
	local itemId = resolveFruitItemId(itemName)
	if not InventoryAction or type(itemId) ~= "string" or itemId == "" then
		return false
	end
	local success = pcall(function()
		InventoryAction:FireServer({
			Action = "UseItem",
			ItemId = itemId,
		})
	end)
	return success
end

local function holdFruitFromHotbar(itemName)
	if not AssignHotbarSlot then
		return false
	end
	itemName = itemName or AutoFarm.autoHeldFruitName
	local targetName = string.lower(tostring(itemName or ""))
	if targetName == "" then
		return false
	end
	for slotNumber = 1, 8 do
		local itemName = getHotbarItemName(slotNumber)
		if type(itemName) == "string" and string.lower(itemName) == targetName then
			local success = pcall(function()
				AssignHotbarSlot:FireServer({
					Slot = slotNumber,
					ItemId = itemName,
				})
			end)
			return success
		end
	end
	return false
end

local function unequipFood()
	if UnequipGear then
		pcall(function()
			UnequipGear:FireServer()
		end)
	end
end

-- Hold a fruit for cooking by checking both the hotbar and the inventory.
local function holdFruitForCooking(itemName)
	if AutoFarm.autoHeldFruitMode == "Hotbar" then
		if holdFruitFromHotbar(itemName) then return true end
		return holdFruitFromInventory(itemName)
	end
	if holdFruitFromInventory(itemName) then return true end
	return holdFruitFromHotbar(itemName)
end

