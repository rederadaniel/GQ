		updateQuestLog = function(questState)
			local quests = questState and questState.Quests
			if type(quests) ~= "table" then
				return
			end

			local limitedQuests = {}
			local seenQuestKeys = {}
			for _, quest in ipairs(quests) do
				local questKey = tostring(quest.QuestId or quest.DisplayName or quest.Description or "Quest")
				if not seenQuestKeys[questKey] and #limitedQuests < 6 then
					seenQuestKeys[questKey] = true
					table.insert(limitedQuests, quest)
				end
			end
			quests = limitedQuests

			local totalQuests = #quests
			local inProgress = 0
			for _, quest in ipairs(quests) do
				-- IN PROGRESS counts quests that are completed or claimed
				if quest.Completed == true or quest.Claimed == true then
					inProgress = inProgress + 1
				end
			end

			-- Update report rows (updates in place, never wipes the log)
			local rows = {}
			table.insert(rows, {
				key = "summary",
				title = string.format("ALL QUESTS %d | IN PROGRESS %d/%d", totalQuests, inProgress, totalQuests),
			})

			for i, quest in ipairs(quests) do
				local isCompleted = quest.Completed == true
				local isClaimed = quest.Claimed == true

				local statusText = "In Progress"
				local statusColor = Color3.fromRGB(255, 200, 80)
				if isClaimed then
					statusText = "Claimed"
					statusColor = Color3.fromRGB(150, 150, 160)
				elseif isCompleted then
					statusText = "Claim"
					statusColor = Color3.fromRGB(100, 255, 100)
				end

				local goal = math.max(1, math.floor(tonumber(quest.Goal or quest.Target or quest.Required) or 1))
				local progress = math.min(goal, math.max(0, math.floor(tonumber(quest.Progress or quest.CurrentProgress or quest.ProgressValue) or 0)))
				local unit = tostring(quest.ProgressUnit or "")
				local progressText
				if unit == "" then
					progressText = string.format("Progress: %d / %d", progress, goal)
				else
					progressText = string.format("Progress: %d / %d %s", progress, goal, unit)
				end
				local rewardText = getQuestRewardText(quest.RewardPreview)
				if rewardText == "Reward: Unknown" then rewardText = "" end

				table.insert(rows, {
					key = tostring(quest.QuestId or quest.DisplayName or "Quest"),
					title = tostring(quest.DisplayName or "Quest"),
					status = statusText,
					statusColor = statusColor,
					description = tostring(quest.Description or ""),
					reward = rewardText,
					progress = progressText,
					progressValue = progress,
					goal = goal,
				})
			end

			renderQuestLog(rows)
		end
	end

