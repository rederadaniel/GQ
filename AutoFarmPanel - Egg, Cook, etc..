-- Find the local player's plot by OwnerUserId attribute
local function findPlayerPlot()
	local map = Workspace:FindFirstChild("Map")
	if not map then return nil end
	local island = map:FindFirstChild("MainIsland")
	if not island then return nil end
	local gardens = island:FindFirstChild("PlayerGardens")
	if not gardens then return nil end
	local plots = gardens:FindFirstChild("Plots")
	if not plots then return nil end

	local userId = LocalPlayer.UserId
	for _, plot in ipairs(plots:GetChildren()) do
		local ownerAttr = plot:GetAttribute("OwnerUserId")
		if ownerAttr == userId then
			return plot
		end
	end
	-- Fallback: return first plot if no owner match (for testing)
	if #plots:GetChildren() > 0 then
		return plots:GetChildren()[1]
	end
	return nil
end

-- Find all incubators (BasicIncubator or FastIncubator) in the plot's PlacedFurniture
local function findIncubators(plot)
	local placedFurniture = plot:FindFirstChild("PlacedFurniture")
	if not placedFurniture then return {} end

	local incubators = {}
	for _, item in ipairs(placedFurniture:GetChildren()) do
		local name = item.Name
		local isIncubator = (name == "BasicIncubator" or name == "FastIncubator")
		isIncubator = isIncubator or (item:GetAttribute("IsPetIncubator") == true)
		isIncubator = isIncubator or (item:GetAttribute("ApplianceType") == "PetIncubator")
		isIncubator = isIncubator or (item:GetAttribute("IsIncubator") == true)
		if isIncubator then
			table.insert(incubators, item)
		end
	end
	return incubators
end

-- Get incubator status from attributes and Sign TextLabel
local function getIncubatorStatus(incubator)
	local status = {
		hasEgg = false,
		isHatching = false,
		hatchReady = false,
		hatchFinishAt = nil,
		hatchStartAt = nil,
		eggItemName = nil,
		signText = "",
		totalSeconds = 0,
		remainingSeconds = 0,
		isDone = false,
		isEmpty = false,
	}

	-- Read attributes
	status.hasEgg = incubator:GetAttribute("HasEgg") == true
	status.isHatching = incubator:GetAttribute("IsHatching") == true
	status.hatchReady = incubator:GetAttribute("HatchReady") == true
	status.hatchFinishAt = incubator:GetAttribute("HatchFinishAt")
	status.hatchStartAt = incubator:GetAttribute("HatchStartAt")
	status.eggItemName = incubator:GetAttribute("EggItemName")

	-- Read Sign TextLabel text
	local sign = incubator:FindFirstChild("Sign")
	if sign then
		local surfaceGui = sign:FindFirstChild("SurfaceGui")
		if surfaceGui then
			local textLabel = surfaceGui:FindFirstChild("TextLabel")
			if textLabel and textLabel:IsA("TextLabel") then
				status.signText = textLabel.Text or ""
			end
		end
	end

	-- Also check for ActiveEggVisual child
	local activeEggVisual = incubator:FindFirstChild("ActiveEggVisual")
	if activeEggVisual then
		status.hasEgg = true
	end

	-- Check EggAnchor for spawned egg visual
	local eggAnchor = incubator:FindFirstChild("EggAnchor")
	if eggAnchor and #eggAnchor:GetChildren() > 0 then
		status.hasEgg = true
	end

	-- Determine state
	local now = os.time()
	if status.hatchFinishAt and status.hatchFinishAt > 0 then
		status.totalSeconds = math.max(0, status.hatchFinishAt - (status.hatchStartAt or 0))
		status.remainingSeconds = math.max(0, status.hatchFinishAt - now)
		if status.remainingSeconds <= 0 then
			status.isDone = true
		end
	end

	-- Also check sign text for Ready/Done
	local signLower = string.lower(status.signText)
	if string.find(signLower, "ready") or string.find(signLower, "done") then
		status.isDone = true
		status.hasEgg = true
	end

	-- If no egg at all
	if not status.hasEgg and not status.isHatching then
		status.isEmpty = true
	end

	return status
end

-- Teleport player near a part (client-side CFrame set)
local function teleportToPart(part)
	local character = LocalPlayer.Character
	if not character then return false end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end

	-- Position 5 studs in front and 3 studs up from the part
	local targetCFrame = part.CFrame * CFrame.new(0, 3, 6)
	hrp.CFrame = targetCFrame
	return true
end

local function pressE(duration)
	local pressed = false
	local success = pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
		pressed = true
		task.wait(duration)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
	end)
	if pressed and not success then
		pcall(function()
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
		end)
	end
	return success
end

local function clickCloseButton()
	local questBoardGui = PlayerGui:FindFirstChild("QuestBoardGui")
	local shade = questBoardGui and questBoardGui:FindFirstChild("Shade")
	local panel = shade and shade:FindFirstChild("Panel")
	local closeButton = panel and panel:FindFirstChild("CloseButton")

	if not closeButton then
		return false
	end

	local fired = false
	if closeButton:IsA("GuiButton") then
		fired = pcall(function()
			-- 1. Try built-in Roblox button activation
			closeButton:Activate()

			-- 2. Fire connections directly (for MouseButton1Click / Activated bindings)
			for _, connection in ipairs(getconnections(closeButton.MouseButton1Click)) do
				connection:Fire()
			end
			for _, connection in ipairs(getconnections(closeButton.Activated)) do
				connection:Fire()
			end

			-- 3. Simulate actual physical click over button position
			local pos = closeButton.AbsolutePosition
			local size = closeButton.AbsoluteSize
			local centerX = pos.X + (size.X / 2)
			local centerY = pos.Y + (size.Y / 2) + 36 -- Offset for top bar inset

			VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
			task.wait(0.05)
			VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)
		end)
	end

	-- Fallback: If UI remains enabled after attempt, force hide it
	task.wait(0.1)
	if questBoardGui and questBoardGui.Enabled then
		questBoardGui.Enabled = false
	end

	return fired
end
local function triggerQuestBoardPrompt()
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return false, "Player character is not ready"
	end

	local originalCFrame = root.CFrame
	local originalVelocity = root.AssemblyLinearVelocity
	local interactionPosition = Vector3.new(967, 41, -599)
	local interactionCFrame = CFrame.lookAt(interactionPosition, interactionPosition + Vector3.new(0, 0, -1))
	local triggered = false
	local success, errorMessage = xpcall(function()
		humanoid:Move(Vector3.zero)
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = interactionCFrame
		task.wait(0.1)
		root.CFrame = interactionCFrame
		pressE(0.3)
		pressE(0.6)
		task.wait(1.1)
		clickCloseButton()
		task.wait(1.1)

		triggered = true
	end, debug.traceback)

	if root.Parent then
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = originalCFrame
		task.wait()
		if root.Parent then
			root.AssemblyLinearVelocity = originalVelocity
		end
	end

	if not success then
		warn("[AutoFarm] Run Sequence failed: " .. tostring(errorMessage))
		return false, "Run Sequence failed"
	end
	return triggered, "Teleported, held E for 0.5s, closed QuestBoardGui, and restored original position"
end

local function triggerIncubator(incubator)
	local interactionPart = incubator:FindFirstChild("InteractionPart")
	if not interactionPart then return false end

	-- Teleport near the incubator
	teleportToPart(interactionPart)

	-- Method 1: Fire OpenIncubatorUi remote
	local placementId = incubator:GetAttribute("PlacementId")
	if placementId then
		pcall(function()
			OpenIncubatorUi:FireServer(placementId)
		end)
	end

	-- Method 2: Try fireproximityprompt if available (some environments have it)
	local prompt = interactionPart:FindFirstChild("AppliancePrompt")
	if not prompt then
		prompt = interactionPart:FindFirstChildOfClass("ProximityPrompt")
	end
	if not prompt then
		-- Search descendants
		for _, desc in ipairs(interactionPart:GetDescendants()) do
			if desc:IsA("ProximityPrompt") then
				prompt = desc
				break
			end
		end
	end

	if prompt then
		-- Try fireproximityprompt global function
		if type(fireproximityprompt) == "function" then
			pcall(function()
				fireproximityprompt(prompt)
			end)
		end

		-- Try VirtualInputManager to simulate E key
		pcall(function()
			local VIM = game:GetService("VirtualInputManager")
			VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
			task.wait(0.1)
			VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
		end)
	end

	return true
end

-- Request quest board state from server
local function getQuestState()
	if questFetchInFlight then
		return lastQuestState
	end
	questFetchInFlight = true
	lastQuestFetchAt = os.clock()
	if not RequestQuestBoardState then
		questFetchInFlight = false
		return lastQuestState
	end
	local success, result = pcall(function()
		return RequestQuestBoardState:InvokeServer()
	end)
	questFetchInFlight = false
	if success and type(result) == "table" then
		lastQuestState = result
		return result
	end
	return lastQuestState
end

-- Format seconds into human-readable time
local function formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%ds", seconds)
end

-- Find a tool in the hotbar by name/type
local function findHotbarSlot(toolName)
	local hotbarGui = PlayerGui:FindFirstChild("HotbarGui")
	if not hotbarGui then return nil end
	local mainFrame = hotbarGui:FindFirstChild("MainFrame")
	if not mainFrame then return nil end

	for i = 1, 8 do
		local slot = mainFrame:FindFirstChild("Slot" .. i)
		if slot then
			local nameLabel = slot:FindFirstChild("NameLabel")
			if nameLabel and string.find(string.lower(nameLabel.Text or ""), string.lower(toolName)) then
				return i
			end
		end
	end
	return nil
end

-- Equip a tool by finding it in hotbar and using the slot
local function equipTool(toolName)
	local slot = findHotbarSlot(toolName)
	if slot then
		pcall(function()
			UseHotbarSlot:FireServer(slot)
		end)
		return true
	end
	return false
end

