	-- Validate that an item is a valid cooking ingredient (Fruit, Milk, or Fish)
	local function isValidCookingIngredient(itemName)
		if not itemName or itemName == "" then return false end
		local lower = string.lower(itemName)
		-- Fruit or Milk via IngredientData
		if IngredientDataModule then
			if IngredientDataModule.hasFoodType(itemName, "Fruit") then return true end
			if IngredientDataModule.hasFoodType(itemName, "Milk") then return true end
		end
		-- Fish: item name contains "Fish" or is in the CaughtFish inventory category
		if string.find(lower, "fish") then return true end
		local inventoryGui = PlayerGui:FindFirstChild("InventoryGui")
		if inventoryGui then
			local mainFrame = inventoryGui:FindFirstChild("MainFrame")
			local itemsFrame = mainFrame and mainFrame:FindFirstChild("ItemsFrame")
			if itemsFrame then
				for _, item in ipairs(itemsFrame:GetChildren()) do
					local attrName = item:GetAttribute("ItemName")
					local category = item:GetAttribute("Category")
					if attrName and string.lower(attrName) == lower and category == "CaughtFish" then
						return true
					end
				end
			end
		end
		return false
	end



