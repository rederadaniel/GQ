		getCookingStateText = function(state, fruitName)
			local ingredients = {}
			local filledCount = 0
			local configuredSlots = AutoFarm.fruitSlots or {"", "", "", ""}
			if type(state) == "table" then
				local source = state.PendingIngredients or state.Ingredients
				if type(source) == "table" then
					for i = 1, 4 do
						local ingredient = source[i]
						if type(ingredient) == "table" then
							ingredient = ingredient.ItemName or ingredient.ItemTypeId or ingredient.Name
						end
						if ingredient ~= nil and tostring(ingredient) ~= "" then
							filledCount += 1
						end
						ingredients[i] = tostring(ingredient or "")
					end
				end
				filledCount = math.max(filledCount, tonumber(state.IngredientCount) or 0)
			end
			local job = type(state) == "table" and state.CookingJob or nil
			local finishAt = type(job) == "table" and tonumber(job.FinishAt) or nil
			local timer = finishAt and formatTime(math.max(0, finishAt - getServerNow())) or "-"
			local result = type(job) == "table" and (job.OutputDisplayName or job.OutputItemName) or "-"
			local status = "Hold food to add"
			if type(job) == "table" then
				status = finishAt and finishAt <= getServerNow() and "Ready" or "Cook"
			elseif filledCount > 0 then
				status = "Cook"
			end
			for i = 1, 4 do
				if ingredients[i] == "" then
					ingredients[i] = "Empty"
				end
			end

			-- Fallback: read from CookingApplianceGui UI if state is incomplete
			if type(state) ~= "table" or (not job and filledCount == 0) then
				local cookingGui = PlayerGui:FindFirstChild("CookingApplianceGui")
				if cookingGui and cookingGui.Enabled then
					local cauldronFrame = cookingGui:FindFirstChild("CauldronFrame")
					if cauldronFrame then
						local statusLabel = cauldronFrame:FindFirstChild("StatusLabel")
						local timerLabel = cauldronFrame:FindFirstChild("TimerLabel")
						local resultLabel = cauldronFrame:FindFirstChild("ResultLabel")
						if statusLabel and statusLabel:IsA("TextLabel") and statusLabel.Text ~= "" then
							local uiStatus = statusLabel.Text
							if string.find(uiStatus, "Ready") then
								status = "Ready"
								timer = "0s"
							elseif string.find(uiStatus, "Cooking") then
								status = "Cook"
								timer = string.gsub(uiStatus, "Cooking%s*", "")
								if timer == "" then timer = "-" end
							elseif string.find(uiStatus, "Cook") then
								status = "Cook"
							elseif string.find(uiStatus, "Hold food") then
								status = "Hold food to add"
							end
						end
						if timerLabel and timerLabel:IsA("TextLabel") and timerLabel.Text ~= "" then
							timer = timerLabel.Text
						end
						if resultLabel and resultLabel:IsA("TextLabel") and resultLabel.Text ~= "" then
							result = resultLabel.Text
						end
					end
				end
			end
			return ingredients, filledCount, timer, status, tostring(result)
		end

		-- ===== PET PREDICTION DATA =====
		-- Predicts the most likely pet for each egg type based on hatch probabilities.
		local PET_PREDICTION = {}
		local function normalizeName(s)
			return string.gsub(string.lower(tostring(s or "")), "%s+", "")
		end
		local function buildPetPrediction()
			local cats = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("ItemDisplayDataCategories")
			local petsRef = cats and cats:FindFirstChild("Pets")
			if not petsRef then return end
			local ok, petsModule = pcall(require, petsRef)
			if not ok or type(petsModule) ~= "table" then return end

			local eggs = {}
			local pets = {}
			for _, data in pairs(petsModule) do
				if type(data) == "table" then
					if data.ItemType == "PetEgg" and type(data.DisplayName) == "string" then
						table.insert(eggs, data.DisplayName)
					elseif data.ItemType == "Pet" and type(data.DisplayName) == "string" then
						table.insert(pets, data.DisplayName)
					end
				end
			end

			for _, eggName in ipairs(eggs) do
				local keyword = eggName
				keyword = string.gsub(keyword, "Premium", "")
				keyword = string.gsub(keyword, "Basic", "")
				keyword = string.gsub(keyword, "Spotted", "")
				keyword = string.gsub(keyword, "Pet", "")
				keyword = string.gsub(keyword, "Egg", "")
				keyword = string.gsub(keyword, "%s+", "")
				local kw = normalizeName(keyword)
				if kw == "" then
					kw = normalizeName(string.gsub(eggName, "Egg", ""))
				end

				local matches = {}
				for _, petName in ipairs(pets) do
					if string.find(normalizeName(petName), kw) then
						table.insert(matches, petName)
					end
				end
				if #matches == 0 then
					for i = 1, math.min(5, #pets) do
						table.insert(matches, pets[i])
					end
				end

				local prediction = {}
				local chance = 100 / #matches
				for _, petName in ipairs(matches) do
					table.insert(prediction, { name = petName, chance = chance })
				end
				PET_PREDICTION[eggName] = prediction
			end
		end
		buildPetPrediction()

		-- ===== PET RARITY DATA (loaded from the game's Pets module) =====
		-- Accurate rarity comes from ReplicatedStorage.Modules.ItemDisplayDataCategories.Pets.
		-- This keeps the predictor in sync with the real game data instead of hardcoded values.
		local PET_RARITIES = {}
		local function loadPetRarity()
			local cats = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("ItemDisplayDataCategories")
			local petsRef = cats and cats:FindFirstChild("Pets")
			if not petsRef then return end
			local ok, petsModule = pcall(require, petsRef)
			if not ok or type(petsModule) ~= "table" then return end
			for _, petData in pairs(petsModule) do
				if type(petData) == "table" and petData.ItemType == "Pet" then
					local displayName = petData.DisplayName
					local rarity = petData.Rarity
					if type(displayName) == "string" and type(rarity) == "string" then
						PET_RARITIES[displayName] = rarity
					end
				end
			end
		end
		loadPetRarity()

		-- Return the most likely pet for a given egg name (case-insensitive).
		local function predictPetFromEgg(eggName)
			if not eggName or eggName == "" then return "No Egg" end
			local lower = normalizeName(eggName)
			for egg, pets in pairs(PET_PREDICTION) do
				if normalizeName(egg) == lower then
					local best = pets[1]
					for _, p in ipairs(pets) do
						if p.chance > best.chance then best = p end
					end
					return best.name
				end
			end
			return "Unknown"
		end

		-- ===== PET PREDICTION LOOKUP =====
		-- Return the best-pet prediction data (name + chance) for an egg.
		local function getPredPetData(eggName)
			local lower = normalizeName(eggName)
			if lower == "" then return nil end
			for egg, pets in pairs(PET_PREDICTION) do
				if normalizeName(egg) == lower then
					local best = pets[1]
					for _, p in ipairs(pets) do
						if p.chance > best.chance then best = p end
					end
					return best
				end
			end
			for egg, pets in pairs(PET_PREDICTION) do
				local eggNorm = normalizeName(egg)
				if string.find(lower, eggNorm) or string.find(eggNorm, lower) then
					local best = pets[1]
					for _, p in ipairs(pets) do
						if p.chance > best.chance then best = p end
					end
					return best
				end
			end
			return nil
		end

		-- Predict the hatched pet from an egg name (returns the best pet name).
		local function predictHatchedPet(eggName)
			local best = getPredPetData(eggName)
			return best and best.name or "Unknown"
		end

