-- ===== AUTO CLEAR HOTBAR SLOT =====
-- Sequential clearing: slot 1 → slot 2 → ... → slot 8 → slot 1 → ...
-- Only clears slots that have text in NameLabel (have items assigned).
-- Skips empty slots. When all 8 slots are empty, turns off Auto Assign Hotbar Slot.
local nextSlotToClear = 1

updateClearHotbarLog = function()
	if not clearHotbarLogFrame then return end
	for _, child in ipairs(clearHotbarLogFrame:GetChildren()) do
		if child:IsA("TextLabel") and child ~= clearHotbarLogLabel then
			child:Destroy()
		end
	end
	local entries = clearHotbarLogHistory
	if #entries == 0 then
		entries = {"No cleared ItemName yet."}
	end
	for index, entryText in ipairs(entries) do
		local entry = Instance.new("TextLabel")
		entry.Name = "LogEntry" .. tostring(index)
		entry.BackgroundTransparency = 1
		entry.TextColor3 = Colors.TEXT
		entry.Font = Enum.Font.Gotham
		entry.TextSize = 11
		entry.TextWrapped = false
		entry.TextXAlignment = Enum.TextXAlignment.Left
		entry.TextYAlignment = Enum.TextYAlignment.Top
		entry.Size = UDim2.new(1, -16, 0, 18)
		entry.LayoutOrder = index + 1
		entry.Text = entryText
		entry.Parent = clearHotbarLogFrame
	end
	clearHotbarLogFrame.CanvasPosition = Vector2.new(0, math.max(0, clearHotbarLogFrame.AbsoluteCanvasSize.Y))
end

local function appendClearHotbarLog(slotNumber, itemName)
	local timestamp = os.date("%H:%M:%S")
	local shownName = itemName and itemName ~= "" and itemName or "Empty"
	table.insert(clearHotbarLogHistory, string.format("%s - Slot %d| %s", timestamp, slotNumber, shownName))
	if #clearHotbarLogHistory > 200 then
		table.remove(clearHotbarLogHistory, 1)
	end
	updateClearHotbarLog()
end

local function getSlotItemName(slotNumber)
	local hotbarGui = PlayerGui:FindFirstChild("HotbarGui")
	local mainFrame = hotbarGui and hotbarGui:FindFirstChild("MainFrame")
	local slot = mainFrame and mainFrame:FindFirstChild("Slot" .. tostring(slotNumber))
	if not slot then return "" end
	local itemName = slot:GetAttribute("ItemName")
	if type(itemName) == "string" and itemName ~= "" then return itemName end
	local nameLabel = slot:FindFirstChild("NameLabel")
	return nameLabel and nameLabel:IsA("TextLabel") and (nameLabel.Text or "") or ""
end

updateClearHotbarLog()

local function isSlotNameLabelEmpty(slotNumber)
	local hotbarGui = PlayerGui:FindFirstChild("HotbarGui")
	if not hotbarGui then return true end
	local mainFrame = hotbarGui:FindFirstChild("MainFrame")
	if not mainFrame then return true end
	local slot = mainFrame:FindFirstChild("Slot" .. tostring(slotNumber))
	if not slot then return true end
	local nameLabel = slot:FindFirstChild("NameLabel")
	if not nameLabel or not nameLabel:IsA("TextLabel") then return true end
	return (nameLabel.Text or "") == ""
end

task.spawn(function()
	while true do
		task.wait(0.5)
		if AutoFarm.autoClearHotbarSlot then
			-- Find the next enabled slot that HAS text in NameLabel (skip empty slots)
			local foundSlot = nil
			for i = 0, 7 do
				local slot = ((nextSlotToClear - 1 + i) % 8) + 1
				if AutoFarm.autoClearSlots[slot] and not isSlotNameLabelEmpty(slot) then
					foundSlot = slot
					break
				end
			end
			if foundSlot then
				local clearedItemName = getSlotItemName(foundSlot)
				local remote = ClearHotbarSlot
				if not remote then
					local mi = Remotes and Remotes:FindFirstChild("MainInventory")
					if mi then
						remote = mi:FindFirstChild("ClearHotbarSlot")
						ClearHotbarSlot = remote
					end
				end
				if remote then
					local fired = pcall(function()
						remote:FireServer(foundSlot)
					end)
					if fired then
						clearHotbarLogEntries[foundSlot] = clearedItemName
						appendClearHotbarLog(foundSlot, clearedItemName)
					end
				end
				-- Advance to the next slot for the next iteration
				nextSlotToClear = (foundSlot % 8) + 1
			else
				-- No enabled slot has text - check if ALL 8 slots are empty
				local allEmpty = true
				for i = 1, 8 do
					if not isSlotNameLabelEmpty(i) then
						allEmpty = false
						break
					end
				end
				-- If all slots are empty, turn off Auto Assign Hotbar Slot
				if allEmpty and AutoFarm.autoAssignHotbarSlot then
					AutoFarm.autoAssignHotbarSlot = false
					if setToggleState then
						setToggleState("AutoAssignHotbarSlot", false)
					end
				end
			end
		end
	end
end)

