-- Check if all quests are completed (for refresh trigger)
local function areAllQuestsCompleted(state)
	if not state or type(state.Quests) ~= "table" or #state.Quests == 0 then
		return false
	end

	for _, quest in ipairs(state.Quests) do
		if quest.Completed ~= true or quest.Claimed ~= true then
			return false
		end
	end
	return true
end

-- Auto claim quest rewards
local function autoClaimQuests()
	if isClaimingQuest or isRefreshingQuests then return end

	local state = getQuestState()
	if not state or state.Success ~= true then return end
	if type(state.Quests) ~= "table" then return end

	updateQuestLog(state)

	local claimedAny = false
	for _, quest in ipairs(state.Quests) do
		if quest.Completed == true and quest.Claimed ~= true then
			local questId = tostring(quest.QuestId or "")
			if questId ~= "" then
				isClaimingQuest = true

				local success, result = pcall(function()
					return ClaimQuestReward:InvokeServer(questId)
				end)

				if success and type(result) == "table" then
					if result.Success == true then
						print("[AutoFarm] Claimed quest: " .. tostring(quest.DisplayName or questId))
						if type(result.State) == "table" then
							lastQuestState = result.State
							updateQuestLog(result.State)
						end
						claimedAny = true
					else
						warn("[AutoFarm] Claim failed: " .. tostring(result.Message or "unknown"))
					end
				else
					warn("[AutoFarm] Claim error: " .. tostring(result))
				end

				isClaimingQuest = false
			end
		end
	end

	isClaimingQuest = false

	-- Re-fetch state after claiming to refresh the log
	if claimedAny then
		local freshState = getQuestState()
		if freshState then
			lastQuestState = freshState
			updateQuestLog(freshState)
		end
	end
end

-- Auto refresh quest board when all quests completed and claimed
local function autoRefreshQuests()
	if isRefreshingQuests or isClaimingQuest then return end

	local state = lastQuestState or getQuestState()
	if not state or state.Success ~= true then return end

	-- Check if all quests are completed and claimed
	if not areAllQuestsCompleted(state) then return end

	-- Check if refresh is available
	local refresh = state.Refresh
	if not refresh or refresh.CanRefresh ~= true then return end

	isRefreshingQuests = true

	local success, result = pcall(function()
		return RefreshQuestBoard:InvokeServer()
	end)

	if success and type(result) == "table" then
		if result.Success == true then
			print("[AutoFarm] Quest board refreshed!")
			if type(result.State) == "table" then
				lastQuestState = result.State
				updateQuestLog(result.State)
			end
		else
			warn("[AutoFarm] Refresh failed: " .. tostring(result.Message or "unknown"))
		end
	else
		warn("[AutoFarm] Refresh error: " .. tostring(result))
	end

	-- Re-fetch state after refresh to make sure log is current
	local freshState = getQuestState()
	if freshState then
		lastQuestState = freshState
		updateQuestLog(freshState)
	end

	isRefreshingQuests = false
end

