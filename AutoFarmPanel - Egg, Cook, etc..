-- Snapshot quest card text from the QuestBoardGui when it's opened by the player
-- When the GUI is open, this takes priority over remote polling for the quest log
local function snapshotQuestBoardGui()
	local questBoardGui = PlayerGui:FindFirstChild("QuestBoardGui")
	if not questBoardGui or not questBoardGui.Enabled then return nil end

	local shade = questBoardGui:FindFirstChild("Shade")
	if not shade then return nil end
	local panel = shade:FindFirstChild("Panel")
	if not panel then return nil end
	local questList = panel:FindFirstChild("QuestList")
	if not questList then return nil end

	local cards = {}
	local seenCardKeys = {}
	for _, child in ipairs(questList:GetChildren()) do
		if #cards >= 6 then
			break
		end
		if child:IsA("GuiObject") then
			-- Find QuestCardContent (could be the child itself or a descendant)
			local content = nil
			if child.Name == "QuestCardContent" then
				content = child
			else
				content = child:FindFirstChild("QuestCardContent")
				if not content then
					for _, desc in ipairs(child:GetDescendants()) do
						if desc.Name == "QuestCardContent" then
							content = desc
							break
						end
					end
				end
			end

			if content then
				-- Find QuestTextColumn
				local textColumn = content:FindFirstChild("QuestTextColumn")
				if not textColumn then
					for _, desc in ipairs(content:GetDescendants()) do
						if desc.Name == "QuestTextColumn" then
							textColumn = desc
							break
						end
					end
				end

				local function findLabelText(parent, name)
					local label = parent:FindFirstChild(name)
					if label and label:IsA("TextLabel") then
						return label.Text or ""
					end
					-- Search descendants as fallback
					for _, desc in ipairs(parent:GetDescendants()) do
						if desc.Name == name and desc:IsA("TextLabel") then
							return desc.Text or ""
						end
					end
					return ""
				end

				local title = ""
				local description = ""
				local progress = ""
				local reward = ""

				if textColumn then
					title = findLabelText(textColumn, "QuestTitle")
					description = findLabelText(textColumn, "QuestDescription")
					progress = findLabelText(textColumn, "ProgressLabel")
					reward = findLabelText(textColumn, "RewardLabel")
				end

				-- Also try reading from content directly if textColumn didn't have them
				if title == "" then title = findLabelText(content, "QuestTitle") end
				if description == "" then description = findLabelText(content, "QuestDescription") end
				if progress == "" then progress = findLabelText(content, "ProgressLabel") end
				if reward == "" then reward = findLabelText(content, "RewardLabel") end

				-- Find status indicator: InProgressLabel, ClaimedLabel, or ClaimButton
				local statusText = ""
				local statusElement = content:FindFirstChild("InProgressLabel")
				if not statusElement then
					statusElement = content:FindFirstChild("ClaimedLabel")
				end
				if not statusElement then
					-- ClaimButton is a TextButton (not TextLabel), check for it
					for _, desc in ipairs(content:GetDescendants()) do
						if desc.Name == "ClaimButton" and desc:IsA("TextButton") then
							statusElement = desc
							break
						end
					end
				end
				if statusElement and statusElement.Text then
					statusText = statusElement.Text
				end

				-- Determine status from the element name and text
				local displayStatus = "In Progress"
				local statusColor = Color3.fromRGB(255, 200, 80)
				if statusElement then
					if statusElement.Name == "ClaimedLabel" then
						displayStatus = "Claimed"
						statusColor = Color3.fromRGB(150, 150, 160)
					elseif statusElement.Name == "ClaimButton" then
						displayStatus = "Claim"
						statusColor = Color3.fromRGB(100, 255, 100)
					elseif statusElement.Name == "InProgressLabel" then
						displayStatus = statusText ~= "" and statusText or "In Progress"
						statusColor = Color3.fromRGB(255, 200, 80)
					elseif statusText ~= "" then
						-- Fallback: parse text
						local statusLower = string.lower(statusText)
						if string.find(statusLower, "claim") and string.find(statusLower, "ed") then
							displayStatus = "Claimed"
							statusColor = Color3.fromRGB(150, 150, 160)
						elseif string.find(statusLower, "claim") then
							displayStatus = "Claim"
							statusColor = Color3.fromRGB(100, 255, 100)
						else
							displayStatus = statusText
						end
					end
				end

				local cardKey = title ~= "" and title or (description ~= "" and description or tostring(child:GetFullName()))
				if not seenCardKeys[cardKey] and #cards < 6 then
					seenCardKeys[cardKey] = true
					table.insert(cards, {
						title = title,
						description = description,
						progress = progress,
						reward = reward,
						status = displayStatus,
						statusColor = statusColor,
					})
				end
			end
		end
	end

	return #cards > 0 and cards or nil
end

-- Clean up duplicate reward text like "x10000 x10,000 Shimmers" -> "x10,000 Shimmers"
local function cleanRewardText(text)
	if type(text) ~= "string" or text == "" then return text or "" end
	return text:gsub("x%d+%s+(x[%d,]+)", "%1")
end

-- Render GUI snapshot data to the quest log frame
local function renderGuiSnapshotToLog(snapshot)
	if not snapshot then
		return false
	end

	local inProgress = 0
	for _, card in ipairs(snapshot) do
		local status = string.lower(card.status or "")
		if string.find(status, "claim") then
			inProgress = inProgress + 1
		end
	end

	-- Build report rows (updates in place, never wipes the log)
	local rows = {}
	table.insert(rows, {
		key = "summary",
		title = string.format("ALL QUESTS %d | IN PROGRESS %d/%d", #snapshot, inProgress, #snapshot),
	})

	for i, card in ipairs(snapshot) do
		local progressText = tostring(card.progress or "")
		local progressValue = 0
		local goal = 0
		if progressText ~= "" then
			local a, b = progressText:match("(%d+)[^%d]*(%d+)")
			if a and b then
				progressValue = tonumber(a) or 0
				goal = tonumber(b) or 0
			end
		end
		table.insert(rows, {
			key = tostring(card.title ~= "" and card.title or "Quest"),
			title = tostring(card.title ~= "" and card.title or "Quest"),
			status = tostring(card.status or "In Progress"),
			statusColor = card.statusColor or Colors.TEXT,
			description = tostring(card.description or ""),
			reward = cleanRewardText(tostring(card.reward or "")),
			progress = progressText,
			progressValue = progressValue,
			goal = goal,
		})
	end

	renderQuestLog(rows)
	return true
end

